							<Properties>
								<ProtectedString name="Source"><![CDATA[StarterSounds = {}

function createSounds(vehicle, module)
	table.clear(StarterSounds)
	for i, v in next, module.StarterSounds do
		local newsound = Instance.new("Sound")
		newsound.Name = v.name
		newsound.SoundId = "rbxassetid://"..v.id
		newsound.Playing = false
		newsound.Volume = v.volume
		newsound.RollOffMinDistance = v.rollOffMin
		newsound.RollOffMaxDistance = v.rollOffMax
		newsound.Parent = v.parent
		table.insert(StarterSounds, i, newsound)
	end
end

function stopSounds()
	for i, v in next, StarterSounds do
		if v.Name == "Starter" then
			v:Stop()
		end
	end
end

function removeSounds()
	for i, v in next, StarterSounds do
		v:Destroy()
	end
end

script.Parent.OnServerEvent:Connect(function(plr, command, vehicle, module)
	if command == "create" then
		createSounds(vehicle, module)
	elseif command == "remove" then
		removeSounds()
	elseif command == "grind" then
		for i, v in next, StarterSounds do if v.Name == "Grind" then
				v:Play()
			end
		end
	elseif command == "starter" then
		for i, v in next, StarterSounds do if v.Name == "Starter" then
				v:Play()
			end
		end
	elseif command == "disengage" then
		for i, v in next, StarterSounds do if v.Name == "Disengage" then
				v:Play()
			end
		end
	elseif command == "stop" then
		stopSounds()
	end
end)]]></ProtectedString>
