						<Item class="Script" referent="RBX4DFA1F7F82244DAE9518DE020B2300BF">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local Vehicle = script.Parent.Parent
local RunService = game:GetService("RunService")
local Units = require(Vehicle.Settings.Units)
local toKMH = (Units.Length_mm / 1000) * 3.6
local weight = Vehicle.Body["#Weight"]

windsound = script.Sounds.WindSound:Clone()
windsound.Parent = weight
windsound:Play()

bodysound = script.Sounds.BodySound:Clone()
bodysound.Parent = weight
bodysound:Play()

script.Parent.OnServerEvent:connect(function(AeroSounds, Wind, Body)
	RunService.Heartbeat:Connect(function(dt)
		local diff = (Vehicle.DriveSeat.Velocity - workspace.GlobalWind).Magnitude * toKMH
		windsound.Volume = diff ^ 2 * Wind / (200) ^ 2
		bodysound.Volume = diff ^ 2 * Body / (200) ^ 2
	end)
end)]]></ProtectedString>
