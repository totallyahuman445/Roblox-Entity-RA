			elseif SuspensionDirectionOverride and SuspensionOverrideDirection == "Left" then
				if v.Name == "L_"..SuspensionType then
					v.Name = "SuspensionGeometry"
				else
					v:destroy()
				end
			end
		end
	end
end

if SuspensionType == "None" then
