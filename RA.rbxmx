				<ProtectedString name="Source"><![CDATA[--[[ Welcome, tuner.
    ____  ___
   / __ \/   | Entity
  / /_/ / /| | Roblox self propelled land vehicle chassis
 / __ _/ ___ | 0.51.4
/_/ |_/_/  |_| GitHub:    https://github.com/totallyahuman445/Roblox-Entity-RA
               Discord:   https://discord.gg/bS2A448Vrk
               Community: https://www.roblox.com/share/g/206794047
			   THE List:  https://docs.google.com/document/d/1WvOWw7ST4ZWpsCfXM3abJTTBkCA40NsayIEIdCRJOYM/edit?usp=sharing
			   Log:		  https://docs.google.com/document/d/1SLW5NOAysg2rE6C52WEPnmOas_MNbeVNEv0xv2f__ps/edit?usp=sharing
			   Credits:   https://docs.google.com/document/d/1-mIgEhmugHfVUDz4vzZMS7XYMoEdLKedy0MedRqvbyA/edit?usp=sharing
]]
local vehicle = script.Parent
local Settings = {} do
--Misc
Settings.WheelSettingsMasterConfig	  = "Simple"			                              -- "Simple", All", "Type", "Names" and "Individual". "Simple" is the default, All" uses one for all wheels, "Type" uses 3 maximum for all wheel types, "Name" uses 9 maximum for every wheel name the chassis knows and Individual relies on you putting the script manually in each wheel and enabling it.

Settings.LoadDelay		              = 3			                                      -- Delay before initializing chassis (in seconds)
Settings.AutoStart		              = false		                                      -- Turn this on to make the chassis start up itself.
Settings.AutoFlip		              = true		                                      -- Turn this off for race ending rollovers.
Settings.ExitStop                     = false         	                                  -- Turn this on to make the chassis instantly stop when you exit while driving
Settings.PlayerMassless               = false                                             -- Makes the player massless when driving.
Settings.PreToggledPBrake             = false			                                  -- Turn this on to automatically enable the handbrake when the chassis loads.
Settings.Temperature   	              = workspace:GetAttribute("GlobalTemperature") or 28 -- In celcius

Settings.TyreHeating	              = true	                                          -- Dynamic, non damaging tyre heating. False sets the friction to maximum.
Settings.Haptics		              = true                                              -- Tyre slippage will activate the small motor on mobile devices and controllers.
Settings.DirtBumps		              = 20	                                              -- Aggresiveness of artificial bumps in dirt-, sand-, and snow-type surfaces (0 for none)	
Settings.SandForce		              = 10                                                -- Force in kgf of sand for every 50 km/h. This force is applied exponentially (0 for none)
Settings.MudForce		              = 5		                                          -- Force in kgf of mud for every 50 km/h. This force is applied exponentially (0 for none)
Settings.SnowForce		              = 7.5                                               -- Force in kgf of snow for every 50 km/h. This force is applied exponentially (0 for none)
Settings.Effects		              = true	                                          -- Turns smoke effects on or off.
	Settings.SmokeStressOffset        = 5		                                          -- Offsets the stress required to activate smoke-related effects (in percent, higher means less smoke).

Settings.DriverLeanAngle              = 13                                                -- DriveSeat driver lean angle.

Settings.RunningOver                  = false                                             -- Turn this on to make the chassis damage players or npcs that you run over. (Heavier vehicle = more damage, more wheels = less damage)
Settings.BailDamage                   = false                                             -- Jumping out a moving vehicle will hurt you based on speed, Like Grand Theft Auto.
Settings.Ejection                     = false                                             -- Allows you to fall off from wheelie-ing too hard or flipping, great for motorcycles and ATVs.

--[[Weight and CG]]
Settings.Weight			              = 1360		                                      -- Total weight (in kilograms, under earth's gravity, including wheel and suspension weight)
	Settings.WeightBSize	          = {			                                      -- Size of weight brick, dimensions of your vehicle in millimeters
		--[[Width]]		                1802   ,
		--[[Height]]	                1408   ,
		--[[Length]]	                4551   }
	Settings.WeightDist		          = 52		                                          -- Weight distribution (0 - on rear wheels, 100 - on front wheels, can be <0 or >100)
	Settings.CGHeight		          = .1		                                          -- Center of gravity height (studs relative to median of all wheels)
	Settings.Stiffness                = 1                                                 -- For reference of other features like revshake (default is 1).
	Settings.WBVisible		          = false		                                      -- Makes the weight brick visible

--[[Aerodynamics]]
Settings.Downforce_F_Enabled          = false                                             -- Sheds the front downforce part and turns off front downforce code. This optimizes front downforce-less vehicles.
Settings.Downforce_R_Enabled          = false                                             -- Sheds the rear downforce part and turns off rear downforce code. This optimizes rear downforce-less vehicles.
Settings.Diffuser_Enabled             = false                                             -- Sheds the Diffuser part and turns off diffuser code. This optimizes diffuserless vehicles.	

Settings.BD_Enabled                   = false                                             -- Controls blown diffuser code. This optimizes blown diffuserless vehicles and needs Diffuser_Enabled to be on.
	Settings.BlownDirect              = true                                              -- If the blown diffuser is direct or not. A direct blown diffuser results in downforce regardless of speed when the throttle is pressed.
Settings.Airbrake_Enabled             = false                                             -- Enables Airbrake.
Settings.Active_Aero_Enabled          = false                                             -- Basic active aero.
	Settings.Top_Speed_Mode_Enabled   = false                                             -- Top speed mode that's in between your normal aero and active aero.
Settings.DRS_Enabled                  = false                                             -- Enables DRS.
	Settings.DRS_Cancel_AirBrake      = false                                             -- No air brake when DRS is on.

Settings.Drag				          = .272	                                          -- Drag coefficient of the vehicle.
Settings.Drag_AB                      = .136                                              -- Extra drag Coefficient when the airbrake is on
Settings.Drag_AA                      = .084                                              -- Extra drag coefficient when the active aero is on.
	Settings.Drag_TP                  = .022                                              -- Extra drag coefficient when the top speed mode is on for the active aero.
Settings.Drag_DRS                     = Settings.Drag                                     -- Drag Coefficient when DRS is on.

Settings.DownforceF		              = 80		                                          -- Front downforce in kgf at 200 km/h.

Settings.DownforceR		              = 35		                                          -- Rear downforce in kgf at 200 km/h.
Settings.DownforceR_AB		          = 56		                                          -- Extra rear downforce in kgf at 200 km/h when the air brake is engaged.
Settings.DownforceR_AA	              = 89		                                          -- Extra Rear downforce in kgf at 200 km/h when active aero is engaged.
	Settings.DownforceR_TP		      = 41                                                -- Extra Rear downforce in kgf at 200 km/h when the top speed mode is engaged.
Settings.DownforceR_DRS		          = Settings.DownforceR                               -- Rear downforce in kgf at 200 km/h when DRS is engaged.

Settings.DownforceD		              = 105		                                          -- Diffuser downforce in kgf at 200 km/h.

Settings.BlownDiffuser                = 60     	                                          -- Blown diffuser downforce at 200 km/h.

Settings.Speed_AB                     = 0                                                 -- Minimum airbrake speed in km/h.
Settings.Speed_AA                     = 180                                               -- The speed that the active aero engages / disengages in km/h.
	Settings.Speed_TP                 = 280                                               -- The speed that the active aero top speed mode engages / disengages in km/h.

Settings.Delay_AB                     = .11                                               -- The delay before the air brake engages / disengages in seconds.
Settings.Delay_AA                     = .25                                               -- The delay before the active aero engages / disengages in seconds.
	Settings.Delay_TP                 = .25                                               -- The delay before the top speed mode engages / disengages in seconds.
Settings.Delay_DRS                    = .25                                               -- The delay before DRS engages / disengages in seconds.

--[[Steering]]
Settings.SteerSpeed			          = .01		                                          -- Steering increment per tick (in degrees)
Settings.ReturnSpeed		          = .025		                                      -- Steering increment per tick (in degrees)
Settings.ContlrSteerSpeed	          = 0			                                      -- Controller version of steer speed (0 or less to be the same as SteerSpeed)
Settings.ContlrReturnSpeed	          = 0			                                      -- Controller version of return speed (0 or less to be the same as ReturnSpeed)
Settings.MSteerUsesContlr	          = false		                                      -- Set to false if you want mouse steer to use the keyboard steer speeds instead of controller speeds.
Settings.SteerDecay			          = 300		                                          -- Speed of gradient cutoff for front steering (in km/h)
Settings.RSteerDecay		          = 330		                                          -- Speed of gradient cutoff for rear steering (in km/h)
Settings.SteerSpeedDecay	          = 300		                                          -- Speed of gradient cutoff of steering speed (in km/h)
Settings.MinSteerSpeed		          = 50		                                          -- Minimum steering speed at max decay (in percent)
Settings.MinSteer			          = 25		                                          -- Minimum steering at max steer decay (in percent)
Settings.MSteerExp			          = 1			                                      -- Mouse steering exponential degree
Settings.SteerSmoothing		          = 2			                                      -- The lower, the smoother the steering will arrive at max angle.

--[[Leaning]]
Settings.Wheelie                      = false                                             -- Let the driver attempt to wheelie.

Settings.Lean                         = false                                             -- Motorcycle leaning and balancing.
Settings.LeanSpeed				      = 1                                                 -- How quickly the the bike will lean, .01 being slow, 1 being almost instantly.
Settings.LeanProgressiveness	      = 25 	                                              -- How much steering is kept at higher speeds, a lower number is less steering, a higher number is more steering.
Settings.MaxLean				      = 58 	                                              -- Maximum lean angle in degrees.

Settings.LeanD			              = 90 		                                          -- Dampening of the lean.
Settings.LeanMaxTorque	              = 500 		                                      -- Force of the lean.
Settings.LeanP			              = 300 		                                      -- Aggressiveness of the lean.

--[[Engine]]
-- *It is recommended that you use the Desmos graph to tune your chassis properly.*
-- https://www.desmos.com/calculator/hibvkokwju
Settings.HorsepowerLimit	          = 0			                                      -- Global horsepower limit (set to 0 for no limit).
	-- Naturally Aspirated Engine
	Settings.Engine 		          = true
		Settings.Cylinders            = 4                                                 -- For reference of other features like revshake.
		Settings.Torque				  = 338                                               -- Base torque in nm, Also determines base horsepower.
		Settings.Redline			  = 7800			                                  -- Engine's max RPM
		Settings.IdleRPM			  = 800			                                      -- Engine's idle RPM
		Settings.EqPoint			  = 5252			                                  -- Standardized, do not touch
		Settings.StartRPM			  = Settings.IdleRPM	                              -- The RPM the engine starts at
		Settings.StartRPMAccel		  = 30			                                      -- RPM increase to get to starting RPM per tick

		Settings.ShiftRPM			  = 7200   	  	                                      -- RPM that the transmission shifts at
		Settings.PeakRPM			  = Settings.ShiftRPM	                              -- PeakRPM is no longer functional in engine calculations.

		Settings.ValveSprings		  = 9.5			                                      -- Higher values yield less valve float
		Settings.ValveFloatSharpness  = 3.7

		Settings.VVLSharpness		  = .98			                                      -- Variable Valve Lift Sharpness.
		Settings.VVLTime			  = 5.4			                                      -- Rpm that the VVL activates at.
		Settings.VVLValue			  = 0			                                      -- Multiplier for VVL, set to 0 to deactivate (Recommended values between 0 - .3).

		Settings.HighPerf			  = -.8			                                      -- Higher values yield more high RPM performance.
		Settings.LowPerf			  = .5			                                      -- Higher values yield more low RPM performance.
		Settings.LowPerfSpread		  = .6			                                      -- The spread of the low RPM performance.

		Settings.ExhaustPressure	  = 1.1			                                      -- Engine exhaust pressure (for turbochargers)

	-- Electric Engine
	Settings.Electric		          = false
		Settings.E_Torque		      = 650 	                                          -- Base torque in nm
		Settings.E_Redline		      = 20000			                                  -- Electric max RPM
		Settings.E_DropSlope		  = .114			                                  -- Electric torque decay slope
		Settings.E_TorqueDropRPM	  = 5000			                                  -- When the torque starts decaying
		Settings.E_TorqueDropCurve	  = 6.55
		Settings.E_TorqueDropSpread	  = .767

	-- Turbocharger
	Settings.Turbochargers	          = 1		                                          -- Number of turbochargers in the engine, set to 0 for no turbochargers
		Settings.T_Boost			  = .73                                               -- Boost in bar
		Settings.T_ExPressFactor	  = 10.8				                              -- Smoothness of the boost increase of the turbo
		Settings.T_ExPressInf		  = 2.7				                                  -- How much the turbo is influenced by the exhaust pressure
		Settings.T_SpoolTimeOffset	  = .01				                                  -- Offset in rpm for when the turbo spools
		Settings.T_Efficiency		  = .06				                                  -- Efficiency of the turbocharger
		Settings.T_WGMaxPress		  = 2.9				                                  -- Maximum pressure allowed by the wastegate
		Settings.T_SpoolFactor	      = 1.94
		Settings.T_MinBoost		      = .05					                              -- Minimum boost from the turbocharger
		Settings.T_SpoolIncrease	  = .7				                                  -- How quickly the turbo spools
		Settings.T_SpoolDecrease	  = .95				                                  -- How quickly the turbo stops spooling

	-- Supercharger
	Settings.Superchargers	          = 0		                                          -- Number of superchargers in the engine, Set to 0 for no superchargers
		Settings.S_Boost			  = .56                                               -- Boost in bar
		Settings.S_HighPerf			  = 1.23
		Settings.S_StartBoost		  = .05
		Settings.S_Efficiency		  = .08
		Settings.S_Sensitivity		  = .08

--Misc
Settings.ThrotAccel		              = .05		                                          -- Throttle acceleration, applied per tick (recommended values between .05 to .1)
Settings.ThrotDecel		              = .2		                                          -- Throttle deceleration, applied per tick (recommended values between .1 to .3)

Settings.BrakeAccel		              = .05		                                          -- Brake acceleration, applied per tick
Settings.BrakeDecel		              = .2		                                          -- Brake deceleration, applied per tick

Settings.RevBounce		              = 200		                                          -- RPM kickback from redline
Settings.OverRev		              = false		                                      -- Set to true to allow the RPM to go above redline

Settings.RevAccel		              = 200		                                          -- RPM acceleration when clutch is on (this should be higher than RevDecay and RevDecayRPM)
Settings.RevDecay		              = 40		                                          -- RPM decay when clutch is on
Settings.RevDecayRPM	              = 80		                                          -- RPM decay from engine speed

Settings.Flywheel		              = 500		                                          -- Flywheel weight (higher = faster response, lower = more stable RPM)
Settings.FlywheelEnergy	              = 1000		                                      -- How much torque per 1000 RPM the flywheel can produce when the clutch is dumped.
	Settings.DumpMult		          = 1		                                          -- Flywheel energy multiplier when dumping the clutch (keep at 1 for the best result).

Settings.Roughness		              = 5		                                          -- Engine roughness (higher = more powerband jitter) (F2, V2, Split1, I2, F4, H4, V4, U4, I4, W6, I6, F8, V8, I8, F12, V12, U12, I12, I14, H16, V16, U16, W16, W18, H24, W24, all rotary engines and all wankel engines are smooth and I1, I3, V3, I5, V5, VR5, F6, V6, VR6, I7, W8, I9, WR10, WR12, V14, V20, W30 all X engines and all Radial Engines are not smooth.)

Settings.RevShake                     = true                                              -- Enable for revshaking, more cylinders and roughness increases revshaking, more stiffness reduces revshaking.
	Settings.RevShakeLocation         = vehicle.Body.System.Sounds.Engine                 -- Where your revshake force is located.

Settings.IdleThrottle	              = 8.5		                                          -- Percent throttle with no input. (in percent)

Settings.Creep	                      = true	                                       	  -- Adds idle creeping based on IdleThrottle.

Settings.FReverse                     = false                                             -- Enables reversing by foot like in motorcycles.

--[[Drivetrain]]
Settings.Config			              = "RWD"		                                      -- "FWD", "MWD", "RWD" and "AWD"
	Settings.TorqueVector	          = .3		                                          -- AWD ONLY, "-1" has a 100% front bias, "0" has a 50:50 bias, and "1" has a 100% rear bias. Can be any number between that range.

--[[Transmission]]
	Settings.Clutch			          = true		                                      -- Implements a realistic clutch, change to "false" for the chassis to act like A-Chassis 6.81T.

Settings.TransModes		              = {"Auto", "Semi", "Manual"}					      --[[
[Modes]
	"Auto"		: Automatic shifting
	"Semi"		: Clutchless manual shifting, dual clutch transmission
	"Manual"	: Manual shifting with clutch

	>Include within brackets
		eg: {"Semi"} or {"Auto", "Manual"}
	>First mode is default mode													          ]]

Settings.ClutchMode		              = "New"											  --[[
[Modes]
	"New"		: Speed controls clutch engagement
	"Old"		: Speed and RPM control clutch engagement	                              ]]

Settings.ClutchType 	              = "Clutch"										  --[[
[Types]
	"Clutch"			: Standard clutch, recommended
	"TorqueConverter"	: Torque converter, keeps RPM up
	"CVT"				: Continously Variable Transmission                               ]]

--[[Transmission]]
-- Transmission settings
Settings.Stall			              = true		                                      -- Stalling, enables the chassis to stall. An ignition plugin would be necessary. Disables if Settings.Clutch is false.
Settings.ClutchRel		              = true		                                      -- If true, the driver must let off the gas before shifting to a higher gear. Recommended false for beginners.
Settings.ClutchEngage	              = 10		                                          -- How fast engagement is (0 = instant, 99 = super slow)
Settings.SpeedEngage 	              = 20		                                          -- Speed the clutch fully engages at (Based on km/h)

-- Clutch: "Old" mode
Settings.ClutchRPMMult	              = 1 		                                          -- Clutch RPM multiplier, recommended to leave at 1

-- Torque converter:
Settings.TQLock 		              = false		                                      -- Torque converter starts locking at a certain RPM
	Settings.RPMEngage 		          = 3500		                                      -- Keeps RPMs to this level until passed

-- CVT:
Settings.CVTRPM			              = 7000		                                      -- RPM that the CVT wants to keep at full throttle.
	Settings.CVTMaxRatio	          = 6			                                      -- The gear ratio that the CVT cannot go over.
	Settings.CVTMinRatio	          = 1			                                      -- The gear ratio that the CVT cannot go under.

-- CVT fake shifting
Settings.CVTFakeShifting              = false                                             -- Enables CVT fake shifting.
	Settings.CVTFakeShiftingStartRPM  = Settings.CVTRPM	                                  -- The RPM that the engine simulates a shift from after the delay.
	Settings.CVTFakeShiftingDropRPM   = 6400                                              -- The RPM that the engine drops to to simulate a shift after hitting the CVTRPM.
	Settings.CVTFakeShiftingDropDelay = 1                                                 -- The time in seconds the engine has to stay in the CVTRPM initiate a fake shift.
	Settings.CVTFakeShiftingShiftTime = .1                                                -- How long the engine stays in the desired RPM to simulate a shift.
	Settings.CVTFakeShiftingUseClutch = false                                             -- Is the clutch engaged when initiating a fake shift.

-- Neutral rev limiter
Settings.NeutralLimit	              = false		                                      -- Enables a different redline RPM for when the chassis is in neutral
	Settings.NeutralRevRPM	          = 5000		                                      -- The rev limiter when the chassis is in neutral
	Settings.LimitClutch	          = false		                                      -- Will also limit RPMs while the clutch is pressed down

-- Automatic settings
Settings.AutoShiftMode	              = "Speed" 									      --[[
[Modes]
	"Speed"		: Shifts based on wheel speed
	"RPM"		: Shifts based on RPM										              ]]
Settings.AutoShiftType	              = "DCT"										      --[[
[Types]
	"Rev"		: Clutch engages fully once RPM reached
	"DCT"		: Clutch engages after a set time has passed	                          ]]
Settings.AutoShiftVers	              = "Old"										      --[[
[Versions]
	"New"		: Shift from Reverse, Neutral, and Drive
	"Old"		: Auto shifts into R or D when stopped.			           	              ]]
Settings.AutoUpThresh	      	      = -200		                                      -- Automatic upshift point (relative to peak RPM, positive = Over-rev)
Settings.AutoDownThresh               = 1400		                                      -- Automatic downshift point (relative to peak RPM, positive = Under-rev)

-- Automatic: revmatching
Settings.ShiftThrot		              = 100		                                          -- Throttle level when shifting down to revmatch, 0 - 100%

-- Automatic: DCT
Settings.ShiftUpTime	              = .2		                                          -- Time required to shift into next gear, from a lower gear to a higher one.
Settings.ShiftDnTime	              = .1		                                          -- Time required to shift into next gear, from a higher gear to a lower one.

-- Gear ratios
Settings.NoReverse                    = false                                              -- Tells the gauges that there is no reverse gear. Make your reverse ratio 0 afterwards.
Settings.FinalDrive		              = 4.764
	Settings.Ratios			          = {
		--[[Reverse]]	                3.5		,
		--[[Neutral]]	                0		,
		--[[ 1 ]]		                3.827	,
		--[[ 2 ]]		                2.4		,
		--[[ 3 ]]		                1.7		,
		--[[ 4 ]]		                1.35	,
		--[[ 5 ]]		                1.05	,
		--[[ 6 ]]		                .82		,
	}
	Settings.FDMult			          = 1			                                      -- Ratio multiplier (keep this at 1 if the chassis is not struggling with torque)

-- Speed limiter
Settings.SpeedLimit 	              = 0		                                          -- Maximum speed limit in km/h (0 or less for no limiter)
Settings.ReverseSpeed	              = 0		                                          -- Maximum reverse speed limit
	Settings.SLimitGradient	          = 2			                                      -- Throttle interpolation
	Settings.SLimitBrake	          = false		                                      -- If true, this will apply the brake if the chassis is moving too quickly.

-- Driver assists
Settings.ABSEnabled		              = true										      -- Implements ABS
	Settings.ABSLocked                = false  										      -- Prevent ABS from being disabled.

Settings.TCSEnabled		              = true									          -- Implements TCS
	Settings.TCSLocked                = false		                                      -- Prevent TCS from being disabled.

Settings.ESCEnabled		              = false		                                      -- Implements ESC. This uses the same keybind as TCS.
	Settings.ESCLocked                = false		                                      -- Prevent ESC from being disabled.

Settings.CSEnabled			          = false		                                      -- Enables or disables automatic countersteering
	Settings.CSLocked			      = false		                                      -- Prevent CS from being disabled.

-- Brakes
Settings.BrakeOn                      = true                                              -- Enables braking.

Settings.BrakeFadeOn                  = true     										  -- Enables brake fade.
	Settings.BrakeHeat 	              = 9.25

Settings.PBrakeOn                     = true                                              -- Enables parking brake / handbrake.

Settings.FBrakeOn                     = false                                             -- Enables foot brake for vehicles where you can put your foot on the ground to stop moving like a motorcycle.

--[[Tyre flex]]
Settings.ShowTF			              = false	                                          -- Debug tyre flex

--[[[Default controls]]
-- Peripheral deadzones
Settings.Peripherals = {
	MSteerWidth		 = 69		                       , -- Mouse steering control width (0 - 100% of screen width).
	MSteerDZone		 = 10		                       , -- Mouse steering deadzone (0 - 100%).

	ControlLDZone	 = 5			                   , -- Controller steering L-deadzone (0 - 100%).
	ControlRDZone	 = 5			                   , -- Controller steering R-deadzone (0 - 100%).
}
-- Control mapping
Settings.Controls = {
	-- Keyboard controls
	-- Mode Toggles
	ToggleTCS		  = Enum.KeyCode.T				   ,
	ToggleABS		  = Enum.KeyCode.Y				   ,
	ToggleESC		  = Enum.KeyCode.I				   , -- Requires double press.
	ToggleCS		  = Enum.KeyCode.U				   ,
	ToggleTransMode	  = Enum.KeyCode.M				   ,
	ToggleDRS	      = Enum.KeyCode.Z                 ,
	ToggleMouseDrive  = Enum.KeyCode.R				   ,
	ToggleCamera      = Enum.KeyCode.V                 ,
	HideUI            = Enum.KeyCode.H	               ,
	HideCursor        = Enum.KeyCode.KeypadFive	       ,

	-- Primary controls
	Throttle		  = Enum.KeyCode.Up				   ,
	Brake			  = Enum.KeyCode.Down		       ,
	SteerLeft		  = Enum.KeyCode.Left			   ,
	SteerRight		  = Enum.KeyCode.Right			   ,

	-- Secondary controls
	Throttle2		  = Enum.KeyCode.W				   ,
	Brake2			  = Enum.KeyCode.S				   ,
	SteerLeft2		  = Enum.KeyCode.A				   ,
	SteerRight2		  = Enum.KeyCode.D				   ,

	-- Manual transmission
	ShiftUp			  = Enum.KeyCode.E				   ,
	ShiftDown		  = Enum.KeyCode.Q				   ,
	Clutch			  = Enum.KeyCode.LeftShift		   ,

	-- Handbrake
	PBrake			  = Enum.KeyCode.P				   ,

	-- Foot brake
	FBrake			  = Enum.KeyCode.O				   ,

	-- Startup
	Startup			  = Enum.KeyCode.F				   ,

	-- Wheelie
	WheelieUp	      = Enum.KeyCode.I				   ,
	WheelieDown	      = Enum.KeyCode.U				   ,

	-- Mouse controls
	MouseThrottle	  = Enum.UserInputType.MouseButton1,
	MouseBrake		  = Enum.UserInputType.MouseButton2,
	MouseClutch		  = Enum.KeyCode.W				   ,
	MouseShiftUp	  = Enum.KeyCode.E				   ,
	MouseShiftDown	  = Enum.KeyCode.Q				   ,
	MousePBrake		  = Enum.KeyCode.LeftShift		   ,
	MouseFBrake		  = Enum.KeyCode.RightShift		   ,

	-- Controller mapping
	ContlrThrottle	  = Enum.KeyCode.ButtonR2		   ,
	ContlrBrake		  = Enum.KeyCode.ButtonL2		   ,
	ContlrSteer		  = Enum.KeyCode.Thumbstick1	   ,
	ContlrClutch	  = Enum.KeyCode.ButtonR1		   ,
	ContlrPBrake	  = Enum.KeyCode.ButtonL1	   	   ,
	ContlrFBrake	  = Enum.KeyCode.ButtonL1	   	   ,
	ContlrStartup	  = Enum.KeyCode.ButtonB	   	   ,
	ContlrToggleTMode = Enum.KeyCode.DPadUp			   ,
	ContlrToggleTCS	  = Enum.KeyCode.DPadDown		   ,
	ContlrToggleABS	  = Enum.KeyCode.DPadRight		   ,
	ContlrToggleESC	  = Enum.KeyCode.DPadDown		   , -- Requires double press.
	ContlrToggleCS	  = Enum.KeyCode.DPadLeft		   ,
	ContlrToggleDRS   = Enum.KeyCode.ButtonR3
	}
end
return Settings]]></ProtectedString>
