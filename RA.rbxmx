					<Item class="LocalScript" referent="RBX68B6A84285C3472A95F5A247F17D80BC">
						<Properties>
							<ProtectedString name="Source"><![CDATA[-- Edit values in "Edit" module placed in "Ignition" localscript child.
-- Don't change anything below this unless you know what you're doing

local module = require(script.Edit)
local vehicle = script.Parent.Parent.Vehicle.Value
local _Settings = require(vehicle.Settings)
local RPM = script.Parent.Parent.Values.RPM
local isOn = script.Parent.Parent.Values.IsOn
local mobile = false

local disengaged = true

if _Settings.AutoStart then
	disengaged = false
end

local Event = vehicle:WaitForChild("StartupHandler")

local StarterSounds = {}
local randomizer = 1

local UserInputService = game:GetService("UserInputService")
local gamepadPresent = UserInputService.GamepadEnabled

function createSounds()
	table.clear(StarterSounds)
	for i, v in next, module.StarterSounds do
		local newsound = Instance.new("Sound")
		newsound.Name = v.name
		newsound.SoundId = "rbxassetid://"..v.id
		if v.name == "Starter" then
			newsound.Looped = true
		else
			newsound.Looped = false
		end
		newsound.Playing = false
		newsound.Volume = v.volume
		newsound.RollOffMinDistance = v.rollOffMin
		newsound.RollOffMaxDistance = v.rollOffMax
		newsound.Parent = vehicle.Body[v.parent]
		table.insert(StarterSounds, i, newsound)
	end
end
function stopSounds()
	for i, v in next, StarterSounds do if v.Name == "Starter" then
			v:Stop()
		end
	end
end
function removeSounds()
	for i, v in next, StarterSounds do v:Destroy() end
end

Event:FireServer("create", vehicle, module)

vehicle.DriveSeat.ChildRemoved:Connect(function(child)
	if child.Name == "SeatWeld" and child:IsA("Weld") then
		Event:FireServer("remove")
	end
end)

RPM.Changed:Connect(function(val)
	if not isOn.Value and not script.Parent.Parent.Values.Starting.Value and not disengaged then
		disengaged = true
		Event:FireServer("disengage")
	end
end)

isOn.Changed:Connect(function(val)
	if isOn.Value then
		disengaged = false
		Event:FireServer("stop")
	end
end)

local function onInput(input:InputObject, gameProcessedEvent:boolean)
	if gameProcessedEvent then return
	end
	if not (input.KeyCode == _Settings.Controls.Startup or input.KeyCode == _Settings.Controls.ContlrStartup) then return
	end
	if script.Parent.Parent.Values.IsOn.Value then
		if input.UserInputState == Enum.UserInputState.End then return
		end
		script.Parent.Parent.Values.IsOn.Value = false
	else
		script.Parent.Parent.Values.Starting.Value = input.UserInputState == Enum.UserInputState.Begin
		if (input.UserInputState == Enum.UserInputState.Begin) then
			if RPM.Value < _Settings.StartRPM then
				Event:FireServer("starter")
			end
			if module.StarterGrinding then
				if RPM.Value >= 100 then
					randomizer = math.random(1, 2)
					if randomizer == 1 then
						Event:FireServer("grind")
					end
				end
			end
		else
			Event:FireServer("stop")
			stopSounds()
		end
	end
end

script.Parent.Parent.Mobile_Support.Startup.MouseButton1Down:Connect(function(mobilestart)
	mobile = true
	if not script.Parent.Parent.Values.IsOn.Value then
		if RPM.Value < _Settings.StartRPM then
			Event:FireServer("starter")
			script.Parent.Parent.Values.Starting.Value = true
		end
		if module.StarterGrinding then
			if RPM.Value >= 100 then
				randomizer = math.random(1, 2)
				if randomizer == 1 then
					Event:FireServer("grind")
				end
			end
		end
	else
		script.Parent.Parent.Values.IsOn.Value = false
	end
end)

script.Parent.Parent.Mobile_Support.Startup.MouseButton1Down:Connect(function(mobileend)
	mobile = true
	script.Parent.Parent.Values.Starting.Value = false
end)

local function update()
	if not script.Parent.Parent.Values.Mobile.Value then
		gamepadPresent = UserInputService.GamepadEnabled
		script.Parent.Text = "Hold <b><stroke color = 'rgb(54, 54, 54)' joins='round' thickness='3' transparency='.2'>"..(gamepadPresent and _Settings.Controls.ContlrStartup.Name or _Settings.Controls.Startup.Name).."</stroke></b> to turn on."
		if not mobile then
			script.Parent.Visible = not script.Parent.Parent.Values.IsOn.Value
		else
			script.Parent.Visible = false
		end
	end
end

UserInputService.InputBegan:Connect(onInput)
UserInputService.InputChanged:Connect(onInput)
UserInputService.InputEnded:Connect(onInput)

UserInputService.GamepadConnected:Connect(update)
UserInputService.GamepadDisconnected:Connect(update)
script.Parent.Parent.Values.IsOn.Changed:Connect(update)
update()]]></ProtectedString>
