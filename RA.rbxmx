						<string name="ScriptGuid">{B7F58122-CE84-45F8-AFC0-61378EEAF5BD}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Camera</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX8465EA3D8EEE4E5182837B3745BF7AEA">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--[[ Welcome, tuner.
    ____  ___
   / __ \/   | Entity
  / /_/ / /| | Roblox self propelled land vehicle chassis
 / __ _/ ___ | 0.51.4
/_/ |_/_/  |_| GitHub:    https://github.com/totallyahuman445/Roblox-Entity-RA
               Discord:   https://discord.gg/bS2A448Vrk
               Community: https://www.roblox.com/share/g/206794047
			   THE List:  https://docs.google.com/document/d/1WvOWw7ST4ZWpsCfXM3abJTTBkCA40NsayIEIdCRJOYM/edit?usp=sharing
			   Log:		  https://docs.google.com/document/d/1SLW5NOAysg2rE6C52WEPnmOas_MNbeVNEv0xv2f__ps/edit?usp=sharing
			   Credits:   https://docs.google.com/document/d/1-mIgEhmugHfVUDz4vzZMS7XYMoEdLKedy0MedRqvbyA/edit?usp=sharing
]]
local Pedals               = true  -- Pedals

local Handbrake            = true  -- Handbrake

local HandBrakeDisengage   = true  -- Handbrake off

local Shift                = true  -- Gear lever / paddle shift.

-- Misc
local ButtonSounds         = true  -- TCS, ABS, CS and ESC sounds

local Chime                = false -- Startup chime
local ChimeDelay           = 0     -- Startup chime delay in seconds.

local StartUpMisc          = false -- CardReader, ETC, anything else that will be played during start up.
local StartUpMiscDelay     = 0     -- Startup misc delay in seconds.

local TCSButton            = true  -- TCS button sound.
local ABSButton            = true  -- ABS button sound.
local CSButton             = true  -- CS button sound.
local ESCButton            = true  -- ESC button sound.
local DRSButton            = true  -- DRS button sound.

local Vehicle = script.Parent.Vehicle.Value
local _Settings = require(Vehicle.Settings)
local UserInputService = game:GetService("UserInputService")
local Values = script.Parent.Values
local Player = game.Players.LocalPlayer
local Mouse = Player:GetMouse()
local handler = Vehicle:WaitForChild("Interior_Sounds")
local ison = script.Parent.Values.IsOn

task.wait(.5)
for i,Sound in pairs(Vehicle.DriveSeat.InteriorSounds:GetChildren()) do
	if Sound:IsA("Sound") then
		if Sound.Name == "HandBrake" then
			handler:FireServer("SetSound", "HandBrake")
		elseif Sound.Name == "HandBrakeDisengage" then
			handler:FireServer("SetSound", "HandBrakeDisengage")
		elseif Sound.Name == "Pedal" then
			handler:FireServer("SetSound", "Pedal")
		elseif Sound.Name == "Shift" then
			handler:FireServer("SetSound", "Shift")
		elseif Sound.Name == "Button" then
			handler:FireServer("SetSound", "Button")
		elseif Sound.Name == "Chime" then
			handler:FireServer("SetSound", "Chime")
		elseif Sound.Name == "MiscStart" then
			handler:FireServer("SetSound", "MiscStart")
		end
	end
end

if Pedals then
	Values.InputThrottleBool.Changed:Connect(function()
		if Values.InputThrottleBool.Value then
			handler:FireServer("PlaySound", "Pedal", nil)
		end
	end)
	Values.InputBrakeBool.Changed:Connect(function()
		if Values.InputBrakeBool.Value then
			handler:FireServer("PlaySound", "Pedal", nil)
		end
	end)
	Values.InputClutch.Changed:Connect(function()
		handler:FireServer("PlaySound", "Pedal", nil)
	end)
end

if Handbrake then
	Values.PBrake.Changed:Connect(function()
		if HandBrakeDisengage then
			if Values.PBrake.Value then
				handler:FireServer("PlaySound", "HandBrake")
			else
				handler:FireServer("PlaySound", "HandBrakeDisengage")
			end
		else
			handler:FireServer("PlaySound", "HandBrake", nil)
		end
	end)
end

if Shift then
	Values.Gear.Changed:Connect(function()
		if Values.TransmissionMode.Value == ("Semi") or Values.TransmissionMode.Value == ("Manual") or Values.Gear.Value < 2 and Values.TransmissionMode.Value == ("Auto") then
			handler:FireServer("PlaySound", "Shift", nil)
		end
	end)
end

if ButtonSounds then
	if TCSButton then
		Values.TCS.Changed:Connect(function()
			handler:FireServer("PlaySound", "Button", nil)
		end)
	end
	if ABSButton then
		Values.ABS.Changed:Connect(function()
			handler:FireServer("PlaySound", "Button", nil)
		end)
	end
	if CSButton then
		Values.CS.Changed:Connect(function()
			handler:FireServer("PlaySound", "Button", nil)
		end)
	end
	if ESCButton then
		Values.ESC.Changed:Connect(function()
			handler:FireServer("PlaySound", "Button", nil)
		end)
	end
	if DRSButton then
		Values.DRS.Changed:Connect(function()
			handler:FireServer("PlaySound", "Button", nil)
		end)
	end
end

if Chime then
	ison.Changed:Connect(function()
		if ison.Value then
			task.wait(ChimeDelay)
			handler:FireServer("PlaySound", "Chime", nil)
		end
	end)
end

ison.Changed:Connect(function()
	if ison.Value then
		if Chime then
			task.wait(ChimeDelay)
			handler:FireServer("PlaySound", "Chime", nil)
		elseif StartUpMisc then
			task.wait(StartUpMiscDelay)
			handler:FireServer("PlaySound", "MiscStart", nil)
		end
	end
end)]]></ProtectedString>
