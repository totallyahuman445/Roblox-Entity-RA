								<ProtectedString name="Source"><![CDATA[--[[ Welcome, tuner.
    ____  ___
   / __ \/   | Entity
  / /_/ / /| | Roblox self propelled land vehicle chassis
 / __ _/ ___ | 0.51.4
/_/ |_/_/  |_| GitHub:    https://github.com/totallyahuman445/Roblox-Entity-RA
               Discord:   https://discord.gg/bS2A448Vrk
               Community: https://www.roblox.com/share/g/206794047
			   THE List:  https://docs.google.com/document/d/1WvOWw7ST4ZWpsCfXM3abJTTBkCA40NsayIEIdCRJOYM/edit?usp=sharing
			   Log:		  https://docs.google.com/document/d/1SLW5NOAysg2rE6C52WEPnmOas_MNbeVNEv0xv2f__ps/edit?usp=sharing
			   Credits:   https://docs.google.com/document/d/1-mIgEhmugHfVUDz4vzZMS7XYMoEdLKedy0MedRqvbyA/edit?usp=sharing
]]
local module = {}
vehicle = script.Parent.Parent.Parent.Vehicle.Value

module.StarterGrinding = true -- Starter gear grinding with flywheel. You can set up the StartAccel in the RA Settings module.

module.StarterSounds = {
	{
		id			= 2016068496, -- Starter sound ID
		volume		= 3,
		rollOffMin	= 10,
		rollOffMax	= 100,
		name 		= "Starter",
		parent 		= vehicle.Body.System.Sounds.Engine
	},
	{
		id			= 4655463946, -- Disengage sound ID
		volume		= 2,
		rollOffMin	= 10,
		rollOffMax	= 100,
		name 		= "Disengage",
		parent 		= vehicle.Body.System.Sounds.Engine
	},
	{
		id 			= 9114562634, -- Gear Grinding sound ID
		volume		= .2,
		rollOffMin	= 10,
		rollOffMax	= 100,
		name 		= "Grind",
		parent 		= vehicle.Body.System.Sounds.Engine
	}
}
return module]]></ProtectedString>
