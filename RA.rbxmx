							<Properties>
								<ProtectedString name="Source"><![CDATA[local vehicle = script.Parent.Parent
local location = script.Crackles_Location.Value
local CrackleSounds = {}

CrackleSounds.Crackle = function(selected)
	location["Crackle"..selected]:play()
end

script.Parent.OnServerEvent:connect(function(pl, Fnc, ...)
	CrackleSounds[Fnc](...)
end)]]></ProtectedString>
