										<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local goal = {}
goal.BorderSizePixel = 2
goal.BorderColor3 = Color3.fromRGB(255, 0, 0)

local goal2 = {}
goal2.BorderSizePixel = 1
goal2.BorderColor3 = Color3.fromRGB(61, 61, 61)

function show()
	local tweenInfo = TweenInfo.new(.25)
	local tween = TweenService:Create(script.Parent, tweenInfo, goal)
	tween:Play()
end

function hide()
	local tweenInfo = TweenInfo.new(.1)
	local tween = TweenService:Create(script.Parent, tweenInfo, goal2)
	tween:Play()
end

script.Parent.InputBegan:Connect(show)
script.Parent.InputEnded:Connect(hide)]]></ProtectedString>
