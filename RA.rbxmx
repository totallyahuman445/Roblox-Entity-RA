				<Item class="LocalScript" referent="RBXBD4A908769DD4BC1B326C96C845A212E">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--[[START]]
script.Parent:WaitForChild("Vehicle")
script.Parent:WaitForChild("Values")

--[[Hard blocks]]
local VirtualInputEnabled = true

--[[Dependencies]]
local player = game.Players.LocalPlayer
local character = player.Character
local mouse = player:GetMouse()
local UserInputService = game:GetService("UserInputService")
local TextChatService = game:GetService("TextChatService")
local GuiService = game:GetService("GuiService")
local vehicle = script.Parent.Vehicle.Value
local _Settings = require(vehicle.Settings)
local Units = require(vehicle.Settings.Units)
local playerModule = require(player.PlayerScripts:WaitForChild("PlayerModule"))
local values = script.Parent.Values
local ison = values.IsOn
local FE = workspace.FilteringEnabled
local VirtualInput = script.VirtualInput
local RunService = game:GetService("RunService")
local nam = vehicle.Settings.Chassis.ChassisName.Value
local ver = vehicle.Settings.Chassis.Version.Value

player.PlayerGui.ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor

--[[Rev body shake]]
if _Settings.RevShake then
	RunService.RenderStepped:connect(function()
		local Drop = (((_Settings.Cylinders * _Settings.Roughness) / _Settings.Stiffness) / 20) - (values.Velocity.Value.Magnitude / 5)
		if Drop < 0 then
			Drop = 0
		end
		if values.Gear.Value == 0 then
			_Settings.RevShakeLocation.RevBodyShake.Force = Vector3.new((150 * values.Throttle.Value) * Drop, 0, 0)
		else
			_Settings.RevShakeLocation.RevBodyShake.Force = Vector3.new(0, 0, 0)
		end
	end)
end

if not workspace:PGSIsEnabled() then
	error("PGS is not enabled:" ..nam .." will not work")
end

-- Status variables
local boolToNum = {[true] = 1, [false] = 0}
local min = math.min
local max = math.max

local _IsOn = _Settings.AutoStart
if _Settings.AutoStart and (_Settings.Engine or _Settings.Electric) then
	ison.Value = true
end
local _GSteerT = 0
local _GSteerC = 0
local _GThrot = 0
local _InThrot = 0
local _IThrot = 0
local _GBrake = 0
local _InBrake = 0
local _IBrake = 0

local _ClPressing = false
local _PlayerClutch = false
local _GClutch = 0
local _ABSAmt = 0
local _Clutch = 0
local _ClutchKick = 0
local _ClutchModulate = 0
local _RPM = _Settings.StartRPM
local _HP = 0
local _OutTorque = 0
local _TMode = _Settings.TransModes[1]
local _CGear = vehicle.Settings.Interface.Values.Gear.Value
local _FReverse = 0
local _PGear = _CGear
local _ShiftUp = false
local _ShiftDn = false
local _Shifting = false
local _spLimit = 0
local _SConfig = _Settings.S_Config
local _Boost = 0
local _TCount = 0
local _TPsi = 0
local _TBoost = 0
local _SCount = 0
local _SPsi = 0
local _SBoost = 0
local _NH = 0
local _NT = 0
local _EH = 0
local _ET = 0
local _TH = 0
local _TT = 0
local _SH = 0
local _ST = 0
local _BH = 0
local _BT = 0
local _SuperSpoolValue = 0
local _TBoostGoal = 0
local _ABSTracker = {}
local _TCSTracker = {}
local _CVTFakeShifting = _Settings.CVTFakeShifting
local _CVTFakeShiftingStartRPM = _Settings.CVTFakeShiftingStartRPM
local _CVTFakeShiftingDropRPM = _Settings.CVTFakeShiftingDropRPM
local _CVTFakeShiftingDropDelay = _Settings.CVTFakeShiftingDropDelay
local _CVTFakeShiftingShiftTime = _Settings.CVTFakeShiftingShiftTime
local _CVTFakeShiftingUseClutch = _Settings.CVTFakeShiftingUseClutch
local _CVTRatio = _Settings.CVTMaxRatio
local _CurrentRatio = _Settings.Ratios[_CGear + 2]
local _FlywheelEnergy = 0

local _MSteer = false
local _SteerL = false
local _SteerR = false
local wheelie = false
local WheelieInput = 0
local KeyWhel = false
local _PBrake = vehicle.Settings.Interface.Values.PBrake.Value
local _FBrake = vehicle.Settings.Interface.Values.FBrake.Value
local _TCS = _Settings.TCSEnabled
local _TCSActive = false
local _TCSAmt = 0
local _ABS = _Settings.ABSEnabled
local _ABSActive = false

local _ESCTracker = {}
local _ESC = _Settings.ESCEnabled
local _ESCActive = false
local _ESCAmt = 0

local _CS = _Settings.CSEnabled
local _CSActive = false
local _CSAmt = 0

local FlipWait = tick()
local FlipDB = false

local _LastInputWasGamepad = false
local ChatInputBarConfiguration = TextChatService.ChatInputBarConfiguration

local revLimiting = false
local _TorqueVector = _Settings.TorqueVector

local _WheelSpeedsTable = {}
local _WheelSpeeds = {}
local _VehicleCenter = CFrame.new()
local autoshiftvers = _Settings.AutoShiftVers
local _OldVelocity = Vector3.new()
local _Acceleration = Vector3.new()
local _AvgWheelSpeed = 0

local Wheels = {}
local WheelCount = 0
local FrontWheelCount = 0
local MidWheelCount = 0
local RearWheelCount = 0
for _, v in vehicle.Wheels:GetChildren() do
	WheelCount += 1
	if string.find(v.Name, "F") then
		FrontWheelCount += 1
	elseif string.find(v.Name, "M") then
		MidWheelCount += 1
	elseif string.find(v.Name, "R") then
		RearWheelCount += 1
	end
	table.insert(Wheels, v)
end

if _Settings.Wheelie then
	if not vehicle.Body.Wheelie:FindFirstChild("Wheelie") then
		gyro = Instance.new("BodyGyro")
		gyro.Name = "Wheelie"
		gyro.Parent = vehicle.Body.Wheelie
	else
		gyro = vehicle.Body.Wheelie.Wheelie
	end
end

-- Shutdown
vehicle.DriveSeat.ChildRemoved:connect(function(child)
	if child.Name == "SeatWeld" and child:IsA("Weld") then
		script.Parent:Destroy()
	end
end)

-- Controls
local Controls = Instance.new("Folder", script.Parent)
Controls.Name = "Controls"
for i, v in next, (_Settings.Controls) do
	local a = Instance.new("StringValue", Controls)
	a.Name = i
	a.Value = v.Name
	a.Changed:connect(function()
		if i == "MouseThrottle" or i == "MouseBrake" then
			if a.Value == "MouseButton1" or a.Value == "MouseButton2" then
				_Settings.Controls[i] = Enum.UserInputType[a.Value]
			else
				_Settings.Controls[i] = Enum.KeyCode[a.Value]
			end
		else
			_Settings.Controls[i] = Enum.KeyCode[a.Value]
		end
	end)
end

-- Input functions
function TModeChange()
	local n = 1
	for i, v in next, (_Settings.TransModes) do
		if v == _TMode then
			n = i
			break
		end
	end
	n = n + 1
	if n > #_Settings.TransModes then
		n = 1
	end
	_TMode = _Settings.TransModes[n]
end

function TCSModeChange()
	if not _Settings.TCSLocked and _Settings.TCSEnabled then
		_TCS = not _TCS
	end
end

function ABSModeChange()
	if not _Settings.ABSLocked and _Settings.ABSEnabled then
		_ABS = not _ABS
	end
end

function ESCModeChange()
	if not _Settings.ESCLocked and _Settings.ESCEnabled then
		_ESC = not _ESC
	end
end

function CSModeChange()
	if not _Settings.CSLocked and _Settings.CSEnabled then
		_CS = not _CS
	end
end

-- Input
values.Input.ChangeTMode.Changed:Connect(TModeChange)
values.Input.ChangeTCSMode.Changed:Connect(TCSModeChange)
values.Input.ChangeABSMode.Changed:Connect(ABSModeChange)
values.Input.ChangeESCMode.Changed:Connect(ESCModeChange)
values.Input.ChangeCSMode.Changed:Connect(CSModeChange)

-- Deadzone adjust
local _PPH = _Settings.Peripherals
	for i, v in next, (_PPH) do
	local a = Instance.new("IntValue", Controls)
	a.Name = i
	a.Value = v
	a.Changed:connect(function()
		a.Value = math.min(100, math.max(0, a.Value))
		_PPH[i] = a.Value
	end)
end

function GetVehicleCenter()
	local centerF = Vector3.new()
	local centerR = Vector3.new()
	local countF = 0
	local countR = 0
	for i, v in next, vehicle.Wheels:GetChildren() do
		if v.Name == "FL" or v.Name == "FR" or v.Name == "F" then
			centerF = centerF + v.CFrame.p
			countF = countF + 1
		else
			centerR = centerR + v.CFrame.p
			countR = countR + 1
		end
	end
	centerF = centerF / countF
	centerR = centerR / countR
	local center = CFrame.lookAt(centerR:Lerp(centerF, .5), centerF)
	return center
end

-- Value creator
local function setValue(type, name, value, parent)
	local valueObj = (parent or values):FindFirstChild(name)
	if not valueObj then
		valueObj = Instance.new(type.. "Value", (parent or values))
		valueObj.Name = name
	end
	valueObj.Value = value
end
local function getValue(name, parent)
	local valueObj = (parent or values):FindFirstChild(name)
	return valueObj and valueObj.Value
end

setValue("Bool", "AutoClutch", true)

-- Input Handler
function DealWithInput(input, IsRobloxFunction)
	if not UserInputService:GetFocusedTextBox() and not ChatInputBarConfiguration.IsFocused then -- Ignore when UI Focus
		-- Hide UI
		if input.KeyCode == _Settings.Controls.HideUI and input.UserInputState == Enum.UserInputState.Begin then
			script.Parent.Enabled = not script.Parent.Enabled
		end
		-- Hide cursor
		if input.KeyCode == _Settings.Controls.HideCursor and input.UserInputState == Enum.UserInputState.Begin then
			UserInputService.MouseIconEnabled = not UserInputService.MouseIconEnabled
		end
		-- Shift Down [Manual transmission]
		if ((_MSteer and input.KeyCode == _Settings.Controls.MouseShiftDown) or ((not _MSteer) and input.KeyCode == _Settings.Controls.ShiftDown)) and ((_IsOn and ((_TMode == "Auto" and _CGear <= 1) and _Settings.AutoShiftVers == "New") or _TMode == "Semi") or _TMode == "Manual") and input.UserInputState == Enum.UserInputState.Begin then
			if not _ShiftDn then
				_ShiftDn = true
			end
		-- Shift Up [Manual transmission]
		elseif ((_MSteer and input.KeyCode == _Settings.Controls.MouseShiftUp) or ((not _MSteer) and input.KeyCode == _Settings.Controls.ShiftUp)) and ((_IsOn and ((_TMode == "Auto" and _CGear < 1) and _Settings.AutoShiftVers == "New") or _TMode == "Semi") or _TMode == "Manual") and input.UserInputState == Enum.UserInputState.Begin then
			if not _ShiftUp then
				_ShiftUp = true
			end
		-- Toggle clutch
		elseif (input.KeyCode == _Settings.Controls.ContlrClutch or (_MSteer and input.KeyCode == _Settings.Controls.MouseClutch) or ((not _MSteer) and input.KeyCode == _Settings.Controls.Clutch)) and _TMode == "Manual" then
			if input.UserInputState == Enum.UserInputState.Begin then
				_ClPressing = true
				_PlayerClutch = true
			elseif input.UserInputState == Enum.UserInputState.End then
				_ClPressing = false
				_PlayerClutch = false
			end
		-- Toggle PBrake
		elseif input.KeyCode == _Settings.Controls.ContlrPBrake or (_MSteer and input.KeyCode == _Settings.Controls.MousePBrake) or ((not _MSteer) and input.KeyCode == _Settings.Controls.PBrake) then
			if _Settings.PBrakeOn then
				if input.UserInputState == Enum.UserInputState.Begin then
					_PBrake = not _PBrake
					vehicle.Settings.Interface.Values.PBrake.Value = not vehicle.Settings.Interface.Values.PBrake.Value
				elseif input.UserInputState == Enum.UserInputState.End then
					if vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude > 5 then
						_PBrake = false vehicle.Settings.Interface.Values.PBrake.Value = false
					end
				end
			end
		-- Toggle FBrake
		elseif input.KeyCode == _Settings.Controls.ContlrFBrake or (_MSteer and input.KeyCode == _Settings.Controls.MouseFBrake) or ((not _MSteer) and input.KeyCode == _Settings.Controls.FBrake) then
			if _Settings.FBrakeOn then
				if input.UserInputState == Enum.UserInputState.Begin then
					_FBrake = not _FBrake
					vehicle.Settings.Interface.Values.FBrake.Value = not vehicle.Settings.Interface.Values.FBrake.Value
				elseif input.UserInputState == Enum.UserInputState.End then
				end
			else
				_FBrake = false
			end
		-- Toggle transmission mode
		elseif (input.KeyCode == _Settings.Controls.ContlrToggleTMode or input.KeyCode == _Settings.Controls.ToggleTransMode) and input.UserInputState == Enum.UserInputState.Begin then
			TModeChange()
		-- Throttle
		elseif ((not _MSteer) and (input.KeyCode == _Settings.Controls.Throttle or input.KeyCode == _Settings.Controls.Throttle2)) or ((((_Settings.Controls.MouseThrottle == Enum.UserInputType.MouseButton1 or _Settings.Controls.MouseThrottle == Enum.UserInputType.MouseButton2) and input.UserInputType == _Settings.Controls.MouseThrottle) or input.KeyCode == _Settings.Controls.MouseThrottle) and _MSteer) then
			if input.UserInputState == Enum.UserInputState.Begin then
				_IThrot = 1
			else
				_IThrot = 0
			end
		-- Brake
		elseif ((not _MSteer) and (input.KeyCode == _Settings.Controls.Brake or input.KeyCode == _Settings.Controls.Brake2)) or ((((_Settings.Controls.MouseBrake == Enum.UserInputType.MouseButton1 or _Settings.Controls.MouseBrake == Enum.UserInputType.MouseButton2) and input.UserInputType == _Settings.Controls.MouseBrake) or input.KeyCode == _Settings.Controls.MouseBrake) and _MSteer) then
			if _Settings.BrakeOn then
				if input.UserInputState == Enum.UserInputState.Begin then
					_IBrake = 1
				else
					_IBrake = 0
				end
			end
		-- Steer left
		elseif (not _MSteer) and (input.KeyCode == _Settings.Controls.SteerLeft or input.KeyCode == _Settings.Controls.SteerLeft2) then
			if input.UserInputState == Enum.UserInputState.Begin then
				_GSteerT = -1
				_SteerL = true
			else
				if _SteerR then
					_GSteerT = 1
				else
					_GSteerT = 0
				end
				_SteerL = false
			end
		-- Steer right
		elseif (not _MSteer) and (input.KeyCode == _Settings.Controls.SteerRight or input.KeyCode == _Settings.Controls.SteerRight2) then
			if input.UserInputState == Enum.UserInputState.Begin then
				_GSteerT = 1
				_SteerR = true
			else
				if _SteerL then
					_GSteerT = -1
				else
					_GSteerT = 0
				end
				_SteerR = false
			end
		-- Toggle mouse controls
		elseif input.KeyCode == _Settings.Controls.ToggleMouseDrive then
			if input.UserInputState == Enum.UserInputState.End then
				_MSteer = not _MSteer
				_IThrot = 0
				_IBrake = 0
				_GSteerT = 0
		end
		-- Toggle TCS
		elseif _IsOn and (input.KeyCode == _Settings.Controls.ToggleTCS or input.KeyCode == _Settings.Controls.ContlrToggleTCS) then
			if input.UserInputState == Enum.UserInputState.End then
				TCSModeChange()
			end
		end
		-- Toggle ABS
		if not _Settings.ABSLocked and _Settings.ABSEnabled and _IsOn then
			if input.KeyCode == _Settings.Controls.ToggleABS or input.KeyCode == _Settings.Controls.ContlrToggleABS then
				if input.UserInputState == Enum.UserInputState.End then
					_ABS = not _ABS
				end
			end
		end
		-- Toggle CS
		if not _Settings.CSLocked and _Settings.CSEnabled and _IsOn then
			if input.KeyCode == _Settings.Controls.ToggleCS or input.KeyCode == _Settings.Controls.ContlrToggleCS then
				if input.UserInputState == Enum.UserInputState.End then
					_CS = not _CS
				end
			end
		end
		-- Toggle ESC
		if not _Settings.ESCLocked and _Settings.ESCEnabled and _IsOn then
			if input.KeyCode == _Settings.Controls.ToggleESC or input.KeyCode == _Settings.Controls.ContlrToggleESC then
				if input.UserInputState == Enum.UserInputState.End then
					if not gameProcessed then
						if not lastpress then
							lastpress = true
							task.wait(.25)
							lastpress = false
						else
							if _Settings.ESCEnabled and _IsOn then
								if input.KeyCode == _Settings.Controls.ToggleESC or input.KeyCode == _Settings.Controls.ContlrToggleESC then
									if input.UserInputState == Enum.UserInputState.End then
										_ESC = not _ESC
									end
								end
							end
						end
					end
				end
			end
		end
		-- Wheelie
		if (input.KeyCode == _Settings.Controls.WheelieUp) and input.UserInputState == Enum.UserInputState.Begin then
			KeyWhel = true
			WheelieInput = -1
		elseif (input.KeyCode == _Settings.Controls.WheelieUp) and input.UserInputState == Enum.UserInputState.End then
			KeyWhel = false
			WheelieInput = 0
		end
		if (input.KeyCode == _Settings.Controls.WheelieDown) and input.UserInputState == Enum.UserInputState.Begin then
			KeyWhel = true
			WheelieInput = 1
		elseif (input.KeyCode == _Settings.Controls.WheelieDown) and input.UserInputState == Enum.UserInputState.End then
			KeyWhel = false
			WheelieInput = 0
		end
		if input.UserInputType.Name:find("Gamepad") then
			-- Gamepad Wheelie
			if input.KeyCode == Enum.KeyCode.Thumbstick1 then
				if input.Position.Y >= 0 then
					if math.abs(input.Position.Y) then
						KeyWhel = false
						WheelieInput = input.Position.Y
					else
						KeyWhel = false
						WheelieInput = 0
					end
				else
					if math.abs(input.Position.Y) then
						KeyWhel = false
						WheelieInput = input.Position.Y
					else
						KeyWhel = false
						WheelieInput = 0
					end
				end
			end
		end
		-- Variable controls
		if input.UserInputType and input.UserInputType.Name:find("Gamepad") then
			-- Gamepad steering
			if input.KeyCode == _Settings.Controls.ContlrSteer then
				if input.Position.X >= 0 then
					local cDZone = math.min(.99, _Settings.Peripherals.ControlRDZone / 100)
					if math.abs(input.Position.X) > cDZone then
						_GSteerT = (input.Position.X - cDZone) / (1 - cDZone)
					else
						_GSteerT = 0
					end
				else
					local cDZone = math.min(.99, _Settings.Peripherals.ControlLDZone / 100)
					if math.abs(input.Position.X) > cDZone then
						_GSteerT = (input.Position.X + cDZone) / (1 - cDZone)
					else
						_GSteerT = 0
					end
				end
			-- Gamepad throttle
			elseif input.KeyCode == _Settings.Controls.ContlrThrottle then
				_IThrot = math.max(0, input.Position.Z)
			-- Gamepad brake
			elseif input.KeyCode == _Settings.Controls.ContlrBrake then
				_IBrake = input.Position.Z
			end
			-- Detect gamepad joystick inputs
			if input.KeyCode == Enum.KeyCode.Thumbstick2 then
				if input.Position.X == 1 then
					values.ControllerJoyStickInput.Thumbstick2Right.Value = true
				elseif input.Position.X == -1 then
					values.ControllerJoyStickInput.Thumbstick2Left.Value = true
				else
					values.ControllerJoyStickInput.Thumbstick2Right.Value = false
					values.ControllerJoyStickInput.Thumbstick2Left.Value = false
				end
				-- Gamepad shift
				if (_IsOn and ((_TMode == "Auto" and _CGear < 1) and _Settings.AutoShiftVers == "New") or _TMode == "Semi") or _TMode == "Manual" then
					if input.Position.Y == -1 then
						if not _ShiftUp and not ControllerShiftDebounce1 then
							_ShiftUp = true
							ControllerShiftDebounce1 = true
							task.wait(.2)
							ControllerShiftDebounce1 = false
						end
					elseif input.Position.Y == 1 then
						if not _ShiftDn and not ControllerShiftDebounce2 then
							_ShiftDn = true
							ControllerShiftDebounce2 = true
							task.wait(.2)
							ControllerShiftDebounce2 = false
						end
					end
				end
			elseif input.KeyCode == Enum.KeyCode.Thumbstick1 then
				if input.Position.X == 1 then
					values.ControllerJoyStickInput.Thumbstick1Right.Value = true
				elseif input.Position.X == -1 then
					values.ControllerJoyStickInput.Thumbstick1Left.Value = true
				else
					values.ControllerJoyStickInput.Thumbstick1Right.Value = false
					values.ControllerJoyStickInput.Thumbstick1Left.Value = false
				end
				if input.Position.Y == 1 then
					values.ControllerJoyStickInput.Thumbstick1Up.Value = true
				elseif input.Position.Y == -1 then
					values.ControllerJoyStickInput.Thumbstick1Down.Value = true
				else
					values.ControllerJoyStickInput.Thumbstick1Up.Value = false
					values.ControllerJoyStickInput.Thumbstick1Down.Value = false
				end
			end
		end
	else
		_IThrot = 0
		_GSteerT = 0
		_IBrake = 0
	end
end
UserInputService.InputBegan:connect(DealWithInput)
UserInputService.InputChanged:connect(DealWithInput)
UserInputService.InputEnded:connect(DealWithInput)

--[[Drivetrain initialize]]
-- Mobile support
if UserInputService.TouchEnabled then
	local Buttons = script.Parent:WaitForChild("Mobile_Support")
	local PositionValues = Buttons.PositionValues
	values.Mobile.Value = true
	if _Settings.AutoStart then
		Buttons.Startup.Visible = false
		Buttons.Startup.Selectable = false
	end
	if not _Settings.Wheelie then
		Buttons.Up:Destroy()
		Buttons.Down:Destroy()
	end
	Buttons.Clutch.Position = UDim2.new(PositionValues.PhoneClutchPosition1.Value, PositionValues.PhoneClutchPosition2.Value, PositionValues.PhoneClutchPosition3.Value, PositionValues.PhoneClutchPosition4.Value)

	-- Tilt
	function DealWithMobileInput()
		if UserInputService.GyroscopeEnabled then
			UserInputService.DeviceRotationChanged:Connect(function(rotation, cframe)
				if not values.TabletMode.Value then
					_GSteerT = -math.clamp(rotation.Position.Z * 2, -1, 1)
					WheelieInput = -math.clamp(rotation.Position.X * 2, -1, 1)
				end
			end)
		end
	end
	DealWithMobileInput()
	values.TabletMode.Changed:Connect(DealWithMobileInput)

	local Thread = coroutine.wrap(function()
		while task.wait(.25) do
			if _TMode == "Manual" then
				Buttons.Clutch.Interactable = true
				Buttons.Clutch.Visible = true
			else
				Buttons.Clutch.Interactable = false
				Buttons.Clutch.Visible = false
			end
			if _TMode == "Semi" or _TMode == "Manual" then
				Buttons.Downshift.Interactable = true
				Buttons.Upshift.Interactable = true
				Buttons.Downshift.Visible = true
				Buttons.Upshift.Visible = true
			else
				Buttons.Downshift.Interactable = false
				Buttons.Upshift.Interactable = false
				Buttons.Downshift.Visible = false
				Buttons.Upshift.Visible = false
			end
			if not values.TabletMode.Value then
				Buttons.Right.Interactable = false
				Buttons.Left.Interactable = false
				Buttons.Right.Visible = false
				Buttons.Left.Visible = false
				Buttons.Clutch.Position = UDim2.new(PositionValues.PhoneClutchPosition1.Value, PositionValues.PhoneClutchPosition2.Value, PositionValues.PhoneClutchPosition3.Value, PositionValues.PhoneClutchPosition4.Value)
				if _Settings.Wheelie then
					Buttons.Up.Interactable = true
					Buttons.Down.Interactable = true
					Buttons.Up.Visible = true
					Buttons.Down.Visible = true
				end
			else
				Buttons.Right.Interactable = true
				Buttons.Left.Interactable = true
				Buttons.Right.Visible = true
				Buttons.Left.Visible = true
				Buttons.Clutch.Position = UDim2.new(PositionValues.TabletClutchPosition1.Value, PositionValues.TabletClutchPosition2.Value, PositionValues.TabletClutchPosition3.Value, PositionValues.TabletClutchPosition4.Value)
				if _Settings.Wheelie then
					Buttons.Up.Interactable = true
					Buttons.Down.Interactable = true
					Buttons.Up.Visible = true
					Buttons.Down.Visible = true
				end
			end
		end
	end)
	Thread()
	Buttons.Visible = true

	local function TouchThrottle(input, GPE)
		if input.UserInputState == Enum.UserInputState.Begin and _IsOn then
			_IThrot = 1
		else
			_IThrot = _Settings.IdleThrottle / 1000
		end
	end
	Buttons.Throttle.InputBegan:Connect(TouchThrottle)
	Buttons.Throttle.InputEnded:Connect(TouchThrottle)

	if _Settings.BrakeOn then
		Buttons.Brake.Interactable = true
		Buttons.Brake.Visible = true
		local function TouchBrake(input, GPE)
			if input.UserInputState == Enum.UserInputState.Begin then
				_IBrake = 1
			else
				_IBrake = 0
			end
		end
		Buttons.Brake.InputBegan:Connect(TouchBrake)
		Buttons.Brake.InputEnded:Connect(TouchBrake)
	end

	local function RightTurn(Touch, GPE)
		if Touch.UserInputState == Enum.UserInputState.Begin then
			_GSteerT = 1
			_SteerR = true
		else
			if _SteerL then
				_GSteerT = -1
			else
				_GSteerT = 0
			end
			_SteerR = false
		end
	end
	Buttons.Right.InputBegan:Connect(RightTurn)
	Buttons.Right.InputEnded:Connect(RightTurn)

	local function LeftTurn(Touch, GPE)
		if Touch.UserInputState == Enum.UserInputState.Begin then
			_GSteerT = -1
			_SteerL = true
		else
			if _SteerR then
				_GSteerT = 1
			else
				_GSteerT = 0
			end
			_SteerL = false
		end
	end
	Buttons.Left.InputBegan:Connect(LeftTurn)
	Buttons.Left.InputEnded:Connect(LeftTurn)

	if _Settings.Wheelie then
		local function UpWheelie(Touch, GPE)
			if Touch.UserInputState == Enum.UserInputState.Begin then
				WheelieInput = -1
			else
				WheelieInput = 0
			end
		end
		Buttons.Up.InputBegan:Connect(UpWheelie)
		Buttons.Up.InputEnded:Connect(UpWheelie)

		local function DownWheelie(Touch, GPE)
			if Touch.UserInputState == Enum.UserInputState.Begin then
				WheelieInput = 1
			else
				WheelieInput = 0
			end
		end
		Buttons.Down.InputBegan:Connect(DownWheelie)
		Buttons.Down.InputEnded:Connect(DownWheelie)
	end

	if _Settings.PBrakeOn then
		local function TouchHandbrake(input, GPE)
			if input.UserInputState == Enum.UserInputState.Begin then
				_PBrake = not _PBrake
			elseif input.UserInputState == Enum.UserInputState.End then
				if vehicle.DriveSeat.Velocity.Magnitude > 5 then
					_PBrake = false
				end
			end
		end
		Buttons.Handbrake.InputBegan:Connect(TouchHandbrake)
		Buttons.Handbrake.InputEnded:Connect(TouchHandbrake)
	else
		Buttons.Handbrake.Visible = false
	end

	if _Settings.FBrakeOn then
		local function TouchFootbrake(input, GPE)
			if input.UserInputState == Enum.UserInputState.Begin then
				_FBrake = not _FBrake
			elseif input.UserInputState == Enum.UserInputState.End then
				if vehicle.DriveSeat.Velocity.Magnitude > 5 then
					_FBrake = false
				end
			end
		end
		Buttons.Footbrake.InputBegan:Connect(TouchFootbrake)
		Buttons.Footbrake.InputEnded:Connect(TouchFootbrake)
	else
		Buttons.Footbrake.Visible = false
	end

	local function TouchDownshift(input, GPE)
		if ((_IsOn and ((_TMode == "Auto" and _CGear <= 1) and _Settings.AutoShiftVers == "New") or _TMode == "Semi") or _TMode == "Manual") and input.UserInputState == Enum.UserInputState.Begin then
			if not _ShiftDn then
				_ShiftDn = true
			end
		end
	end
	Buttons.Downshift.InputBegan:Connect(TouchDownshift)

	local function TouchUpshift(input, GPE)
		if ((_IsOn and ((_TMode == "Auto" and _CGear < 1) and _Settings.AutoShiftVers == "New") or _TMode == "Semi") or _TMode == "Manual") and input.UserInputState == Enum.UserInputState.Begin then
			if not _ShiftUp then
				_ShiftUp = true
			end
		end
	end
	Buttons.Upshift.InputBegan:Connect(TouchUpshift)

	local function TouchClutch(input, GPE)
		if input.UserInputState == Enum.UserInputState.Begin then
			_ClPressing = true
			_PlayerClutch = true
		else
			_ClPressing = false
			_PlayerClutch = false
		end
	end
	Buttons.Clutch.InputBegan:Connect(TouchClutch)
	Buttons.Clutch.InputEnded:Connect(TouchClutch)
end

-- Drivetrain initialize
local Drive = {}

-- Power front wheels
if _Settings.Config == "FWD" or _Settings.Config == "AWD" then
	for i, v in next, (vehicle.Wheels:GetChildren()) do
		if string.sub(v.Name, 1, 1) == "F" then
			table.insert(Drive, v)
		end
	end
end

-- Power mid wheels
if _Settings.Config == "MWD" or _Settings.Config == "AWD" then
	for i, v in next, (vehicle.Wheels:GetChildren()) do
		if string.sub(v.Name, 1, 1) == "M" then
			table.insert(Drive, v)
		end
	end
end

-- Power rear wheels
if _Settings.Config == "RWD" or _Settings.Config == "AWD" then
	for i, v in next, (vehicle.Wheels:GetChildren()) do
		if string.sub(v.Name, 1, 1) == "R" then
			table.insert(Drive, v)
		end
	end
end

-- Determine wheel Size
local wDia = 0 for i, v in next, (Drive) do
	if v.Size.Y > wDia then
		wDia = v.Size.Y
	end
end

-- Pre-toggled PBrake
if _Settings.PBrakeOn and _Settings.PreToggledPBrake then
	for i, v in next, (vehicle.Wheels:GetChildren()) do
		local PBrakeForce = v.Values.PBrakeForce.Value * 9.80665 * Units.Force_N -- conversion to SI unit * 9.80665 * Units.Force_N -- conversion to SI unit
		if (math.abs(v["#BV"].MotorMaxTorque - PBrakeForce) < 1)
		then
			_PBrake = true
		end
	end
end

--[[Throttle and brake input smoothening]]
function Inputs(dt)
	local deltaTime = (60 / (1 / dt))
	if _InThrot <= _IThrot then
		_InThrot = math.min(_IThrot, _InThrot + (_Settings.ThrotAccel * deltaTime))
	else
		_InThrot = math.max(_IThrot, _InThrot - (_Settings.ThrotDecel * deltaTime))
	end
	if _InBrake <= _IBrake then
		_InBrake = math.min(_IBrake, _InBrake + (_Settings.BrakeAccel * deltaTime))
	else
		_InBrake = math.max(_IBrake, _InBrake - (_Settings.BrakeDecel * deltaTime))
	end
	if _Settings.Wheelie then
		if WheelieInput < -.1 then
			gyro.D = 5 * (-(WheelieInput) * 1)
			gyro.MaxTorque = Vector3.new(90 * (-(WheelieInput) * 1), 0, 0)
			gyro.P = 10 * (-(WheelieInput) * 1)
			gyro.CFrame = CFrame.new(vehicle.Body.Wheelie.CFrame.p, vehicle.Body.Wheelie.CFrame.p + vehicle.Body.Wheelie.CFrame.lookVector) * CFrame.Angles((-((WheelieInput) * 1.5) * 1)-vehicle.Body.Wheelie.CFrame.lookVector.Y, 0, 0)
		elseif WheelieInput > .1 then
			gyro.D = 15 * (-(WheelieInput) * 1)
			gyro.MaxTorque = Vector3.new(6.5 * (-(WheelieInput) * 1), 0, 0)
			gyro.P = 10 * (-(WheelieInput) * 1)
			gyro.CFrame = CFrame.new(vehicle.Body.Wheelie.CFrame.p, vehicle.Body.Wheelie.CFrame.p + vehicle.Body.Wheelie.CFrame.lookVector) * CFrame.Angles((-((WheelieInput) * 1.5) * 1)-vehicle.Body.Wheelie.CFrame.lookVector.Y, 0, 0)
		else
			gyro.D = 0
			gyro.MaxTorque = Vector3.new(0, 0, 0)
			gyro.P = 0
			gyro.CFrame = CFrame.new(vehicle.Body.Wheelie.CFrame.p, vehicle.Body.Wheelie.CFrame.p + vehicle.Body.Wheelie.CFrame.lookVector) * CFrame.Angles(0, 0, 0)
		end
	end
end

--[[Steering]]
function Steering(dt)
	local deltaTime = (60 / (1 / dt))
	local controller = _LastInputWasGamepad or (_Settings.MSteerUsesContlr and _MSteer or false)
	local SteerSpeed = controller and (_Settings.ContlrSteerSpeed > 0 and _Settings.ContlrSteerSpeed or _Settings.Steerspeed) or _Settings.SteerSpeed * (1 - math.min(vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude / (Units.Velocity_mdivs / 3.6) / _Settings.SteerSpeedDecay, 1 - (_Settings.MinSteerSpeed / 100)))
	local ReturnSpeed = controller and (_Settings.ContlrReturnSpeed > 0 and _Settings.ContlrReturnSpeed or _Settings.ReturnSpeed) or _Settings.ReturnSpeed * (1 - math.min(vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude / _Settings.SteerSpeedDecay, 1 - (_Settings.MinSteerSpeed / 100)))
	-- Mouse steering
	if _MSteer then
		msWidth = math.max(1, mouse.ViewSizeX * _Settings.Peripherals.MSteerWidth / 200)
		mdZone = _Settings.Peripherals.MSteerDZone / 100
		mST = ((mouse.X - mouse.ViewSizeX / 2) / msWidth)
		if math.abs(mST) <= mdZone then
			_GSteerT = 0
		else
			_GSteerT = (math.max(math.min((math.abs(mST) - mdZone),(1 - mdZone)), 0) / (1 - mdZone)) ^ _Settings.MSteerExp * (mST / math.abs(mST))
		end
	end
	for i, v in Wheels do
		local WheelValues = v.Values

		-- Interpolate steering
		if math.abs(_GSteerT) < WheelValues.CSSteerThresh.Value / 100 and _CS and values.Velocity.Value.Magnitude * (Units.Length_mm / 1000) * 3.6 > WheelValues.CSSpeedThresh.Value then
			_CSAmt = (_VehicleCenter:VectorToObjectSpace(values.Velocity.Value):Dot(Vector3.new(1, 0, 0)) / math.max(values.Velocity.Value.Magnitude * (Units.Length_mm / 1000) * 3.6, WheelValues.CSSpeedThresh.Value)) * (WheelValues.CSAmt.Value / 100)
		else
			_CSAmt = 0
		end
		if math.abs(_CSAmt) > (WheelValues.CSAmt.Value / 100) * .01 then
			_CSActive = true
		else
			_CSActive = false
		end
		local SteerWithCounter = math.clamp(_GSteerT + _CSAmt, -1, 1)
		local SteerSmoothing = math.clamp(math.abs(SteerWithCounter - _GSteerC) ^ (1 / math.max(_Settings.SteerSmoothing, .001)), 0, 1)
		if _GSteerC < SteerWithCounter then
			if _GSteerC < 0 then
				_GSteerC = math.min(SteerWithCounter, _GSteerC + (ReturnSpeed * SteerSmoothing * deltaTime))
			else
				_GSteerC = math.min(SteerWithCounter, _GSteerC + (SteerSpeed * SteerSmoothing * deltaTime))
			end
		else
			if _GSteerC > 0 then
				_GSteerC = math.max(SteerWithCounter, _GSteerC - (ReturnSpeed * SteerSmoothing * deltaTime))
			else
				_GSteerC = math.max(SteerWithCounter, _GSteerC - (SteerSpeed * SteerSmoothing * deltaTime))
			end
		end
		
		-- Steer decay multiplier
		local sDecay = (1 - math.min(vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude / (Units.Velocity_mdivs / 3.6) / (_Settings.SteerDecay / (Units.Velocity_mdivs / 3.6)), 1 - (_Settings.MinSteer / 100)))
		local rsDecay = (1 - math.min(vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude / (Units.Velocity_mdivs / 3.6) / (_Settings.RSteerDecay / (Units.Velocity_mdivs / 3.6)), 1 - (_Settings.MinSteer / 100)))

		-- Apply steering
		RSteerSpeed = WheelValues.RSteerSpeed.Value
		SteerOuter = (WheelValues.LockToLock.Value * 180) / WheelValues.SteerRatio.Value
		SteerInner = math.min(SteerOuter - (SteerOuter * (1 - WheelValues.Ackerman.Value)), SteerOuter * 1.2)
		local angle = 0
		local rsteerVariableAngle = 1
		if v.Name == "FL" or v.Name == "F" then
			angle = (_GSteerC < 0 and SteerInner or SteerOuter) * sDecay
		elseif v.Name == "FR" then
			angle = (_GSteerC < 0 and SteerOuter or SteerInner) * sDecay
		elseif v.Name == "RL" or v.Name == "R" then
			angle = (_GSteerC < 0 and WheelValues.RSteerInner.Value or WheelValues.RSteerOuter.Value) * rsDecay
		elseif v.Name == "RR" then
			angle = (_GSteerC < 0 and WheelValues.RSteerOuter.Value or WheelValues.RSteerInner.Value) * rsDecay
		end
		local FWSteer = WheelValues.FWSteer.Value
		if string.sub(v.Name, 1, 1) == "R" then
			if FWSteer == "Static" then
				rsteerVariableAngle = -math.max(0, 1 - (vehicle.DriveSeat.Velocity.Magnitude / RSteerSpeed))
			elseif FWSteer == "Speed" then
				rsteerVariableAngle = math.min(1, (vehicle.DriveSeat.Velocity.Magnitude / RSteerSpeed))
			elseif FWSteer == "Both" then
				rsteerVariableAngle = -math.max(-1, 1 - (vehicle.DriveSeat.Velocity.Magnitude / RSteerSpeed))
			end
		end
		if v.Arm:FindFirstChild("Steer") then
			if WheelValues.PowerSteeringType.Value == "New" and not WheelValues.SteerDisabled.Value then
				v.Arm.Steer.Attachment0.Orientation = Vector3.new(0, _GSteerC * angle * rsteerVariableAngle, 0)
			else
				v.Arm.Steer.CFrame = v.Base.CFrame * (WheelValues.SteerDisabled.Value and CFrame.new(0, 0, 0) or (CFrame.Angles(0, -math.rad(_GSteerC * angle * rsteerVariableAngle), 0)))
			end
		elseif v:FindFirstChild("SystemHub") then
			if v.SystemHub:FindFirstChild("Steer") then
				if WheelValues.PowerSteeringType.Value == "New" and not WheelValues.SteerDisabled.Value then
					if string.sub(v.Name, 2, 2) == "R" then
						v.SystemHub.Steer.Attachment0.Orientation = Vector3.new(0, -(_GSteerC * angle * rsteerVariableAngle) + 180, 0)
					else
						v.SystemHub.Steer.Attachment0.Orientation = Vector3.new(0, -(_GSteerC * angle * rsteerVariableAngle), 0)
					end
				else
					v.SystemHub.Steer.CFrame = v.Base.CFrame * (WheelValues.SteerDisabled.Value and CFrame.new(0, 0, 0) or (CFrame.Angles(0, -math.rad(_GSteerC * angle * rsteerVariableAngle), 0)))
				end
			end
		end
	end
	if _Settings.Lean then
		local weight = vehicle.Body["#Weight"]
		weight.LeanGyro.CFrame = _VehicleCenter * CFrame.Angles(0, 0, ((_GSteerC * _Settings.LeanProgressiveness) * (math.rad(_Settings.MaxLean) / (values.Velocity.Value.Magnitude + _Settings.LeanProgressiveness)) - (_GSteerC * math.rad(_Settings.MaxLean))))
	end
end

-- Engine
local fFD = _Settings.FinalDrive * _Settings.FDMult
local fFDr = fFD * 30 / math.pi
local wDRatio = wDia * math.pi / 60
local cfWRot = CFrame.Angles(math.pi / 2, -math.pi / 2, 0)
local cfYRot = CFrame.Angles(0, math.pi, 0)

-- Electric only setup
if not _Settings.Engine and _Settings.Electric then
	_Settings.Redline = _Settings.E_Redline
	_Settings.PeakRPM = _Settings.E_Trans2
	_Settings.Turbochargers = 0
	_Settings.Superchargers = 0
	_Settings.IdleRPM = 0
end

-- Aspiration setup
_TCount = _Settings.Turbochargers
_TPsi = _Settings.T_Boost *_Settings.Turbochargers

_SCount = _Settings.Superchargers
_SPsi = _Settings.S_Boost * _Settings.Superchargers

-- Powertrain
task.wait()

-- Automatic transmission
function Auto()
	local maxSpin = 0
	for i, v in Drive do
		if _WheelSpeeds[v.Name] > maxSpin then
			maxSpin = _WheelSpeeds[v.Name]
		end
	end
	if _IsOn then
		if _Settings.AutoShiftVers == "Old" and _CGear == 0 then
			_CGear = 1 _ClPressing = false
		end
		if _CGear >= 1 then
			if (_CGear == 1 and _InBrake > 0 and vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude < 5) and _Settings.AutoShiftVers == "Old" then
				_CGear = -1 _ClPressing = false
			elseif vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude > 5 and _Settings.ClutchType ~= "CVT" then
				if _Settings.AutoShiftMode == "RPM" then
					if _RPM>(_Settings.ShiftRPM+_Settings.AutoUpThresh) then
						if not _ShiftUp and not _Shifting then
							_ShiftUp = true
						end
					elseif math.max(math.min(maxSpin * _Settings.Ratios[_CGear + 1] * fFDr,_Settings.Redline + 100), 0) < (_Settings.ShiftRPM - _Settings.AutoDownThresh) and _CGear > 1 then
						if not _ShiftDn and not _Shifting then
							_ShiftDn = true
						end
					end
				else
					if vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude > math.ceil(wDRatio * (_Settings.ShiftRPM + _Settings.AutoUpThresh) / _CurrentRatio / fFD) then
						if not _ShiftUp and not _Shifting then
							_ShiftUp = true
						end
					elseif vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude < math.ceil(wDRatio * (_Settings.ShiftRPM-_Settings.AutoDownThresh) / _Settings.Ratios[_CGear + 1] / fFD) and _CGear > 1 then
						if not _ShiftDn and not _Shifting then
							_ShiftDn = true
						end
					end
				end
			end
		else
			if (_InThrot > 0 and vehicle.DriveSeat.AssemblyLinearVelocity.Magnitude < 5) and _Settings.AutoShiftVers == "Old" then
				_CGear = 1 _ClPressing = false
			end
		end
	end
end

function Gear()
	local maxSpin = 0
	for i, v in (Drive) do
		if _WheelSpeeds[v.Name] > maxSpin then
			maxSpin = _WheelSpeeds[v.Name]
		end
	end
	if _ShiftUp and not _Shifting then
		if (_TMode == "Manual" and not _ClPressing) or (_TMode == "Manual" and _Settings.ClutchRel and (_InThrot > 0)) or _CGear == #_Settings.Ratios - 2 or (_TMode ~= "Manual" and not _IsOn) then
			_ShiftUp = false
			return
		end
		local NextGear = math.min(_CGear + 3, #_Settings.Ratios)
		if _TMode ~= "Manual" and _Settings.ClutchType ~= "CVT" then
			_Shifting = true
			if _CGear > 0 then
				if _Settings.AutoShiftType == "DCT" then
					task.wait(_Settings.ShiftUpTime)
				elseif _Settings.AutoShiftType == "Rev" then
					repeat RunService.Heartbeat:Wait() until _RPM <= math.max(math.min(maxSpin * _Settings.Ratios[NextGear] * fFDr, _Settings.Redline - _Settings.RevBounce), _Settings.IdleRPM) or not _IsOn or _ShiftDn 
				end
			end
		end
		_ShiftUp = false
		_Shifting = false
		if _TMode ~= "Manual" and not _IsOn then
			return
		end
		if NextGear >= 4 and _Settings.ClutchType == "CVT" then
			return
		end -- make sure it cannot go past 1st gear
		_CGear = math.min(_CGear + 1,#_Settings.Ratios - 2)
		if _TMode ~= "Manual" or (_TMode == "Manual" and _CGear == 1) and _IsOn then
			_ClPressing = false
		end
	end
	if _ShiftDn and not _Shifting then
		if (_TMode == "Manual" and not _ClPressing) or _CGear == -1 or (_TMode ~= "Manual" and not _IsOn) then
			_ShiftDn = false return
		end
		local PrevGear = math.min(_CGear + 1, #_Settings.Ratios)
		if _TMode ~= "Manual" then
			_Shifting = true
			if _CGear > 1 then
				if _Settings.AutoShiftType == "DCT" then
					task.wait(_Settings.ShiftDnTime)
				elseif _Settings.AutoShiftType == "Rev" then
					repeat RunService.Heartbeat:Wait() until _RPM <= math.max(math.min(maxSpin * _Settings.Ratios[PrevGear] * fFDr, _Settings.Redline - _Settings.RevBounce), _Settings.IdleRPM) or not _IsOn or _ShiftDn 
				end
			end
		end
		_ShiftDn = false
		_Shifting = false
		if _TMode ~= "Manual" and not _IsOn then
			return
		end
		_CGear = math.max(_CGear -1, -1)
		if _TMode ~= "Manual" or (_TMode == "Manual" and _CGear == -1) and _IsOn then
			_ClPressing = false
		end
	end
end

local _GoalRPM = 0
local tqTCS = 1
local _StallOK = false
local ticc = tick()

-- Apply power
function Engine(dt)
	local deltaTime = (60 / (1 / dt))
	-- Average rotational speed calculation
	local cwspeed = 0
	local fwspeed = 0
	local fwcount = 0
	local mwspeed = 0
	local mwcount = 0
	local rwspeed = 0
	local rwcount = 0
	for i, v in next, (vehicle.Wheels:GetChildren()) do
		if string.sub(v.Name, 1, 1) == "F" then
			fwspeed = fwspeed + _WheelSpeeds[v.Name]
			fwcount = fwcount + 1
		elseif string.sub(v.Name, 1, 1) == "M" then
			mwspeed = mwspeed + _WheelSpeeds[v.Name]
			mwcount = mwcount + 1
			cwspeed = (fwspeed + mwspeed + rwspeed) / 3
		elseif string.sub(v.Name, 1, 1) == "R" then
			rwspeed = rwspeed + _WheelSpeeds[v.Name]
			rwcount = rwcount + 1
			cwspeed = (fwspeed + rwspeed) / 2
		end
	end
	fwspeed = fwspeed / fwcount
	mwspeed = mwspeed / mwcount
	rwspeed = rwspeed / rwcount

	local maxSpin = 0
	local maxCount = 0
	local revThrot = _GThrot
	for i, v in next, (Drive) do maxSpin = maxSpin + _WheelSpeeds[v.Name] maxCount = maxCount + 1 end
	maxSpin = maxSpin / maxCount
	local _WheelRPM = maxSpin * _CurrentRatio * fFDr

	-- CVT
	if _Settings.ClutchType == "CVT" then
		_CVTRatio = math.clamp((_Settings.CVTRPM * _GThrot) / (maxSpin * fFDr), _Settings.CVTMinRatio, _Settings.CVTMaxRatio)
		if _CVTFakeShifting then
			if values.RPM.Value >= _CVTFakeShiftingStartRPM and values.Gear.Value > 0 then
				values.FakeShift.Value = true
				task.wait(_CVTFakeShiftingDropDelay)
				_GThrot = 0
				if _CVTFakeShiftingUseClutch then
					_Clutch = 1
					_ClPressing = true
				end
				task.wait(_CVTFakeShiftingShiftTime)
			elseif values.RPM.Value <= _CVTFakeShiftingDropRPM and values.Gear.Value > 0 then
				values.FakeShift.Value = false
			end
		end
	end

	-- Update ratio
	_CurrentRatio = _Settings.ClutchType == "CVT" and _CVTRatio or _Settings.Ratios[_CGear + 2]
	_spLimit = _Settings.Redline / (fFDr * _CurrentRatio)
	if _CurrentRatio * fFDr == 0 then
		_spLimit = 0
	end -- Prevents [nan] from dividing by 0

	-- Neutral Gear
	if ((_CGear == 0 or _Shifting) and _IsOn) then
		_ClPressing = true
		_Clutch = 1
	end

	-- Flywheel / clutch-dumping
	_FlywheelEnergy = math.max((_RPM - _WheelRPM) * _Settings.DumpMult, 0) * (1 - _Clutch) * 1.356 * Units.Torque_nm
	-- Determine RPM
	local revMin = 1
	local goalMin = 1
	local goalMax = _Settings.Redline + 100
	if _Settings.Stall and _Settings.Clutch then
		revMin = 0
	end

	if _Shifting and _ShiftUp then
		_GThrot = _Settings.IdleThrottle / 1000
	elseif _Shifting and _ShiftDn then
		_GThrot = (_Settings.ShiftThrot / 100)
	else
		if (_Settings.AutoShiftVers == "Old" and _CGear == -1 and _TMode == "Auto") then
			_GThrot = _InBrake
		else
			_GThrot = math.max(_InThrot, _Settings.IdleThrottle / 1000)
		end
	end
	if (_Settings.AutoShiftVers == "Old" and _CGear == -1 and _TMode == "Auto") then
		_GBrake = _InThrot
	else
		_GBrake = _InBrake
	end

	if not _IsOn then
		ticc = tick()
		_Clutch = 1
		if not values.Starting.Value then
			_GThrot = 0
		end
	end
	if ((_ClPressing and _CGear == 0) or (_PlayerClutch and _CGear ~= 0)) and _Settings.NeutralLimit then
		if (_CGear == 0 and not _Settings.LimitClutch) or _Settings.LimitClutch then
			goalMax = _Settings.NeutralRevRPM
		end
	end

	-- Rev limiter / speed limiter
	if _RPM >= _Settings.Redline and not _Settings.OverRev then
		revLimiting = true
	elseif _RPM < _Settings.Redline - _Settings.RevBounce then
		revLimiting = false
	end
	if revLimiting then
		_GThrot = _Settings.IdleThrottle / 1000
	end
	local limit = (_CGear < 0 and _Settings.ReverseSpeed or _Settings.SpeedLimit)
	if limit > 0 then
		_GThrot = math.min(_GThrot, math.max(1 - math.clamp(((values.Velocity.Value.Magnitude / (Units.Velocity_mdivs / 3.6)) - (limit - _Settings.SLimitGradient)) / _Settings.SLimitGradient, 0, 1), _Settings.IdleThrottle / 1000))
		if _Settings.SLimitBrake then
			_GBrake = math.max(_GBrake, math.clamp((values.Velocity.Value.Magnitude / (Units.Velocity_mdivs / 3.6) - limit) / _Settings.SLimitGradient, 0, 1))
		end
	end

	if _RPM <= (_Settings.IdleRPM / 4) and _StallOK and (tick() - ticc >= .2) and _Settings.Stall then
		script.Parent.Values.IsOn.Value = false
	end

	-- Idle
	if _RPM <= _Settings.IdleRPM and _IsOn then
		_GThrot = math.max(_GThrot, math.clamp((_Settings.IdleRPM - _RPM) / 400, 0, 1))
		if _Settings.Creep then
			_GThrot = _GThrot + (_Settings.IdleThrottle / 10)
		end
	end
	if (_Settings.Engine or _Settings.Electric) and not (values.Starting.Value) then
		_GoalRPM = math.clamp(_RPM - (_Settings.RevDecay * deltaTime) + (_Settings.RevAccel * revThrot * deltaTime) - (math.clamp(math.max(_RPM - _Settings.IdleRPM, 0) / math.max(_Settings.Redline - _Settings.IdleRPM, 1), 0, 1) * _Settings.RevDecayRPM * deltaTime), goalMin, goalMax)
	end

	-- Starting
	if values.Starting.Value then
		if _RPM > _Settings.StartRPM then
			ison.Value = true
			values.Starting.Value = false
			_GThrot = 0
		else
			_GoalRPM += _Settings.StartRPMAccel
			_GThrot = 1
		end
	end

	if _Settings.Clutch then
		if values.AutoClutch.Value then
			if _Settings.ClutchType == "Clutch" or _Settings.ClutchType == "CVT" then
				if _ClPressing then
					_ClutchKick = 1
				end
				_ClutchKick = _ClutchKick * (_Settings.ClutchEngage / 100)
				local ClRPMInfluence = math.max(_RPM * _Settings.ClutchRPMMult / _Settings.Redline, 0)
				if _Settings.ClutchMode == "New" then
					ClRPMInfluence = 0
				end
				_ClutchModulate = math.min(((((values.Velocity.Value.Magnitude / (Units.Velocity_mdivs / 3.6) / _Settings.SpeedEngage) / math.abs(_CGear)) + ClRPMInfluence) - _ClutchKick), 1)
			elseif _Settings.ClutchType == "TorqueConverter" and _Settings.TQLock then
				if (_GThrot <= _Settings.IdleThrottle / 1000 and values.Velocity.Value.Magnitude / (Units.Velocity_mdivs / 3.6) < _Settings.SpeedEngage) or (_GThrot > _Settings.IdleThrottle / 1000 and (_RPM < _Settings.RPMEngage and _WheelRPM < _Settings.RPMEngage)) then
					_ClutchModulate = math.min(_ClutchModulate * (_Settings.ClutchEngage / 100), 1)
				else
					_ClutchModulate = math.min(_ClutchModulate * (_Settings.ClutchEngage / 100) + (1 - (_Settings.ClutchEngage / 100)), 1)
				end
			elseif _Settings.ClutchType == "TorqueConverter" and not _Settings.TQLock then
				_ClutchModulate = math.min((_RPM / _Settings.Redline) * .7, 1)
			end
			if not _ClPressing then
				_Clutch = math.min(1 - _ClutchModulate,1)
			else
				_Clutch = 1
			end
			_StallOK = (_Clutch <= .01) or _StallOK
		else
			if _ClPressing then
				_Clutch = 1
			else
				_Clutch = 0
			end
		end
		_StallOK = (_Clutch <= .01) or _StallOK
	else
		_StallOK = false
		if not _ClPressing and not _Shifting then
			_Clutch = 0
		else
			_Clutch = 1
		end
	end

	-- Things that apply the clutch
	if values.AutoClutch.Value and (values.Starting.Value or (revLimiting and not _Settings.OverRev)) then
		_Clutch = 1
	end

	local aRPM = math.max(math.min((_GoalRPM * _Clutch) + (_WheelRPM * (1 - _Clutch)), _Settings.Redline + 100), revMin)
	local clutchP = math.min(math.abs(aRPM - _RPM) / ((_Settings.Flywheel) * deltaTime), .9)
	if _ClPressing then
		clutchP = 0
	end
	_RPM = _RPM * clutchP + aRPM * (1 - clutchP)
	if _RPM > goalMax then
		_RPM = goalMax
	elseif _RPM < goalMin then
		_RPM = goalMin
	end
	_RPM = math.clamp(_RPM, 0, _Settings.Redline)

	if _RPM <= (_Settings.IdleRPM / 4) and _StallOK and (tick() - ticc >= .2) then
		ison.Value = not _Settings.Stall
	end
	-- Aspiration
	local TPsi = _TPsi / _TCount

	local _BThrot = _GThrot
	local _DThrot = _Settings.IdleThrottle / 1000

	if _GThrot > _SuperSpoolValue and _Settings.Engine and _Settings.Superchargers > 0 then
		if _BThrot <= _DThrot then
			_SuperSpoolValue = min(_SuperSpoolValue + _Settings.S_Sensitivity, _GThrot)
		end
	else
		if _BThrot <= _DThrot then
			_SuperSpoolValue = max(_SuperSpoolValue - _Settings.S_Sensitivity, _GThrot)
		end
	end
	-- Torque calculations
	local x = _RPM / 1000
	if _Settings.Engine then
		_NT = 100 * (boolToNum[_Settings.Engine] * max(_Settings.Torque * .7375621493 / 100 - (_Settings.ValveFloatSharpness ^ (x - _Settings.ValveSprings) + _Settings.LowPerfSpread ^ (x - _Settings.LowPerf)) + (_Settings.HighPerf / 10 * x + max(-(1 - _Settings.VVLSharpness)^(x - _Settings.VVLTime) + _Settings.VVLValue, 0)) + (math.clamp(_Settings.Roughness * math.sin(250 * x * tick()) / math.max(100 * x, 1), -_Settings.Roughness, _Settings.Roughness)), 0)) * (_RPM < 10 and 0 or 1)
		_NH = (_NT * x / (_Settings.EqPoint / 1000))
		if _Settings.Turbochargers ~= 0 then
			local minBoost = _Settings.T_MinBoost / 100 * _Settings.T_Boost * 14.503773773 * _Settings.Turbochargers
			if not _IsOn then
				minBoost = 0 
			end
			_TBoostGoal = math.max(_GThrot ^ _Settings.T_SpoolFactor * min(max((max(_Settings.ExhaustPressure * (_NH / 100) - _Settings.T_SpoolTimeOffset, 0) ^ _Settings.T_ExPressFactor) + (_Settings.T_ExPressInf * (_Settings.ExhaustPressure * (_NH / 100))), 0), _Settings.Turbochargers * (_Settings.T_Boost * 14.503773773 + max(_Settings.ExhaustPressure * (_NH / 100 ) - _Settings.T_WGMaxPress, 0))), minBoost)
			if _TBoostGoal > _TBoost then
				_TBoost = math.max(math.min(_TBoost + _Settings.T_SpoolIncrease * _GThrot, _TBoostGoal), minBoost)
			elseif _TBoost > _TBoostGoal then
				_TBoost = math.max(math.max(_TBoost * _Settings.T_SpoolDecrease, _TBoostGoal), minBoost)
			end
			_TT = max(100 * _Settings.T_Efficiency * _TBoost, 0)
			_TH = (_TT * x / (_Settings.EqPoint / 1000))
		else
			_TH,_TT = 0, 0
		end
		if _Settings.Superchargers ~= 0 then
			_SBoost = _SuperSpoolValue * _Settings.Superchargers * max(((_Settings.S_Boost * 6) * 14.503773773) * x - _Settings.S_HighPerf ^ x + ((_Settings.S_Boost * 6) * 14.503773773), 0)
			_ST = 100 * (_Settings.S_Efficiency * _SBoost)
			_SH = (_ST * x / (_Settings.EqPoint / 1000))
		else
			_SH,_ST = 0, 0
		end
		_BH = _TH + _SH
		_BT = _TT + _ST
	else
		_NH,_NT = 0, 0
		_TH,_TT = 0, 0
		_SH,_ST = 0, 0
		_BH,_BT = 0, 0
	end
	if _Settings.Electric and _CGear ~= 0 then
		_ET = max(100 * (boolToNum[_Settings.Electric] * (_Settings.E_Torque * .7375621493 / 100 - max(_Settings.E_DropSlope * x - _Settings.E_DropSlope * (_Settings.E_TorqueDropRPM / 1000), 0) + _Settings.E_TorqueDropCurve * min(_Settings.E_TorqueDropSpread ^ (x - _Settings.E_TorqueDropRPM / 1000) - 1, 0))), 0)
		_EH = (_ET * x / (_Settings.EqPoint / 1000))
	else
		_EH, _ET = 0, 0
	end

	-- Update wheels
	for i, v in next, (vehicle.Wheels:GetChildren()) do
		local WheelValues = v.Values

		local DiffPower = WheelValues.DiffPower.Value
		local DiffCoast = WheelValues.DiffCoast.Value
		local DiffPreload = WheelValues.DiffPreload.Value
		local CDiffSlipThres = WheelValues.CDiffSlipThres.Value
		local CDiffLockThres = WheelValues.CDiffLockThres.Value
		local BrakeForce = WheelValues.BrakeForce.Value * 9.80665 * Units.Force_N -- conversion to SI unit
		local PBrakeForce = WheelValues.PBrakeForce.Value * 9.80665 * Units.Force_N -- conversion to SI unit
		local FBrakeForce = 80 * 9.80665 * Units.Force_N -- conversion to SI unit
		local EBrakeForce = WheelValues.EBrakeForce.Value * 9.80665 * Units.Force_N -- conversion to SI unit
		local FReverseForce = 5 * 9.80665 * Units.Force_N -- conversion to SI unit

		-- Reference wheel orientation
		local Ref = (CFrame.new(v.Position - ((v.Arm.CFrame * cfWRot).lookVector), v.Position) * cfYRot).lookVector
		local aRef = 1
		local diffMult = 1
		local RRdiffMult = 1
		local RLdiffMult = 1
		local MRdiffMult = 1
		local MLdiffMult = 1
		local FRdiffMult = 1
		local FLdiffMult = 1

		if WheelValues.HorsePowerLimitOverride.Value then
			HPLimit = WheelValues.HorsePowerLimitOverrideSet.Value
		else
			HPLimit = _Settings.HorsepowerLimit
		end

		if WheelValues.EngineDisabled.Value then
			_NT = 0
			_BT = 0
		elseif WheelValues.ElectricDisabled.Value then
			_ET = 0
		end

		_OutTorque = math.clamp(min((_NT + _BT) + _ET, HPLimit > 0 and HPLimit * (_Settings.EqPoint / 1000 / x) or math.huge), 0, 1e6)
		_HP = _OutTorque * x / (_Settings.EqPoint / 1000)
		_OutTorque *= _CurrentRatio * fFD
		
		if v.Name == "FL" or v.Name == "RL" or v.Name == "ML" then
			aRef = -1
		end
		-- Differential / torque-vectoring
		if WheelValues.DifferentialType.Value == "New" then
			if v.Name == "FR" then
				local avg = ((_WheelSpeeds[v.Name] / _WheelSpeeds["FL"]) - 1) * (DiffPreload / 10)
				FRdiffMult = math.ceil(math.max(0, math.min(2, 1 - (((DiffPower / 100) * avg * _GThrot) + ((DiffCoast / 100) * avg * (1 - _GThrot))))) * 100) / 100
				FLdiffMult = 2 - FRdiffMult
			elseif v.Name == "FL" then
				local avg = ((_WheelSpeeds[v.Name] / _WheelSpeeds["FR"]) - 1) * (DiffPreload / 10)
				FLdiffMult = math.ceil(math.max(0, math.min(2, 1 - (((DiffPower / 100) * avg * _GThrot) + ((DiffCoast / 100) * avg * (1 - _GThrot))))) * 100) / 100
				FRdiffMult = 2 - FLdiffMult
			elseif v.Name == "RR" then
				local avg = ((_WheelSpeeds[v.Name] / _WheelSpeeds["RL"]) - 1) * (DiffPreload / 10)
				RRdiffMult = math.ceil(math.max(0, math.min(2, 1 - (((DiffPower / 100) * avg * _GThrot) + ((DiffCoast / 100) * avg * (1 - _GThrot))))) * 100) / 100
				RLdiffMult = 2 - RRdiffMult
			elseif v.Name == "RL" then
				local avg = ((_WheelSpeeds[v.Name] / _WheelSpeeds["RR"]) - 1) * (DiffPreload / 10)
				RLdiffMult = math.ceil(math.max(0, math.min(2, 1 - (((DiffPower / 100) * avg * _GThrot) + ((DiffCoast / 100) * avg * (1 - _GThrot))))) * 100) / 100
				RRdiffMult = 2 - RLdiffMult
			elseif v.Name == "ML" then
				local avg = ((_WheelSpeeds[v.Name] / _WheelSpeeds["MR"]) - 1) * (DiffPreload / 10)
				MLdiffMult = math.ceil(math.max(0, math.min(2, 1 - (((DiffPower / 100) * avg * _GThrot) + ((DiffCoast / 100) * avg * (1 - _GThrot))))) * 100) / 100
				MRdiffMult = 2 - MLdiffMult
			elseif v.Name == "MR" then
				local avg = ((_WheelSpeeds[v.Name] / _WheelSpeeds["ML"]) - 1) * (DiffPreload / 10)
				MRdiffMult = math.ceil(math.max(0, math.min(2, 1 - (((DiffPower / 100) * avg * _GThrot) + ((DiffCoast / 100) * avg * (1 - _GThrot))))) * 100) / 100
				MLdiffMult = 2 - MRdiffMult
			end
		elseif WheelValues.DifferentialType.Value == "Old" then
			if v.Name=="FL" or v.Name=="FR" then
				diffMult = math.max(0, math.min(1, 1 + ((((v.RotVelocity.Magnitude - fwspeed) / fwspeed) / (math.max(WheelValues.DiffSlipThres.Value, 1) / 100)) * ((WheelValues.DiffLockThres.Value - 50) / 50))))
				if _Settings.Config == "AWD" then
					diffMult = math.max(0, math.min(1, diffMult * (1 + ((((fwspeed - cwspeed) / cwspeed) / (math.max(WheelValues.CDiffSlipThres.Value, 1) / 100)) * ((CDiffLockThres - 50) / 50)))))
				end
			elseif v.Name=="RL" or v.Name=="RR" then
				diffMult = math.max(0, math.min(1, 1 + ((((v.RotVelocity.Magnitude - rwspeed) / rwspeed) / (math.max(WheelValues.DiffSlipThres.Value, 1) / 100)) * ((WheelValues.DiffLockThres.Value - 50) / 50))))
				if _Settings.Config == "AWD" then
					diffMult = math.max(0, math.min(1, diffMult * (1 + ((((rwspeed - cwspeed) / cwspeed) / (math.max(WheelValues.CDiffSlipThres.Value, 1) / 100)) * ((CDiffLockThres - 50) / 50)))))
				end
			elseif v.Name=="ML" or v.Name=="MR" then
				diffMult = math.max(0, math.min(1, 1 + ((((v.RotVelocity.Magnitude - mwspeed) / mwspeed) / (math.max(WheelValues.DiffSlipThres.Value, 1) / 100)) * ((WheelValues.DiffLockThres.Value - 50) / 50))))
				if _Settings.Config == "AWD" then
					diffMult = math.max(0, math.min(1, diffMult * (1 + ((((mwspeed - cwspeed) / cwspeed) / (math.max(WheelValues.CDiffSlipThres.Value, 1) / 100)) * ((CDiffLockThres - 50) / 50)))))
				end
			end
		end
		-- Output
		-- Apply power
		local on = 1
		if not ison.Value then
			on = 0
		end
		local throt = _GThrot
		local brake = _GBrake
		local clutch = 1
		if _ClPressing or (values.AutoClutch.Value and values.Starting.Value) then
			clutch = 0
		end
		if _RPM < _Settings.IdleRPM then
			clutch = 0
		end
		local tq = (_OutTorque + _FlywheelEnergy) / #Drive

		-- Apply ESC
		local tqESC = 0
		local diff = 0
		if not (v.Name == "F" or v.Name == "M" or v.Name == "R") and _ESC and not (_CGear == -1 and not WheelValues.ESCReverse.Value) then
			local g = (vehicle.Body["#Weight"].CFrame:VectorToObjectSpace(values.Acceleration.Value / (Units.Velocity_mdivs) / ((workspace.Gravity) * (Units.Length_mm / 1000))))
			if WheelValues.ESCGyroscope.Value then
				diff = (_GSteerC - (g.X * -math.sign(_VehicleCenter:VectorToObjectSpace(values.Velocity.Value).Z)))
			else
				diff = (_GSteerC - (-math.sign(_VehicleCenter:VectorToObjectSpace(values.Velocity.Value).Z)))
			end
			if (math.abs(diff) > WheelValues.ESCThreshold.Value) and (values.Velocity.Value.Magnitude / (Units.Velocity_mdivs / 3.6)) > WheelValues.ESCSpeed.Value and (math.sign(_GSteerC) ~= math.sign(g.X)) then
				local escVector, escBias = 1, (WheelValues.ESCVector.Value + 1)
				if string.find(v.Name, "F") then
					escVector = escVector * (2 - escBias)
				elseif string.find(v.Name, "R" or "M") then
					escVector = escVector * escBias
				end
				tqESC = (string.find(v.Name, "L") and 1 or -1) * math.sign(diff) * escVector
				throt = throt + (math.max(tqESC, 0) - throt) * (WheelValues.ESCThrottle.Value / 100)
				brake = brake + (-math.min(tqESC, 0) - brake) * (WheelValues.ESCBrake.Value / 100)
			end
		end
		if tqESC ~= 0 then
			_ESCActive = true
		end
		_ESCTracker[v.Name] = tqESC

		-- Apply ABS
		local tqABS = 1
		if _ABS and brake > 0 and math.abs(v.RotVelocity.Magnitude * (v.Size.Y / 2) / (Units.Velocity_mdivs / 3.6) - v.Velocity.Magnitude/(Units.Velocity_mdivs / 3.6)) - WheelValues.ABSThreshold.Value > 0 then
			tqABS = math.max(0, WheelValues.ABSLimit.Value / 100)
		end
		if tqABS < 1 then
			_ABSActive = true
		end
		_ABSAmt += tqABS
		_ABSTracker[v.Name] = 1 - tqABS

		local PBrakeV = 0
		local FBrakeV = 0

		if _PBrake then
			PBrakeV = 1
		else 
			PBrakeV = 0
		end
		if _FBrake then
			FBrakeV = 1
		else 
			FBrakeV = 0
		end

		local driven = false
		for _, a in next, (Drive) do
			if a == v then
				driven = true
			end
		end
		if driven then
			-- Apply AWD Vectoring
			if _Settings.Config == "AWD" then
				local bias = (_Settings.TorqueVector + 1)
				if string.find(v.Name, "F") then
					tq = tq * (2 - bias)
				elseif string.find(v.Name, "M") then
					tq = tq * (1 - bias)
				else
					tq = tq * bias
				end
			end
			-- Apply TCS
			tqTCS = 1
			if _TCS and throt > _Settings.IdleThrottle / 1000 then
				tqTCS = 1 - (math.min(math.max(0, math.abs(v.RotVelocity.Magnitude * (v.Size.Y / 2) / (Units.Velocity_mdivs / 3.6) - v.Velocity.Magnitude / (Units.Velocity_mdivs / 3.6)) - WheelValues.TCSThreshold.Value) / WheelValues.TCSGradient.Value, 1) * (1 - (WheelValues.TCSLimit.Value / 100)))
			end
			if tqTCS < 1 then
				_TCSActive = true
			end
			_TCSTracker[v.Name] = 1 - tqTCS

			-- Update Forces
			local dir = 1
			if _Settings.FReverse then
				_FReverse = 0
			end
			
			if _CGear == -1 then
				dir = -1
				if _Settings.FReverse then
					_FReverse = 1
				end
			end

			local tqOUT = tq * 1.356 * Units.Torque_nm * (60 / workspace:GetRealPhysicsFPS()) * throt * tqTCS * on * clutch
			if tqOUT < 0 then
				tqOUT = 0
			elseif tqOUT > 1000000 then
				tqOUT = 0
			end
			-- Convert lb-ft to nm to Roblox stuff
			-- if it reaches an absurdly high number, set it to 0 to prevent physics death
			if v.Name == "RR" then
				v["#AV"].MotorMaxTorque = tqOUT * RRdiffMult * diffMult + (((FReverseForce / WheelCount) * _FReverse))
			elseif v.Name == "RL" then
				v["#AV"].MotorMaxTorque = tqOUT * RLdiffMult * diffMult + (((FReverseForce / WheelCount) * _FReverse))
			elseif v.Name == "FR" then
				v["#AV"].MotorMaxTorque = tqOUT * FRdiffMult * diffMult + (((FReverseForce / WheelCount) * _FReverse))
			elseif v.Name == "FL" then
				v["#AV"].MotorMaxTorque = tqOUT * FLdiffMult * diffMult + (((FReverseForce / WheelCount) * _FReverse))
			elseif v.Name == "ML" then
				v["#AV"].MotorMaxTorque = tqOUT * MLdiffMult * diffMult + (((FReverseForce / WheelCount) * _FReverse))
			elseif v.Name == "MR" then
				v["#AV"].MotorMaxTorque = tqOUT * MRdiffMult * diffMult + (((FReverseForce / WheelCount) * _FReverse))
			else
				v["#AV"].MotorMaxTorque = tqOUT * diffMult + (((FReverseForce / WheelCount) * _FReverse))
			end
			if not _Settings.FReverse then
				v["#AV"].AngularVelocity = _spLimit * dir
			else
				v["#AV"].AngularVelocity = _spLimit + (((FReverseForce / WheelCount) * _FReverse)) * dir
			end
			v["#BV"].MotorMaxTorque = (BrakeForce * (60 / workspace:GetRealPhysicsFPS()) * brake * tqABS) + (EBrakeForce * ((1 - throt) * (_RPM / _Settings.Redline))) + (PBrakeForce * PBrakeV) + ((FBrakeForce / WheelCount) * FBrakeV)
		else
			v["#AV"].MotorMaxTorque = (((FReverseForce / WheelCount) * _FReverse))
			v["#AV"].AngularVelocity = (((FReverseForce / WheelCount) * _FReverse)) * -_FReverse
			v["#BV"].MotorMaxTorque = (BrakeForce * (60 / workspace:GetRealPhysicsFPS()) * brake * tqABS) + (PBrakeForce * PBrakeV) + ((FBrakeForce / WheelCount) * FBrakeV)
		end
		function Progressive() -- Runtime loop
			if WheelValues.ProgressiveSprings.Value then
				local spring = v:FindFirstChild("SuspensionGeometries") and v.SuspensionGeometries:FindFirstChild("SuspensionGeometry") and v.SuspensionGeometries.SuspensionGeometry:FindFirstChild("Constraints") and v.SuspensionGeometries.SuspensionGeometry.Constraints:FindFirstChild("Spring") or v:FindFirstChild("Spring")
				if not spring then
				end
				spring.Stiffness = (WheelValues.MinStiffness.Value + (WheelValues.MaxStiffness.Value - WheelValues.MinStiffness.Value) * ((WheelValues.SusLength.Value - spring.CurrentLength) / WheelValues.CompressLim.Value)) * 9806.65 * Units.Stiffness_Ndivm
				spring.Damping = (WheelValues.MinSusDamping.Value + (WheelValues.MaxSusDamping.Value - WheelValues.MinSusDamping.Value) * ((WheelValues.SusLength.Value - spring.CurrentLength) / WheelValues.CompressLim.Value)) * Units.Stiffness_Ndivm
			end
		end
	end
end

function Eject()
	if vehicle.DriveSeat.CFrame.upVector.Y < .3 then
		vehicle.DriveSeat.SeatWeld:Destroy()
	end
end

-- Wheel output values
function WheelOutput(dt)
	_TCSAmt = 0
	_ABSAmt = 0
	_ESCAmt = 0
	local tcsCount = 0
	local absCount = 0
	local escCount = 0
	local rot = 0
	for _, wheel in Wheels do
		-- Wheel speeds
		if not _WheelSpeedsTable[wheel.Name] then
			_WheelSpeedsTable[wheel.Name] = {}
		end
		table.insert(_WheelSpeedsTable[wheel.Name], wheel.RotVelocity.Magnitude)
		if #_WheelSpeedsTable[wheel.Name] > 8 then
			table.remove(_WheelSpeedsTable[wheel.Name], 1)
		end
		local avg = 0
		for _, a in _WheelSpeedsTable[wheel.Name] do
			avg += a
		end
		avg /= #_WheelSpeedsTable[wheel.Name]
		_WheelSpeeds[wheel.Name] = avg

		-- Output wheel speeds
		if not values.WheelSpeeds:FindFirstChild(wheel.Name) then
			Instance.new("NumberValue", values.WheelSpeeds).Name = wheel.Name
		end
		values.WheelSpeeds[wheel.Name].Value = _WheelSpeeds[wheel.Name] -- I'm not using the avg variable here for future-proofing if we change the calculation later and stuff
		rot += _WheelSpeeds[wheel.Name] * (wheel.Size.Y / 2)
		-- TCS
		if _TCSTracker[wheel.Name] then
			if not values.TCSTracker:FindFirstChild(wheel.Name) then
				Instance.new("NumberValue", values.TCSTracker).Name = wheel.Name
			end
			values.TCSTracker[wheel.Name].Value = _TCSTracker[wheel.Name]
			_TCSAmt += _TCSTracker[wheel.Name]
			tcsCount += 1
		end
		-- ABS
		if _ABSTracker[wheel.Name] then
			if not values.ABSTracker:FindFirstChild(wheel.Name) then
				Instance.new("NumberValue", values.ABSTracker).Name = wheel.Name
			end
			values.ABSTracker[wheel.Name].Value = _ABSTracker[wheel.Name]
			_ABSAmt += _ABSTracker[wheel.Name]
			absCount += 1
		end
		-- ESC
		if _ESCTracker[wheel.Name] then
			if not values.ESCTracker:FindFirstChild(wheel.Name) then
				Instance.new("NumberValue", values.ESCTracker).Name = wheel.Name
			end
			values.ESCTracker[wheel.Name].Value = _ESCTracker[wheel.Name]
			_ESCAmt += math.abs(_ESCTracker[wheel.Name])
			escCount += 1
		end
	end
	-- Wheel speeds
	_AvgWheelSpeed = rot / #Wheels
	_Acceleration = (vehicle.DriveSeat.AssemblyLinearVelocity - _OldVelocity) * (1 / dt)
	_OldVelocity = vehicle.DriveSeat.AssemblyLinearVelocity
	-- TCS
	_TCSAmt /= tcsCount
	_TCSActive = false
	-- ABS
	_ABSAmt /= absCount
	_ABSActive = false
	-- ESC
	_ESCAmt /= escCount
	_ESCActive = false
end

-- Flip
function Flip()
	-- Detect orientation
	if (vehicle.DriveSeat.CFrame * CFrame.Angles(math.pi / 2 , 0, 0)).lookVector.y > .1 or FlipDB then
		FlipWait = tick()
		-- Apply flip
	else
		if tick() - FlipWait >= 3 then
			local FlipDB = true
			local gyro = vehicle.DriveSeat.Base.Flip
			gyro.maxTorque = Vector3.new(10000, 0, 10000)
			gyro.P = 3000
			gyro.D = 500
			task.wait(1)
			gyro.maxTorque = Vector3.new(0, 0, 0)
			gyro.P = 0
			gyro.D = 0
			local FlipDB = false
		end
	end
end

--Print version
print(nam .." " ..ver)

--Runtime loops
RunService.Heartbeat:connect(function(dt)
	--Set dt
	if dt <= 0 then
		dt = 1 / 60
	end
	-- Update internal values
	_TCSAmt = #Drive
	_ABSAmt = #vehicle.Wheels:GetChildren()
	_TCSActive = false
	_ABSActive = false
	_IsOn = ison.Value
	_LastInputWasGamepad = string.find(UserInputService:GetLastInputType().Name, "Gamepad") and true or false
	_VehicleCenter = GetVehicleCenter()

	-- Update external values
	values.Gear.Value = _CGear
	values.RPM.Value = _RPM
	values.Boost.Value = _TBoost + _SBoost
	values.BoostTurbo.Value = _TBoost
	values.BoostSuper.Value = _SBoost
	values.HpNatural.Value = _NH
	values.HpElectric.Value = _EH
	values.HpTurbo.Value = _TH
	values.HpSuper.Value = _SH
	values.HpBoosted.Value = _BH
	values.Horsepower.Value = _HP
	values.TqNatural.Value = _NT
	values.TqElectric.Value = _ET
	values.TqTurbo.Value = _TT
	values.TqSuper.Value = _ST
	values.TqBoosted.Value = _BT
	values.Torque.Value = min((_NT + _BT) + _ET, math.clamp(min(_NT + _BT + _ET, _Settings.HorsepowerLimit > 0 and _Settings.HorsepowerLimit * (_Settings.EqPoint / 1000 / (_RPM / 1000)) or math.huge), 0, 1e6))
	values.TransmissionMode.Value = _TMode
	values.Throttle.Value = _GThrot
	values.Brake.Value = _GBrake
	values.InputThrottle.Value = _IThrot
	if _IThrot > 0 then
		values.InputThrottleBool.Value = true
	else
		values.InputThrottleBool.Value = false
	end
	values.InputBrake.Value = _IBrake
	if _IBrake > 0 then
		values.InputBrakeBool.Value = true
	else
		values.InputBrakeBool.Value = false
	end
	values.InputClutch.Value = _ClPressing
	if values.AutoClutch.Value then
		values.Clutch.Value = _Clutch
	end
	values.SteerC.Value = _GSteerC
	values.SteerT.Value = _GSteerT
	values.PBrake.Value = _PBrake
	if vehicle.DriveSeat.Velocity.Magnitude > (10 * .994193907579735) then
		values.FBrake.Value = false
	else
		values.FBrake.Value = _FBrake
	end
	values.TCS.Value = _TCS
	values.TCSActive.Value = _TCSActive
	values.TCSAmt.Value = 2 - (_TCSAmt / #Drive)
	values.ESC.Value = _ESC
	values.ESCActive.Value = _ESCActive
	values.ESCAmt.Value = _ESCAmt
	values.ABS.Value = _ABS
	values.ABSAmt.Value = 2 - (_ABSAmt / #vehicle.Wheels:GetChildren())
	values.ABSActive.Value = _ABSActive
	values.CS.Value = _CS
	values.CSActive.Value = _CSActive
	values.CSAmt.Value = _CSAmt
	values.MouseSteerOn.Value = _MSteer
	values.Velocity.Value = vehicle.DriveSeat.AssemblyLinearVelocity
	values.VehicleCenter.Value = _VehicleCenter
	for i, v in next, _TCSTracker do
		if not values:FindFirstChild("TCSTracker") then
			Instance.new("Folder", values).Name = "TCSTracker"
		end
		setValue("Number", i, v, values.TCSTracker)
	end
	for i, v in next, _ABSTracker do
		if not values:FindFirstChild("ABSTracker") then
			Instance.new("Folder", values).Name = "ABSTracker"
		end
		setValue("Number", i, v, values.ABSTracker)
	end
	for _, wheel in next, vehicle.Wheels:GetChildren() do
		if not _WheelSpeedsTable[wheel.Name] then
			_WheelSpeedsTable[wheel.Name] = {}
		end
		table.insert(_WheelSpeedsTable[wheel.Name], wheel.RotVelocity.Magnitude)
		if #_WheelSpeedsTable[wheel.Name] > 6 then
			table.remove(_WheelSpeedsTable[wheel.Name], 1)
		end
		local avg = 0
		for _, a in next, _WheelSpeedsTable[wheel.Name] do
			avg += a
		end
		avg /= #_WheelSpeedsTable[wheel.Name]
		_WheelSpeeds[wheel.Name] = avg
	end
	local rot = 0
	for i, v in next, _WheelSpeeds do
		if not values:FindFirstChild("WheelSpeeds") then
			Instance.new("Folder", values).Name = "WheelSpeeds"
		end
		setValue("Number", i, v, values.WheelSpeeds)
		rot += v * (vehicle.Wheels[i].Size.Y / 2)
	end
	values.AverageRotSpeed.Value = _AvgWheelSpeed
	setValue("Vector3", "Acceleration", (vehicle.DriveSeat.AssemblyLinearVelocity - _OldVelocity) * (1 / dt))
	_OldVelocity = vehicle.DriveSeat.AssemblyLinearVelocity
	if getValue("DriveReady") then
		-- Inputs
		Inputs(dt)
		-- Wheel output
		WheelOutput(dt)
		-- Steering
		Steering(dt)
		-- Gear
		Gear()
		-- Power
		Engine(dt)
		-- Progressive springs
		Progressive()
		-- Ejection
		if _Settings.Ejection then
			Eject()
		end
	end
	-- Automatic transmission
	if _TMode == "Auto" then
		Auto()
	end
	-- Flip
	if _Settings.AutoFlip then
		Flip()
	end
end)

setValue("Bool", "DriveReady", true)

for i, v in pairs(vehicle.Wheels:GetChildren()) do
	v["#AV"].AngularVelocity = 0
	v["#AV"].MotorMaxTorque = 0
	v["#AV"].MotorMaxAcceleration = 1e308
end

vehicle.DriveSeat.ChildRemoved:connect(function(child)
	if child.Name == "SeatWeld" and child:IsA("Weld") then
		for i, v in pairs(vehicle.Wheels:GetChildren()) do
			v["#AV"].AngularVelocity = 0
			v["#AV"].MotorMaxTorque = 0
			v["#AV"].MotorMaxAcceleration = 0
		end
	end
end)

function exit()
	if _Settings.Wheelie then
		gyro.D = 0
		gyro.MaxTorque = Vector3.new(0, 0, 0)
		gyro.P = 0
		gyro.CFrame = CFrame.new(vehicle.Body.Wheelie.CFrame.p, vehicle.Body.Wheelie.CFrame.p + vehicle.Body.Wheelie.CFrame.lookVector) * CFrame.Angles(0, 0, 0)
	end
	if not _Settings.AutoStart then
		if ison.Value then
			for i, v in pairs(vehicle.Wheels:GetChildren()) do
				local EBrakeForce = v.Values.EBrakeForce.Value * 9.80665 * Units.Force_N -- conversion to SI unit
				if _Settings.Config == "AWD" then
					v["#BV"].MotorMaxTorque = EBrakeForce
				elseif _Settings.Config == "FWD" then
					if string.sub(v.Name, 1, 1) == "F" then
						v["#BV"].MotorMaxTorque = EBrakeForce
					else
						v["#BV"].MotorMaxTorque = 0
					end
				elseif _Settings.Config == "MWD" then
					if string.sub(v.Name, 1, 1) == "M" then
						v["#BV"].MotorMaxTorque = EBrakeForce
					else
						v["#BV"].MotorMaxTorque = 0
					end
				elseif _Settings.Config == "RWD" then
					if string.sub(v.Name, 1, 1) == "R" then
						v["#BV"].MotorMaxTorque = EBrakeForce
					else
						v["#BV"].MotorMaxTorque = 0
					end
				end
			end
		end
	end
end
vehicle.DriveSeat.ChildRemoved:Connect(exit)

while task.wait(1 / 24) do
	if _Settings.BrakeFadeOn then
		if vehicle.Wheels:FindFirstChild("FR") and vehicle.Wheels:FindFirstChild("FL") then
			FS = math.floor(vehicle.Wheels.FL.Velocity.Magnitude + vehicle.Wheels.FR.Velocity.Magnitude / 2) * FrontWheelCount
		elseif vehicle.Wheels:FindFirstChild("FR") and vehicle.Wheels:FindFirstChild("FL") and vehicle.Wheels:FindFirstChild("F") then
			FS = math.floor(vehicle.Wheels.FL.Velocity.Magnitude + vehicle.Wheels.FR.Velocity.Magnitude + vehicle.Wheels.F.Velocity.Magnitude / 3) * FrontWheelCount
		elseif vehicle.Wheels:FindFirstChild("F") then
			FS = math.floor(vehicle.Wheels.F.Velocity.Magnitude) * FrontWheelCount
		end
		if vehicle.Wheels:FindFirstChild("RR") and vehicle.Wheels:FindFirstChild("RL") then
			RS = math.floor(vehicle.Wheels.RL.Velocity.Magnitude + vehicle.Wheels.RR.Velocity.Magnitude / 2) * MidWheelCount
		elseif vehicle.Wheels:FindFirstChild("RR") and vehicle.Wheels:FindFirstChild("RL") and vehicle.Wheels:FindFirstChild("R") then
			RS = math.floor(vehicle.Wheels.RL.Velocity.Magnitude + vehicle.Wheels.RR.Velocity.Magnitude + vehicle.Wheels.R.Velocity.Magnitude / 3) * MidWheelCount
		elseif vehicle.Wheels:FindFirstChild("R") then
			RS = math.floor(vehicle.Wheels.R.Velocity.Magnitude) * MidWheelCount
		end
		if vehicle.Wheels:FindFirstChild("MR") and vehicle.Wheels:FindFirstChild("ML") then
			MS = math.floor(vehicle.Wheels.ML.Velocity.Magnitude + vehicle.Wheels.MR.Velocity.Magnitude / 2) * RearWheelCount
		elseif vehicle.Wheels:FindFirstChild("MR") and vehicle.Wheels:FindFirstChild("ML") and vehicle.Wheels:FindFirstChild("M") then
			MS = math.floor(vehicle.Wheels.ML.Velocity.Magnitude + vehicle.Wheels.MR.Velocity.Magnitude + vehicle.Wheels.M.Velocity.Magnitude / 3) * RearWheelCount
		elseif vehicle.Wheels:FindFirstChild("M") then
			MS = math.floor(vehicle.Wheels.M.Velocity.Magnitude) * RearWheelCount
		end
		if vehicle.Wheels:FindFirstChild("MR") or vehicle.Wheels:FindFirstChild("ML") or vehicle.Wheels:FindFirstChild("M") then
			wheelspeedcombined = (FS / (FrontWheelCount * 10)) + (MS / (MidWheelCount * 10)) + (RS / (RearWheelCount * 10))
		else
			wheelspeedcombined = (FS / (FrontWheelCount * 10)) + (RS / (RearWheelCount * 10))
		end
		braketemp = math.floor(_Settings.BrakeHeat * 3)
		values.AverageBrakeTemp.Value = braketemp
		for i, v in next, (vehicle.Wheels:GetChildren()) do
			local WheelValues = v.Values
			wheelspeedindividual = v.Velocity.Magnitude / 10
			BrakeForce = WheelValues.BrakeForce.Value
			if values.Brake.Value > 0 and _Settings.BrakeHeat * 3 < WheelValues.MaxBrakeTemp.Value and wheelspeedindividual > .1 then
				_Settings.BrakeHeat = _Settings.BrakeHeat + (WheelValues.BrakeHeatingSpeed.Value)
				local reduction = (BrakeForce * _Settings.BrakeHeat / WheelValues.BrakeReductionStress.Value)
				BrakeForce = (BrakeForce - reduction)
			elseif values.Brake.Value < 1 and _Settings.BrakeHeat > 0 and wheelspeedindividual > .1 then
				task.wait(WheelValues.BrakeCoolingSpeed.Value)
				if _Settings.BrakeHeat > _Settings.Temperature / 3 then
					_Settings.BrakeHeat = _Settings.BrakeHeat - (WheelValues.BrakeCooling.Value * wheelspeedindividual) - ((_Settings.BrakeHeat * 6) * .01)
				elseif _Settings.BrakeHeat < _Settings.Temperature / 3 then
					_Settings.BrakeHeat = _Settings.Temperature / 3
					BrakeForce = BrakeForce
				end
			end
			if _Settings.BrakeHeat > (_Settings.Temperature / 3) * 1.025 then
				_Settings.BrakeHeat = _Settings.BrakeHeat - (WheelValues.BrakeCooling.Value / 10)
				WheelValues.WheelBrakeTemp.Value = _Settings.BrakeHeat * 3
			end
		end
	end
end]]></ProtectedString>
