					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[ Welcome, tuner.
    ____  ___
   / __ \/   | Entity
  / /_/ / /| | Roblox self propelled land vehicle chassis
 / __ _/ ___ | 0.51.4
/_/ |_/_/  |_| GitHub:    https://github.com/totallyahuman445/Roblox-Entity-RA
               Discord:   https://discord.gg/bS2A448Vrk
               Community: https://www.roblox.com/share/g/206794047
			   THE List:  https://docs.google.com/document/d/1WvOWw7ST4ZWpsCfXM3abJTTBkCA40NsayIEIdCRJOYM/edit?usp=sharing
			   Log:		  https://docs.google.com/document/d/1SLW5NOAysg2rE6C52WEPnmOas_MNbeVNEv0xv2f__ps/edit?usp=sharing
			   Credits:   https://docs.google.com/document/d/1-mIgEhmugHfVUDz4vzZMS7XYMoEdLKedy0MedRqvbyA/edit?usp=sharing
]]
-- All units derived from: https://create.roblox.com/docs/physics/units
-- Converting from the SI unit to the Roblox unit
local Units = {}
Units.Mass_kg = .04555									   -- Mass in kilograms (kg)
Units.Length_mm = 280									   -- Length in milimeters (mm)
Units.Force_N = .16269									   -- Force in Newtons (N)
Units.Stiffness_Ndivm = Units.Mass_kg					   -- Stiffness in Newtons per meter (N/m)
Units.Damping_N_sdivm = Units.Mass_kg					   -- Damping in Newton-seconds per meter (N*s/m)
Units.Velocity_mdivs = 1 / (Units.Length_mm / 1000)	       -- Velocity in meters per second (m/s)
Units.Torque_nm = Units.Force_N / (Units.Length_mm / 1000) -- Torque in Newton-meters (Nm)
return Units]]></ProtectedString>
					<string name="ScriptGuid">{35BD5C76-2375-48DB-8E5C-00FF92D1598A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Units</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBXF35CD9B3DAFF4F06A3D1F1E7744D79EC">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- I assume you know what you're doing if you're gonna change something here.
--[[Weld functions]]
local PGS_ON = workspace:PGSIsEnabled()
if not PGS_ON then
	error(script.Parent.Chassis.ChassisName.Value .." " ..script.Parent.Chassis.Version.Value .."no longer supports Legacy physics solving, sorry!")
end

if workspace.Gravity > 196.1 and workspace.Gravity < 196.3 then -- Jupiter warning
	warn("Default gravity detected, your settings have been auto adjusted for compatability, please use 35.025 gravity, 2 road Friction and 3.5 road FrictionWeight for optimal driving‼️")
end

function MakeWeld(x, y, type, s)
	if type == nil then
		type = "Weld"
	end
	local W = Instance.new(type, x)
	W.Part0 = x W.Part1 = y
	W.C0 = x.CFrame:inverse() * x.CFrame
	W.C1 = y.CFrame:inverse() * x.CFrame
	if type == "Motor" and s ~= nil then
		W.MaxVelocity = s
	end
	return W
end

function ModelWeld(a, b)
	if a:IsA("BasePart") then
		MakeWeld(b,a,"Weld")
	elseif a:IsA("Model") then
		for i, v in pairs(a:GetChildren()) do
			ModelWeld(v, b)
		end
	elseif a:IsA("GeneratedFolder") then
		for i, v in pairs(a:GetChildren()) do
			ModelWeld(v, b)
		end
	end
end

function UnAnchor(a)
	if a:IsA("BasePart") then
		a.Anchored = false
	end
	for i, v in pairs(a:GetChildren()) do
		UnAnchor(v)
	end
end

--[[Initialize]]
script.Parent:WaitForChild("Interface")
script.Parent:WaitForChild("Plugins")
script.Parent.Chassis:WaitForChild("Version")

local cs = game:GetService('CollectionService')
local Vehicle = script.Parent.Parent
local Wheels = {}
local _Settings = require(script.Parent)
local Units = require(script.Parent.Units)

cs:AddTag(Vehicle, script.Parent.Chassis.ChassisName.Value)

-- WheelSettingsMaster
if _Settings.WheelSettingsMasterConfig == not "Individual" then
	IndividualSetup = true
end

if not IndividualSetup then
	for i, v in next, Vehicle.Wheels:GetChildren() do
		if _Settings.WheelSettingsMasterConfig == "Simple" then
			if string.sub(v.Name, 1, 1) == "F" then
				clone = Vehicle.Front:Clone()
				clone.Parent = v
				clone.Disabled = false
			else
				clone = Vehicle.Rear:Clone()
				clone.Parent = v
				clone.Disabled = false
			end
		elseif _Settings.WheelSettingsMasterConfig == "All" then
			clone = script.Parent.WheelSettingsMaster.All.WheelSettings:Clone()
			clone.Parent = v
			clone.Disabled = false
		elseif _Settings.WheelSettingsMasterConfig == "Type" then
			if string.sub(v.Name, 1, 1) == "F" then
				clone = script.Parent.WheelSettingsMaster.Type.Front.WheelSettings:Clone()
				clone.Parent = v
				clone.Disabled = false
			elseif string.sub(v.Name, 1, 1) == "M" then
				clone = script.Parent.WheelSettingsMaster.Type.Mid.WheelSettings:Clone()
				clone.Parent = v
				clone.Disabled = false
			else
				clone = script.Parent.WheelSettingsMaster.Type.Rear.WheelSettings:Clone()
				clone.Parent = v
				clone.Disabled = false
			end
		elseif _Settings.WheelSettingsMasterConfig == "Names" then
			clone = script.Parent.WheelSettingsMaster.Names[v.Name].WheelSettings:Clone()
			clone.Parent = v
			clone.Disabled = false
		end
	end
end

script.Parent.WheelSettingsMaster:Destroy()

task.wait(_Settings.LoadDelay)

local Drive = Vehicle.Wheels:GetChildren()

-- Remove Existing Mass
function DReduce(p)
	for i, v in pairs(p:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Massless = true -- but it's just this line
		end
	end
end

DReduce(Vehicle)

--[[Wheel Configuration]]
-- Store Reference Orientation Function
function getParts(model, t, a)
	for i,v in pairs(model:GetChildren()) do
		if v:IsA("BasePart") then
			table.insert(t, {v, a.CFrame:toObjectSpace(v.CFrame)})
		elseif v:IsA("Model") then
			getParts(v, t, a)
		end
	end
end

function GetVehicleCenter(a)
	local centerF = Vector3.new()
	local centerR = Vector3.new()
	local countF = 0
	local countR = 0
	for i, v in next, Vehicle.Wheels:GetChildren() do
		if string.sub(v.Name, 1, 1) == "F" then
			centerF = centerF + v.CFrame.p
			countF = countF + 1
		else
			centerR = centerR + v.CFrame.p
			countR = countR + 1
		end
	end
	centerF = centerF / countF
	centerR = centerR / countR
	local center = CFrame.lookAt(centerR:Lerp(centerF, a or .5), centerF)
	return center
end

for _, v in pairs(Drive) do
	local WheelValues = v.Values
	local WheelCustom = v.Customization

	-- Save wheel part positions
	local WParts = {}
	for _, a in next, v.Parts:GetDescendants() do
		if not a:IsA("BasePart") then
			continue
		end
		table.insert(WParts, {a, v.CFrame:ToObjectSpace(a.CFrame)})
	end
	for _, a in next, v.WheelFixed:GetDescendants() do
		if not a:IsA("BasePart") then
			continue
		end
		table.insert(WParts, {a, v.CFrame:ToObjectSpace(a.CFrame)})
	end

	-- Align Wheels
	if v.Name == "FL" or v.Name == "ML" or v.Name == "RL" then
		v.CFrame = v.CFrame * CFrame.Angles(math.rad(WheelValues.Caster.Value) ,math.rad(-WheelValues.Toe.Value), math.rad(WheelValues.Camber.Value))
	else
		v.CFrame = v.CFrame * CFrame.Angles(math.rad(-WheelValues.Caster.Value), math.rad(WheelValues.Toe.Value), math.rad(WheelValues.Camber.Value))
	end

	for _, a in next, WParts do
		a[1].CFrame = v.CFrame * a[2]
	end

	--[[Chassis Assembly]]
	-- Create Steering Axle
	local AxleSize = WheelValues.AxleSize.Value
	local SuspensionRotate = WheelValues.SuspensionRotate.Value
	local SusLength = WheelValues.SusLength.Value

	local AnchorOffset = WheelValues.AnchorOffset.Value
	local AnchorOffset2 = {AnchorOffset.Position.X, AnchorOffset.Position.Y, AnchorOffset.Position.Z,}
	local SpringOffset = WheelValues.SpringOffset.Value
	local SpringOffset2 = {SpringOffset.Position.X, SpringOffset.Position.Y, SpringOffset.Position.Z,}

	local FWSteer = WheelValues.FWSteer.Value

	-- PGS / Legacy
	local DistX = WheelValues.WsBoneLen.Value * math.cos(math.rad(WheelValues.WsBoneAngle.Value))
	local DistY = WheelValues.WsBoneLen.Value * math.sin(math.rad(WheelValues.WsBoneAngle.Value))

	local SLX = SusLength * math.cos(math.rad(WheelValues.SusAngle.Value))
	local SLY = SusLength * math.sin(math.rad(WheelValues.SusAngle.Value))

	local arm = Instance.new("Part", v)
	arm.Name = "Arm"
	arm.Anchored = true
	arm.CanCollide = false
	arm.Size = Vector3.new(AxleSize, AxleSize, AxleSize)
	arm.CFrame = v.CFrame
	arm.CustomPhysicalProperties = PhysicalProperties.new(math.clamp(WheelValues.AxleDensity.Value, .0001, 100), 0, 0, 100, 100)
	arm.TopSurface = Enum.SurfaceType.Smooth
	arm.BottomSurface = Enum.SurfaceType.Smooth
	arm.Transparency = 1
	arm.Color = Color3.fromRGB(0, 0, 0)
	arm.Material = "SmoothPlastic"

	-- Create Wheel Spindle
	local base = arm:Clone()
	base.Parent = v
	base.Name = "Base"
	base.CFrame = arm.CFrame * CFrame.new(0, AxleSize, 0)
	base.Transparency = WheelCustom.Base.Transparency
	base.Color = WheelCustom.Base.Color
	base.Material = WheelCustom.Base.Material
	base.MaterialVariant = WheelCustom.Base.MaterialVariant
	base.Reflectance = WheelCustom.Base.Reflectance
	base.Shape = WheelCustom.Base.Shape
	base.BackSurface = WheelCustom.Base.BackSurface
	base.BackSurface = WheelCustom.Base.BottomSurface
	base.FrontSurface = WheelCustom.Base.FrontSurface
	base.RightSurface = WheelCustom.Base.RightSurface
	base.LeftSurface = WheelCustom.Base.LeftSurface
	base.TopSurface = WheelCustom.Base.TopSurface

	local SteerOuter = (WheelValues.LockToLock.Value * 180) / WheelValues.SteerRatio.Value
	local SteerInner = math.min(SteerOuter - (SteerOuter * (1 - WheelValues.Ackerman.Value)), SteerOuter * 1.2)

	-- Create Steering Anchor
	local axle = arm:Clone()
	axle.Parent = v
	axle.Name = "Axle"
	axle.CFrame = v.CFrame * CFrame.new(v.Size.X / 2 + AxleSize / 2, 0, 0)
	axle.Transparency = WheelCustom.Axle.Transparency
	axle.Color = WheelCustom.Axle.Color
	axle.Material = WheelCustom.Axle.Material
	axle.MaterialVariant = WheelCustom.Axle.MaterialVariant
	axle.Reflectance = WheelCustom.Axle.Reflectance
	axle.Shape = WheelCustom.Axle.Shape
	axle.BackSurface = WheelCustom.Axle.BackSurface
	axle.BottomSurface = WheelCustom.Axle.BottomSurface
	axle.FrontSurface = WheelCustom.Axle.FrontSurface
	axle.RightSurface = WheelCustom.Axle.RightSurface
	axle.LeftSurface = WheelCustom.Axle.LeftSurface
	axle.TopSurface = WheelCustom.Axle.TopSurface

	-- Create steering anchor
	if SuspensionRotate then
		systemHub = base:Clone()
		systemHub.Parent = v
		systemHub.Name = "SystemHub"
		systemHub.TopSurface = Enum.SurfaceType.Smooth
		systemHub.BottomSurface = Enum.SurfaceType.Smooth
	end

	-- Create Powered Axle
	local axlep = arm:Clone()
	axlep.Parent = v
	axlep.Name = "AxleP"
	axlep.CFrame = v.CFrame * CFrame.Angles(0, math.rad((string.sub(v.Name, 2, 2) == "R") and 0 or 180), 0)
	axlep.Transparency = WheelCustom.AxleP.Transparency
	axlep.Color = WheelCustom.AxleP.Color
	axlep.Material = WheelCustom.AxleP.Material
	axlep.MaterialVariant = WheelCustom.AxleP.MaterialVariant
	axlep.Reflectance = WheelCustom.AxleP.Reflectance
	axlep.Shape = WheelCustom.AxleP.Shape
	axlep.BackSurface = WheelCustom.AxleP.BackSurface
	axlep.BottomSurface = WheelCustom.AxleP.BottomSurface
	axlep.FrontSurface = WheelCustom.AxleP.FrontSurface
	axlep.RightSurface = WheelCustom.AxleP.RightSurface
	axlep.LeftSurface = WheelCustom.AxleP.LeftSurface
	axlep.TopSurface = WheelCustom.AxleP.TopSurface
	MakeWeld(axlep, axle)
	
	WheelCustom:Destroy()

	-- Create Suspension
	if WheelValues.SuspensionEnabled.Value then
		if v:FindFirstChild("SuspensionGeometries") then
			SuspensionGeometries = v:FindFirstChild("SuspensionGeometries")
			if SuspensionGeometries:FindFirstChild("SuspensionGeometry") then
				SuspensionGeometry = SuspensionGeometries:FindFirstChild("SuspensionGeometry")
			end
		end
		if SuspensionGeometry then
			for _, a in next, SuspensionGeometry:GetDescendants() do
				if a.Name == "Weld" then
					if a:IsA("BasePart") then
						if SuspensionRotate then
							MakeWeld(a, systemHub)
						else
							MakeWeld(a, Vehicle.DriveSeat.Base)
						end
					elseif a:IsA("Model") then
						if SuspensionRotate then
							MakeWeld(a, systemHub)
						else
							ModelWeld(a, Vehicle.DriveSeat.Base)
						end
					end
				end
			end
			MakeWeld(SuspensionGeometry.Parts.Hub, base)
			if SuspensionGeometry.Parts:FindFirstChild("SpringTop") then
				if SuspensionRotate then
					MakeWeld(SuspensionGeometry.Parts.SpringTop, systemHub)
				else
					MakeWeld(SuspensionGeometry.Parts.SpringTop, Vehicle.DriveSeat.Base)
				end
			end
			local susparts = SuspensionGeometry:GetDescendants()
			for _,p in pairs(susparts) do
				if p:IsA("BasePart") then
					if p.Name == "WELDME" then
						local susvisualweld = Instance.new("WeldConstraint", p)
						susvisualweld.Parent = p
						susvisualweld.Part0 = p
						susvisualweld.Part1 = p.Parent
					end
					p.CustomPhysicalProperties = PhysicalProperties.new(math.clamp(WheelValues.CustomSuspensionDensity.Value, .0001, 100), 0, 0, 0, 0)
					if WheelValues.CustomSuspensionDensity.Value ~= not 0 then
						p.Massless = true
					end
				end
			end
			local g = Instance.new("BodyGyro", SuspensionGeometry.Parts.Hub)
			g.Name = "Stabilizer"
			g.MaxTorque = Vector3.new(0, 0, 1)
			g.P = 0

			sp = SuspensionGeometry.Constraints:FindFirstChild("Spring")
			sp.LimitsEnabled = true

			g.D = WheelValues.GyroDampening.Value
			sp.Damping = WheelValues.SusDamping.Value * Units.Damping_N_sdivm
			sp.Stiffness = WheelValues.SusStiffness.Value * 9806.65 * Units.Stiffness_Ndivm -- 9806.65 converts kgf/mm to N/m
			sp.FreeLength = SusLength + WheelValues.PreCompress.Value
			sp.MaxLength = SusLength + WheelValues.ExtensionLim.Value
			sp.MinLength = SusLength - WheelValues.CompressLim.Value
		else
			local legacyCFrame = v.CFrame*CFrame.Angles(math.rad(90), 0, math.rad(90)) -- not gonna bother fixing the entire thing so i just put this because it works
			local sa = arm:Clone()
			sa.Parent = v
			sa.Name = "#SA"
			sa.CFrame = (legacyCFrame) * CFrame.Angles(-math.pi / 2, -math.pi / 2, 0)
			sa.CFrame = legacyCFrame * CFrame.new(AxleSize / 2, -DistX, -DistY) * CFrame.new(AnchorOffset2[3],AnchorOffset2[1],-AnchorOffset2[2]) * CFrame.Angles(-math.pi / 2, -math.pi / 2, 0)

			local sb = sa:Clone()
			sb.Parent = v
			sb.Name = "#SB"
			sb.CFrame = sa.CFrame * CFrame.new(0, 0, AxleSize)
			sb.FrontSurface = Enum.SurfaceType.Hinge	

			local g = Instance.new("BodyGyro", sb)
			g.Name = "Stabilizer"
			g.MaxTorque = Vector3.new(0, 0, 1)
			g.P = 0

			local sf1 = Instance.new("Attachment", sa)
			sf1.Name = "SAtt"

			local sf2 = sf1:Clone()
			sf2.Parent = sb

			-- adds spring offset
			local aOff = SpringOffset2
			if v.Name == "FL" or v.Name == "RL" or v.Name == "ML" then
				sf1.Position = Vector3.new(DistX - SLX + aOff[1], -DistY + SLY + aOff[2], AxleSize / 2 + aOff[3])
				sf2.Position = Vector3.new(DistX + aOff[1], -DistY + aOff[2], -AxleSize / 2 + aOff[3])
			else
				sf1.Position = Vector3.new(DistX - SLX + aOff[1] ,-DistY + SLY + aOff[2], AxleSize / 2 - aOff[3])
				sf2.Position = Vector3.new(DistX + aOff[1], -DistY + aOff[2],-AxleSize / 2 - aOff[3])
			end
			sb:MakeJoints()
			-- there was axle:makejoints here I believe, but the new powered axle manually welds itself so I ditched it
			local sp = Instance.new("SpringConstraint", v)
			sp.Name = "Spring"
			sp.Attachment0 = sf1
			sp.Attachment1 = sf2
			sp.LimitsEnabled = true

			sp.Visible = WheelValues.Springs.Visible
			sp.Radius = WheelCustom.Springs.Radius
			sp.Thickness = WheelCustom.Springs.Thickness
			sp.Color = BrickColor.new(WheelCustom.Springs.Color)
			sp.Coils = WheelCustom.Springs.Coils

			g.D = WheelValues.GyroDampening.Value
			sp.Damping = WheelValues.SusDamping.Value * Units.Damping_N_sdivm
			sp.Stiffness = WheelValues.SusStiffness.Value * 9806.65 * Units.Stiffness_Ndivm
			sp.FreeLength = SusLength + WheelValues.PreCompress.Value
			sp.MaxLength = SusLength + WheelValues.ExtensionLim.Value
			sp.MinLength = SusLength - WheelValues.CompressLim.Value
			
			if SuspensionRotate then
				MakeWeld(systemHub, sa)
			else
				MakeWeld(Vehicle.DriveSeat.Base, sa)
			end
			MakeWeld(sb, base)
		end
		v.Massless = false
	else
		MakeWeld(Vehicle.DriveSeat.Base, base)
		v.SuspensionGeometries:Destroy()
	end

	-- Lock Rear Steering Axle
	if FWSteer == "None" then
		if string.sub(v.Name, 1, 1) == "R" then
			if SuspensionRotate then
				MakeWeld(systemHub, Vehicle.DriveSeat.Base)
			else
				MakeWeld(base, axle)
			end
		end
	end
	MakeWeld(arm, axle)
	arm:MakeJoints()
	-- Weld Miscelaneous Parts
	if v:FindFirstChild("SuspensionFixed") ~= nil then
		if SuspensionRotate then
			ModelWeld(v.SuspensionFixed, systemHub)
		else
			ModelWeld(v.SuspensionFixed, Vehicle.DriveSeat.Base)
		end
	end
	if v:FindFirstChild("WheelFixed") ~= nil then
		ModelWeld(v.WheelFixed, axle)
	end
	if v:FindFirstChild("Fixed") ~= nil then
		ModelWeld(v.Fixed, arm)
	end
	-- Weld Wheel Parts
	if v:FindFirstChild("Parts") ~= nil then
		ModelWeld(v.Parts, v)
	end
	-- Add Steering Gyro
	if v:FindFirstChild("Steer") then
		v:FindFirstChild("Steer"):Destroy()
	end
	if (string.sub(v.Name, 1, 1) == "F") or (FWSteer == "Static" or FWSteer == "Speed" or FWSteer == "Both") then
		local steer
		if WheelValues.PowerSteeringType.Value == "New" then
			if SuspensionRotate then
				steerAttach0 = Instance.new("Attachment", Vehicle.DriveSeat.Base)
				steerAttach0.Name = "SteerAttach0"
				steerAttach0.WorldCFrame = systemHub.CFrame
				steerAttach1 = Instance.new("Attachment", systemHub)
				steerAttach1.Name = "SteerAttach1"
				steer = Instance.new("AlignOrientation", systemHub)
			else
				steerAttach0 = Instance.new("Attachment", arm)
				steerAttach0.Name = "SteerAttach0"
				steerAttach1 = Instance.new("Attachment", base)
				steerAttach1.Name = "SteerAttach1"
				steer = Instance.new("AlignOrientation", arm)
			end
			steer.Name = "Steer"
			steer.Mode = WheelValues.AlignmentMode.Value
			steer.AlignType = WheelValues.AlignType.Value
			steer.ReactionTorqueEnabled = WheelValues.ReactionTorqueEnabled.Value
			steer.RigidityEnabled = WheelValues.RigidityEnabled.Value
			if not WheelValues.RigidityEnabled.Value then
				steer.MaxAngularVelocity = WheelValues.MaxAngularVelocity.Value
				steer.MaxTorque = WheelValues.MaxTorque.Value
				steer.Responsiveness = WheelValues.Responsiveness.Value
			end
			steer.Attachment0 = steerAttach0
			steer.Attachment1 = steerAttach1
		else
			steer = Instance.new("BodyGyro", arm)
			if string.find(v.Name, "F") then
				steer.P = WheelValues.SteerP.Value
				steer.D = WheelValues.SteerD.Value
				steer.MaxTorque = Vector3.new(0, WheelValues.SteerMaxTorque.Value, 0)
			else
				steer.P = WheelValues.RSteerP.Value
				steer.D = WheelValues.RSteerD.Value
				steer.MaxTorque = Vector3.new(0, WheelValues.RSteerMaxTorque.Value, 0)
			end
		end
		steer.Name = "Steer"
		steer.CFrame = v.CFrame
	end
	-- Add Stabilization Gyro
	local gyro = Instance.new("BodyGyro", v)
	gyro.Name = "Stabilizer"
	gyro.MaxTorque = Vector3.new(1, 0, 1)
	gyro.P = 0
	gyro.D = WheelValues.GyroDamp.Value
	-- Add rotation constraint
	if SuspensionRotate then
		MakeWeld(arm, base)
		rotationAttachment0 = Instance.new("Attachment", Vehicle.DriveSeat.Base)
		rotationAttachment0.Name = "RotationAttachment0"
		rotationAttachment0.WorldCFrame = systemHub.CFrame * CFrame.new(0, 0, WheelValues.SteerPivot.Value)
		rotationAttachment0.Orientation += Vector3.new(0, 0, 90)
		rotationAttachment1 = Instance.new("Attachment", systemHub)
		rotationAttachment1.Name = "RotationAttachment1"
		rotationAttachment1.WorldCFrame = rotationAttachment0.WorldCFrame
		rotationHinge = Instance.new("HingeConstraint", systemHub)
		rotationHinge.Name = "Rotate"
		rotationHinge.LimitsEnabled = true
	else
		rotationAttachment0 = Instance.new("Attachment", base)
		rotationAttachment0.Name = "RotationAttachment0"
		rotationAttachment0.Position = Vector3.new(0, -AxleSize / 2, 0)
		rotationAttachment0.Orientation = Vector3.new(0, 0, 90)
		rotationAttachment1 = Instance.new("Attachment", arm)
		rotationAttachment1.Name = "RotationAttachment1"
		rotationAttachment1.Position = Vector3.new(0, AxleSize / 2, 0)
		rotationAttachment1.Orientation = Vector3.new(0, 0, 90)
		rotationHinge = Instance.new("HingeConstraint", base)
		rotationHinge.Name = "Rotate"
		rotationHinge.LimitsEnabled = true
	end
	if string.sub(v.Name, 1, 1) == "F" or WheelValues.MFreeWheel.Value then
		rotationHinge.UpperAngle = math.max(SteerOuter, SteerInner)
	elseif string.sub(v.Name, 1, 1) == "R" then
		rotationHinge.UpperAngle = math.max(WheelValues.RSteerOuter.Value, WheelValues.RSteerInner.Value)
	else
		rotationHinge.UpperAngle = math.max(0, 0)
	end
	rotationHinge.LowerAngle = -rotationHinge.UpperAngle
	rotationHinge.Attachment0 = rotationAttachment0
	rotationHinge.Attachment1 = rotationAttachment1
	-- Add Motors
	local AV = Instance.new("HingeConstraint", v)
	if WheelValues.ThrottleDisabled.Value then
		AV.Enabled = false
	end
	AV.Radius = 0
	AV.ActuatorType = "Motor"
	AV.Attachment0 = Instance.new("Attachment", v.AxleP)
	v.AxleP.Attachment.Name = "AA"
	AV.Attachment1 = Instance.new("Attachment", v)
	AV.Attachment1.Orientation = Vector3.new(0, (string.sub(v.Name, 2, 2) == "R") and 0 or 180, 0)
	v.Attachment.Name = "AB"
	AV.Name = "#AV"
	AV.AngularVelocity = 0
	AV.MotorMaxTorque = 0
	local BV = Instance.new("HingeConstraint", v)
	BV.ActuatorType = "Motor"
	BV.Attachment0 = Instance.new("Attachment", v.AxleP)
	v.AxleP.Attachment.Name = "BA"
	BV.Attachment1 = Instance.new("Attachment", v)
	BV.Attachment1.Orientation = Vector3.new(0, (string.sub(v.Name, 2, 2) == "R") and 0 or 180, 0)
	v.Attachment.Name = "BB"
	BV.Name = "#BV"
	BV.AngularVelocity = 0
	BV.MotorMaxTorque = WheelValues.PBrakeForce.Value * 9.80665 * Units.Force_N -- Conversion to SI unit.
	-- NoCollisionConstraint preparation
	for _, y in next, v.NoCollisionConstraint:GetChildren() do
		if y.Part0 then
			y.Part0.CanCollide = false
		elseif y.Part1 then
			y.Part1.CanCollide = false
		end
	end
end

--[[Vehicle Weight]]
-- Determine Current Mass
local mass = 0
function getMass(p)
	for i, v in pairs(p:GetChildren()) do
		if v:IsA("BasePart") and not v.Massless then
			mass = mass + v:GetMass()
		end
		getMass(v)
	end
end

getMass(Vehicle)

-- Apply Vehicle Weight
if mass < _Settings.Weight / 2.205 / 8 then
	-- Calculate Weight Distribution
	local centerF = Vector3.new()
	local centerR = Vector3.new()
	local countF = 0
	local countR = 0
	for i, v in pairs(Drive) do
		if string.sub(v.Name, 1, 1) == "F" then
			centerF = centerF + v.CFrame.p
			countF = countF + 1
		else
			centerR = centerR + v.CFrame.p
			countR = countR + 1
		end
	end
	centerF = centerF / countF
	centerR = centerR / countR
	local center = centerR:Lerp(centerF, _Settings.WeightDist / 100)
	-- Create Weight Brick
	local weightB = Instance.new("Part", Vehicle.Body)
	weightB.Name = "#Weight"
	weightB.Anchored = true
	weightB.CanCollide = false
	weightB.BrickColor = BrickColor.new("Really black")
	weightB.TopSurface = Enum.SurfaceType.Smooth
	weightB.BottomSurface = Enum.SurfaceType.Smooth
	if _Settings.WBVisible then
		weightB.Transparency = .75
	else
		weightB.Transparency = 1
	end
	-- Lean Gyro
	if _Settings.Wheelie then
		Wheelie = weightB:Clone()
		Wheelie.Parent = Vehicle.Body
		Wheelie.Massless = true
		Wheelie.Name = "Wheelie"
		Wheelie.CFrame = (Vehicle.DriveSeat.CFrame - Vehicle.DriveSeat.Position + center) * CFrame.new(0, _Settings.CGHeight, 0)
		Wheelie.Size = Vector3.new(_Settings.WeightBSize[1], _Settings.WeightBSize[2], _Settings.WeightBSize[3]) / Units.Length_mm
	end
	
	if _Settings.Lean then
		lean = Instance.new("BodyGyro")
		lean.Parent = weightB
		lean.Name = "LeanGyro"
		lean.D = _Settings.LeanD
		lean.MaxTorque = Vector3.new(0, 0, 0)
		lean.P = _Settings.LeanP
	end
	
	weightB.Size = Vector3.new(_Settings.WeightBSize[1], _Settings.WeightBSize[2], _Settings.WeightBSize[3]) / Units.Length_mm
	local tdensity = (_Settings.Weight * Units.Mass_kg - mass) / (weightB.Size.X * weightB.Size.Y * weightB.Size.Z)
	weightB.CustomPhysicalProperties = PhysicalProperties.new(tdensity, 0, 0, 0, 0)
	-- Real life mass in kg minus existing roblox mass converted to kg, divided by volume of the weight brick in cubic meters, divided by the density of water
	weightB.CFrame = (Vehicle.DriveSeat.CFrame - Vehicle.DriveSeat.Position + center) * CFrame.new(0, _Settings.CGHeight, 0)
	-- Density Cap
	if weightB.CustomPhysicalProperties.Density >= 2 then
		warn("\n\t ["..script.Parent.Chassis.ChassisName.Value .." " ..script.Parent.Chassis.Version.Value .."]: Density too high for specified volume."
			.."\n\t Current Density:\t"..math.ceil(tdensity)
			.."\n\t Max Density:\t"..math.ceil(weightB.CustomPhysicalProperties.Density)
			.."\n\t Increase weight brick size to compensate.")
	end
else
-- Existing Weight Is Too Massive
	warn("\n\t ["..script.Parent.Chassis.ChassisName.Value .." " ..script.Parent.Chassis.Version.Value .."]: Mass too high for specified weight."
	.."\n\t    Target Mass:\t"..math.ceil((_Settings.Weight * 2.205) * 8)
	.."\n\t    Current Mass:\t"..math.ceil(mass)
	.."\n\t Reduce part size or axle density to achieve desired weight.")
end

local flipG = Instance.new("BodyGyro", Vehicle.DriveSeat.Base)
flipG.Name = "Flip"
flipG.D = 0
flipG.MaxTorque = Vector3.new(0, 0, 0)
flipG.P = 0

--[[Finalize Chassis]]
-- Misc Weld
task.wait()
for i, v in pairs(script:GetChildren()) do
	if v:IsA("ModuleScript") then
		require(v)
	end
end

-- Weld Body
task.wait()
ModelWeld(Vehicle.Body, Vehicle.DriveSeat.Base)
for i, v in pairs(Vehicle.Loose:GetDescendants()) do
	if v:IsA("BasePart") then
		local weld = Instance.new("WeldConstraint")
		weld.Parent = Vehicle.DriveSeat.Base
		weld.Name = "TemporaryWeld"
		weld.Part0 = v
		weld.Part1 = Vehicle.DriveSeat.Base
	end
end

-- Remove TemporaryWeld for loose objects now that the vehicle has loaded.
for i, v in pairs(Vehicle.DriveSeat.Base:GetChildren()) do
	if v.Name == "TemporaryWeld" and v:IsA("WeldConstraint") then
		v:Destroy()
	end
end

-- Unanchor
task.wait()
UnAnchor(Vehicle)

--[[Manage Plugins]]
script.Parent.Interface.Vehicle.Value = Vehicle
script.Parent.Interface.Car.Value = Vehicle
script.Parent.Interface.Bike.Value = Vehicle
for i, v in pairs(script.Parent.Plugins:GetChildren()) do
	for _, a in pairs(v:GetChildren()) do
		if a:IsA("RemoteEvent") or a:IsA("RemoteFunction") or a:IsA("UnreliableRemoteEvent") then
			a.Parent = Vehicle
			for _,b in pairs(a:GetChildren()) do
				if b:IsA("Script") then
					b.Disabled = false
				end
			end
		end
	end
	v.Parent = script.Parent.Interface
end
script.Parent.Plugins:Destroy()

--[[Seat Injector]]
for i, v in pairs (script.Parent.Parent:GetDescendants()) do
	if v:IsA("Seat") or v:IsA("VehicleSeat") then
		for i, x in pairs (script.Parent.SeatInjector.All:GetChildren()) do
			y = x:Clone()
			y.Parent = v
			if y:IsA("Script") or y:IsA("LocalScript") or y:IsA("ModuleScript") then
				if y.Name == "Bail_Damage" and y:IsA("Script") and not _Settings.BailDamage then
					y:Destroy()
				end
				y.Enabled = true
			end
		end
	end
	if v:IsA("Seat") then
		for i, x in pairs (script.Parent.SeatInjector.Passenger:GetChildren()) do
			y = x:Clone()
			y.Parent = v
			if y:IsA("Script") or y:IsA("LocalScript") or y:IsA("ModuleScript") then
				y.Enabled = true
			end
		end
	end
end
script.Parent.SeatInjector:Destroy()

--[[Remove Character Weight]]
if _Settings.PlayerMassless then
	-- Get Seats
	local Seats = {}
	function getSeats(p)
		for i, v in (p:GetDescendants()) do
			if v:IsA("VehicleSeat") or v:IsA("Seat") then
				local seat = {}
				seat.Seat = v
				seat.Parts = {}
				table.insert(Seats, seat)
			end
		end	
	end
	getSeats(Vehicle)
	-- Store Physical Properties/Remove Mass Function
	function getPProperties(character, t)
		for _, v in character:GetDescendants() do
			if v:IsA("BasePart") then
				table.insert(t, {v, v.Massless})
				v.Massless = true
			end
		end
	end
	-- Apply Seat Handler
	for i, v in (Seats) do
		-- Sit Handler
		v.Seat.ChildAdded:Connect(function(child)
			if child.Name == "SeatWeld" and child:IsA("Weld") and child.Part1 and child.Part1.Parent ~= workspace and not child.Part1.Parent:IsDescendantOf(Vehicle) then
				v.Parts = {}
				getPProperties(child.Part1.Parent, v.Parts)
			end
		end)
		-- Leave Handler
		v.Seat.ChildRemoved:Connect(function(child)
			if child.Name == "SeatWeld" and child:IsA("Weld") then
				for i, v in (v.Parts) do
					if v[1] and v[1]:IsDescendantOf(workspace) then
						v[1].Massless = v[2]
					end
				end
				v.Parts = {}
			end
		end)
	end
end

--[[Driver Handling]]
-- Driver Sit
Vehicle.DriveSeat:SetNetworkOwner(nil)
Vehicle.DriveSeat.ChildAdded:connect(function(child)
	if child.Name == "SeatWeld" and child:IsA("Weld") and game.Players:GetPlayerFromCharacter(child.Part1.Parent) ~= nil then
		if _Settings.Lean then
			lean.MaxTorque = Vector3.new(0, 0, _Settings.LeanMaxTorque)
		end
		-- Distribute Client Interface
		local p = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
		Vehicle.DriveSeat:SetNetworkOwner(p)
		local mouseLockAlreadyEnabled = p.DevEnableMouseLock
		p.DevEnableMouseLock = false
		local g = script.Parent.Interface:Clone()
		g.Parent = p.PlayerGui
		if _Settings.ExitStop then
			local leave
			leave = Vehicle.DriveSeat.ChildRemoved:Connect(function(child)
				if child:IsA("Weld") and child.Name == "SeatWeld" then
					leave:Disconnect()
					for _, v in next, p.PlayerGui:GetChildren() do
						if v:IsA("ScreenGui") and v.Name == "Interface" then
							for _, v in next, v:GetDescendants() do
								if v:IsA("Script") then
									v.Disabled = true
								end
							end
							v:Destroy()
						end
					end
					Vehicle.DriveSeat:SetNetworkOwner(nil)
					p.DevEnableMouseLock = mouseLockAlreadyEnabled
				end
			end) -- Remove gui on the server to prevent possible memory buildup
		end
	end
end)

-- Driver Leave
Vehicle.DriveSeat.ChildRemoved:connect(function(child)
	if child.Name == "SeatWeld" and child:IsA("Weld") then
		-- Remove Flip Force
		if Vehicle.DriveSeat:FindFirstChild("Flip") ~= nil then
			Vehicle.DriveSeat.Flip.MaxTorque = Vector3.new()
		end
		-- Remove Wheel Force
		for i, v in next, Vehicle.Wheels:GetChildren() do
			if v:FindFirstChild("#AV") ~= nil then
				if v["#AV"]:IsA("BodyAngularVelocity") then
					if v["#AV"].AngularVelocity.Magnitude > 0 then
						v["#AV"].AngularVelocity = Vector3.new()
						v["#AV"].MaxTorque = Vector3.new()
					end
				else
					if v["#AV"].AngularVelocity > 0 then
						v["#AV"].AngularVelocity = 0
						v["#AV"].MotorMaxTorque = 1e9
					end
				end
			end
		end
		for _, wheel in Wheels do
			-- Readjust steering
			if wheel.Arm:FindFirstChild("Steer") then
				if wheel.Values.PowerSteeringType.Value == "New" then
					wheel.Arm.Steer.Attachment0.Orientation = Vector3.new(0, -wheel.Base.Rotate.CurrentAngle, 0)
				else
					wheel.Arm.Steer.CFrame = wheel.Base.CFrame * CFrame.Angles(0, math.rad(wheel.Base.Rotate.CurrentAngle), 0)
				end
			elseif wheel:FindFirstChild("SystemHub") then
				if wheel.SystemHub:FindFirstChild("Steer") then
					if wheel.Values.PowerSteeringType.Value == "New" then
						wheel.SystemHub.Steer.Attachment0.Orientation = Vector3.new(0, -wheel.Base.Rotate.CurrentAngle, 0)
					else
						wheel.SystemHub.Steer.CFrame = wheel.Base.CFrame * CFrame.Angles(0, math.rad(wheel.Base.Rotate.CurrentAngle), 0)
					end
				end
			end
		end
	end
end)

-- Allow entering the Vehicle now that everything is initialized.
script.Parent.Parent.DriveSeat.Disabled = false]]></ProtectedString>
