		<Item class="Script" referent="RBX3DE0979499534A40A5418BEF20FCE489">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[ Welcome, tuner.
    ____  ___
   / __ \/   | Entity
  / /_/ / /| | Roblox self propelled land vehicle chassis
 / __ _/ ___ | 0.51.4
/_/ |_/_/  |_| GitHub:    https://github.com/totallyahuman445/Roblox-Entity-RA
               Discord:   https://discord.gg/bS2A448Vrk
               Community: https://www.roblox.com/share/g/206794047
			   THE List:  https://docs.google.com/document/d/1WvOWw7ST4ZWpsCfXM3abJTTBkCA40NsayIEIdCRJOYM/edit?usp=sharing
			   Log:		  https://docs.google.com/document/d/1SLW5NOAysg2rE6C52WEPnmOas_MNbeVNEv0xv2f__ps/edit?usp=sharing
			   Credits:   https://docs.google.com/document/d/1-mIgEhmugHfVUDz4vzZMS7XYMoEdLKedy0MedRqvbyA/edit?usp=sharing
]]
-- Overrides
local SteerDisabled                   = false                         -- Removes steering for this wheel.
local ThrottleDisabled                = false                         -- Override to cut throttle for this wheel.
local EngineDisabled                  = false                         -- For a hybrid disable this for non engine powered wheels.
local ElectricDisabled                = false                         -- For a hybrid disable this for non electric powered wheels.
local HorsePowerLimitOverride         = false                         -- Give this wheel a different maximum HP limit.
	local HorsePowerLimitOverrideSet  = 0                             -- Local horsepower limit (set to 0 for no limit and enable HorsePowerLimitOverride to use).

--Effects
local SquealEnabled       		      = false                         -- Carbon ceramic or damaged brake squeal on that specific wheel.
local SmokeEnabled  	  		      = true                          -- Tyre smoke on that specific wheel.

--[[Friction]]                                                        -- It is recommended that you go to https://www.desmos.com/calculator/lhxwlpppyh to tune your vehicle's tyres.
local MaxFriction				      = .7				              -- Maximum friction of the tyres
local OffroadTolerance                = 1000                          -- More = less grip lost off-road, less = more grip lost off-road.

local MaxTemp					      = 100				              -- Maximum temperature of the tyres in celcius
local ColdStats	= {
			--[[Loss]]			        .1,                           -- Less means more base grip.
			--[[Sharpness]]		        11.7,
			--[[Offset]]		        .32}
local HotStats	= {
			--[[Loss]]			        1.56,
			--[[Sharpness]]		        18.3,
			--[[Offset]]		        1.05}

local DirtLoss					      = .1				              -- Friction loss from dirty tyres
local DirtFadeRate				      = .001				          -- The rate that dirt fades

local Heating					      = .01				              -- Heat gain from maximum slippage
local Cooling					      = .002				          -- Heat loss at no slippage
local SpeedStress				      = .04				              -- Stress generated at 100 km/h

--Alignment
local Camber 			  		      = -3  				          -- In degrees.
local Toe	 			  		      = 0				              -- In degrees.
local Caster 			 		      = 0				              -- In degrees.
 
--Unsprung Weight
local WheelWeight		  		      = 23	                          -- Wheel Weight in kg.

local AxleSize		      		      = 1.5                           -- Size of structural members (larger = MORE STABLE / carry more weight)
local AxleDensity		  		      = .25	                          -- Density of structural members

local CustomSuspensionDensity	      = .01		  		              -- Density of suspension joints, only applies to custom suspension (.0001 - 100)

--[[SUSpension]]
local SuspensionType 			      = "Double_Wishbone"             -- "Pullrod", "Pushrod", "Double_Wishbone", "MacPherson_Strut", "Trailing_Arm", "Front_Swingarm", "Rear_Swingarm", "Front_Triple_Tree", "Rear_Triple_Tree", "Front_2_Link_Solid_Axle", "Rear_2_Link_Solid_Axle", "Basic_Spring" and "None"
	local SuspensionDirectionOverride = false                         -- Overrides your suspension geometry so you can use the left wheel suspension geometry for a right wheel for example.
	local SuspensionOverrideDirection = "Left"                        -- Swap from "Right" to "Left".

local SusStiffness	 	 		      = 14.1	                      -- Spring force in kgf/mm
local SusDamping	 	 		      = 5000	                      -- Spring damping in kg/s
local SusLength		 	 	          = 1.2	                          -- Base spring height (in studs)
local PreCompress	     		      = .2	                          -- Adds to base spring height (in studs)
local ExtensionLim   	 		      = .5	                          -- Maximum extension travel (in studs)
local CompressLim	     		      = .3	                          -- Maximum compression travel (in studs)

local SuspensionRotate                = false                         -- Suspension rotates with the wheel (like the front wheel of motorcycles (use this with Triple_Tree suspension)).

local ProgressiveSprings              = false                         -- Enables progressive springs
--For progressive springs
local MinStiffness                    = SusStiffness                  -- Minimum spring force in kgf/mm
local MaxStiffness                    = SusStiffness + 2.4            -- Maximum spring force in kgf/mm
local MinSusDamping	 	 		      = SusDamping	                  -- Minimum spring damping in kg/s
local MaxSusDamping	 	 		      = SusDamping + 500	          -- Minimum spring damping in kg/s

--Basic spring settings
local SusAngle					      = 80				              -- Spring Angle (degrees from horizontal)

local WsBoneLen					      = 4				              -- Wishbone length
local WsBoneAngle				      = 0				              -- Wishbone angle (degrees from horizontal)

local AnchorOffset	= {								                  -- suspension anchor point offset (relative to center of wheel)
		   --[[Lateral]]		        -.4,			              -- positive = outward
	       --[[Vertical]]		        -.5,			              -- positive = upward
		   --[[Forward]]		        0}			                  -- positive = forward
		
local SpringOffset	= {								                  -- suspension anchor point offset (relative to ABOVE anchor offset)
		   --[[Lateral]]		        0,			                  -- positive = outward 
	       --[[Vertical]]		        0,			                  -- positive = upward
	       --[[Forward]]		        0}			                  -- positive = forward

--[[Wheel Stabilizer Gyro]]
local GyroDampening 			      = 50				              -- Suspension Gyro Dampening
local GyroDamp					      = 0			                  -- Wheel Non-Axial Dampening

-- Sway bar front
local SwayBarFrontEnabled      	      = false                          -- Enables the front sway bar (front as in mounted in the front for rear axles typically) (use both front and rear on solid axles) (disables on default gravity use 35.025 gravity, 2 road Friction and 3.5 road FrictionWeight for them to work best)
local SwayBarFrontLimitsEnabled       = true                          -- Allows control of the degrees of freedom for the sway bar, turn this off for the stiffest sway bar possible.
	local SwayBarBarFrontLimitAngle0  = 10                            -- Limits for the right angle in degrees for the front sway bar (lower is tighter).
	local SwayBarBarFrontLimitAngle1  = 10                            -- Limits for the right angle in degrees for the front sway bar (lower is tighter).

-- Sway bar rear
local SwayBarRearEnabled      	      = true                          -- Enables the rear sway bar (rear as in mounted in the rear for front axles typically) (use both front and rear on solid axles) (disables on default gravity use 35.025 gravity, 2 road Friction and 3.5 road FrictionWeight for them to work best)
local SwayBarRearLimitsEnabled        = true                          -- Allows control of the degrees of freedom for the sway bar, turn this off for the stiffest sway bar possible.
	 local SwayBarBarRearLimitAngle0  = 10                            -- Limits for the right angle in degrees for the rear sway bar (lower is tighter).
	 local SwayBarBarRearLimitAngle1  = 10                            -- Limits for the right angle in degrees for the rear sway bar (lower is tighter).

--[[Steering]]
-- Steer Tuning
local PowerSteeringType               = "Old"                         -- "New" uses AlignOrientation. This may cause problems.

local SteerRatio			          = 13 / 1		                  -- Steering ratio of your steering rack, search it for your vehicle.
local SteerPivot			          = .2		                      -- (Only for SuspensionRotate enabled) Forward/backward position of the steer pivot point
local LockToLock			          = 2.6		                      -- Number of turns of the steering wheel lock to lock, search it for your vehicle
local Ackerman			              = 1.1		                      -- If you don't know what it is don't touch it, ranges from .7 to 1.2
local SteerD					      = 950				              -- Steering Dampening
local SteerMaxTorque			      = 500000			              -- Steering Force
local SteerP					      = 15000			              -- Steering Aggressiveness

local MFreeWheel                      = false                         -- Allow a mid wheel to free wheel like a shopping cart.

-- Rear Wheel Steering
local FWSteer			              = "None"                        -- "Static", "Speed", "Both", or "None"

local RSteerOuter		              = 10		                      -- Outer rear wheel steering angle (in degrees)
local RSteerInner		              = 10		                      -- Inner rear wheel steering angle (in degrees)
local RSteerSpeed		              = 60		                      -- Speed at which RWS fully activates (Speed), deactivates (Static), or transition begins (Both) (km/h)

local RSteerD			              = 1000		                  -- Rear Steering Damping (old only)
local RSteerP			              = 5000	                      -- Rear Steering Aggressiveness (old only)
local RSteerMaxTorque	              = 20000	                      -- Rear Steering Force (old only)

-- New PowerSteeringType properties
local AlignmentMode                   = "TwoAttachment"               -- "TwoAttachment" and "OneAttachment" (Whether the constraint uses one or two attachments in calculating its goal.)
local AlignType                       = "AllAxes"                     -- Specifies the desired relationship between the primary axes of Attachment0 and the goal. Available options are "AllAxes", "PrimaryAxisParallel", "PrimaryAxisPerpendicular", and "PrimaryAxisLookAt".
local ReactionTorqueEnabled           = false                          -- If false, the constraint only applies torque to Attachment0 while Attachment1 remains unaffected. If true, the constraint applies torque to both attachments in equal and opposite directions.
local RigidityEnabled                 = false                         -- Whether the force is dependent on other properties, or if the physics solver reacts as quickly as possible to complete the alignment.

-- RigidityEnabled = false only
local MaxAngularVelocity              = 37e37                         -- Maximum angular velocity the constraint can use to reach its goal.
local MaxTorque                       = 1000000                       -- Steering Force for the "New" PowerSteeringType.
local Responsiveness                  = 50                            -- Controls how quickly the constraint reaches its goal. Higher values cause the attachment(s) to align more rapidly.

--[[Drivetrain]]
local DifferentialType                = "New"	                      -- New: Fairly precise and accurate settings based on a real differential, Old: Same differential as before A-Chassis C Version 1.4

local DiffPower					      = 20				              -- 0 - 100 Higher values yield more wheel lock-up under throttle, more stability (driven wheels only)
local DiffCoast					      = 20				              -- 0 - 100 Higher values yield more wheel lock-up when off throttle, more stability (driven wheels only)
local DiffPreload				      = 20				              -- 0 - 100 Higher values will make the wheels generally lock up faster in any environment (driven wheels only)

-- Old options
local DiffSlipThres	                  = 50		                      -- 1 - 100% (Max threshold of applying full lock determined by deviation from avg speed)
local DiffLockThres	                  = 50		                      -- 0 - 100% (0 - Bias toward slower wheel, 100 - Bias toward faster wheel)
local CDiffSlipThres	              = 50		                      -- 1 - 100% [AWD Only]
local CDiffLockThres	              = 50		                      -- 0 - 100% [AWD Only]

-- Driver assists
local ABSLimit		                  = 0			                  -- Minimum amount of torque at max reduction (in percent).
local ABSThreshold	                  = 7							  -- Slip speed allowed before ABS starts working (in km/h).

local TCSThreshold	                  = 10		                      -- Slip speed allowed before TCS starts working (in km/h).
local TCSGradient	                  = 20		                      -- Slip speed gradient between 0 to max reduction (in km/h).
local TCSLimit		                  = 6		                      -- Minimum amount of torque at max reduction (in percent).

local ESCGyroscope                    = false                         -- Gyroscopic ESC.
local ESCReverse		              = true		                  -- If true, this also activates ESC in reverse. This may cause problems.
local ESCVector		                  = -.2		                      -- Force from the front to the rear for ESC. "-1" has a 100% front bias, "0" has a 50:50 bias, and "1" has a 100% rear bias. Can be any number between that range.
local ESCThreshold	                  = .8		                      -- Force difference in Gs before ESC starts working.
local ESCSpeed		                  = 20		                      -- Minimum speed before ESC can work in km/h.
local ESCThrottle	                  = 50		                      -- Maximum amount of throttle allowed to ESC in percent. (0 to allow no throttle)
local ESCBrake		                  = 50		                      -- Maximum amount of brakes allowed to ESC in percent. (0 to allow no brakes)

local CSAmt				              = 100		                      -- Amount of countersteering at a full perpendicular slide (in percent)
local CSSteerThresh		              = 10		                      -- Threshold before countersteering activates (in percent)
local CSSpeedThresh		              = 10		                      -- Speed threshold before countersteering can activate (in km/h)

--[[Braking]]
local BrakeForce		              = 1200						  -- Total brake force in kgf
local PBrakeForce	                  = 1500						  -- Handbrake force in kgf
local EBrakeForce		              = 172							  -- Engine braking force at redline in kgf

--Brake fade
local BrakeCooling                    = .019
local BrakeCoolingSpeed               = 1 							  -- In seconds, lower is faster.
local BrakeHeatingSpeed               = .075
local MaxBrakeTemp                    = 330     					  -- The maximum temperature the brake can handle.
local BrakeReductionStress            = 12500  						  -- Higher is slower loss of brakes.

--[[Tyre Flex]]
local TyreFlex					      = true				          -- Uses a separate collision to simulate tyre flex. When using no collision constraints make your mesh can collide off to get and the chassis will automatically enable collisions.

local PressureForce			          = 22				              -- Pressure force (no unit).
local TyreThickness			          = 50				              -- Tyre sidewall thickness in milimeters.
local TyreWeight				      = 9			   	              -- Tyre weight in kg.

--[[Aesthetics]]                                                      -- (only for Basic_Spring geometry, edit geometry in studio for other geometries)
local SmokeColorStep1                 = Color3.fromRGB(211, 211, 211) -- The Color of the smoke after it's generated.
local SmokeColorStep2                 = Color3.fromRGB(255, 255, 255) -- The Color of the smoke before it disappears.

local TyreMarkTransparencyLevels      = 8				              -- How many levels of transparency there are (0 for no marks)
local TyreMarkTransparency		      = .95				              -- The transparency of the tyre marks

local wheelparent = script.Parent
local wheelvalues = wheelparent.Values
local wheeltype = script.Parent.Name
local Wheels = script.Parent.Parent
local _Settings = require(script.Parent.Parent.Parent.Settings)
local Units = require(script.Parent.Parent.Parent.Settings.Units)
local vehicle = script.Parent.Parent.Parent.Settings.Interface.Vehicle.Value
local children = Wheels:GetChildren()
local number_of_wheels = #children
local TweenService  = game:GetService("TweenService")
local susgeos = wheelparent:FindFirstChild("SuspensionGeometries")
local neighbour = wheelvalues:FindFirstChild("NeighbouringWheel")
if neighbour.Value then
	susgeos_n = neighbour.Value:FindFirstChild("SuspensionGeometries")
end

if workspace.Gravity > 196.1 and workspace.Gravity < 196.3 then -- Jupiter warning
	MaxFriction = MaxFriction / 2
	CustomSuspensionDensity = CustomSuspensionDensity * 100
	SwayBarFrontEnabled = false
	SwayBarRearEnabled = false
	SusLength = SusLength * 1.17
	PressureForce = PressureForce * 3
end

wheelvalues.CustomSuspensionDensity.Value = CustomSuspensionDensity
wheelvalues.MaxFriction.Value = MaxFriction
wheelvalues.PressureForce.Value = PressureForce
wheelvalues.OffroadTolerance.Value = OffroadTolerance

wheelvalues.Camber.Value = Camber
wheelvalues.Toe.Value = Toe
wheelvalues.Caster.Value = Caster
wheelvalues.WheelWeight.Value = WheelWeight

wheelvalues.MaxTemp.Value = MaxTemp
wheelvalues.ColdStats.Value = Vector3.new(ColdStats[1], ColdStats[2], ColdStats[3])
wheelvalues.HotStats.Value = Vector3.new(HotStats[1], HotStats[2], HotStats[3])
wheelvalues.DirtLoss.Value = DirtLoss
wheelvalues.DirtFadeRate.Value = DirtFadeRate
wheelvalues.Heating.Value = Heating
wheelvalues.Cooling.Value = Cooling
wheelvalues.SpeedStress.Value = SpeedStress

if SuspensionType == "Basic_Spring" then
	wheelparent.SuspensionGeometries:Destroy()
	wheelvalues.SusAngle.Value = SusAngle
	wheelvalues.WsBoneLen.Value = WsBoneLen
	wheelvalues.WsBoneAngle.Value = WsBoneAngle
	wheelvalues.AnchorOffset.Value = CFrame.new(AnchorOffset[1], AnchorOffset[2], AnchorOffset[3])
	wheelvalues.SpringOffset.Value = CFrame.new(SpringOffset[1], SpringOffset[2], SpringOffset[3])
else
	for i, v in pairs(wheelparent.SuspensionGeometries:GetChildren()) do
		if not SuspensionDirectionOverride then
			if not SuspensionDirectionOverride and wheeltype == "FR" or wheeltype == "F" or wheeltype == "MR" or wheeltype == "M" or wheeltype == "RR" or wheeltype == "R" then
				if v.Name == "R_"..SuspensionType then
					v.Name = "SuspensionGeometry"
				else
					v:destroy()
				end
			elseif not SuspensionDirectionOverride and string.sub(wheeltype, 2, 2) == "L" then
				if v.Name == "L_"..SuspensionType then
					v.Name = "SuspensionGeometry"
				else
					v:destroy()
				end
			end
		else
			if SuspensionDirectionOverride and SuspensionOverrideDirection == "Right" then
				if v.Name == "R_"..SuspensionType then
					v.Name = "SuspensionGeometry"
				else
					v:destroy()
				end
			elseif SuspensionDirectionOverride and SuspensionOverrideDirection == "Left" then
				if v.Name == "L_"..SuspensionType then
					v.Name = "SuspensionGeometry"
				else
					v:destroy()
				end
			end
		end
	end
end

if SuspensionType == "None" then
	SuspensionEnabled = false
else
	SuspensionEnabled = true
end

wheelvalues.SuspensionEnabled.Value = SuspensionEnabled
wheelvalues.SusStiffness.Value = SusStiffness
wheelvalues.SusDamping.Value = SusDamping
wheelvalues.SusLength.Value = SusLength
wheelvalues.PreCompress.Value = PreCompress
wheelvalues.ExtensionLim.Value = ExtensionLim
wheelvalues.CompressLim.Value = CompressLim
wheelvalues.AxleSize.Value = AxleSize
wheelvalues.AxleDensity.Value = AxleDensity

wheelvalues.SuspensionRotate.Value = SuspensionRotate

wheelvalues.ProgressiveSprings.Value = ProgressiveSprings
wheelvalues.MinStiffness.Value = MinStiffness
wheelvalues.MaxStiffness.Value = MaxStiffness
wheelvalues.MinSusDamping.Value = MinSusDamping
wheelvalues.MaxSusDamping.Value = MaxSusDamping

wheelvalues.GyroDampening.Value = GyroDampening
wheelvalues.GyroDamp.Value = GyroDamp

wheelvalues.SteerRatio.Value = SteerRatio
wheelvalues.SteerPivot.Value = SteerPivot
wheelvalues.LockToLock.Value = LockToLock
wheelvalues.Ackerman.Value = Ackerman

wheelvalues.SteerD.Value = SteerD
wheelvalues.SteerMaxTorque.Value = SteerMaxTorque
wheelvalues.SteerP.Value = SteerP

wheelvalues.MFreeWheel.Value = MFreeWheel

wheelvalues.PowerSteeringType.Value = PowerSteeringType
wheelvalues.SteerDisabled.Value = SteerDisabled
wheelvalues.ThrottleDisabled.Value = ThrottleDisabled
wheelvalues.EngineDisabled.Value = EngineDisabled
wheelvalues.ElectricDisabled.Value = ElectricDisabled
wheelvalues.HorsePowerLimitOverride.Value = HorsePowerLimitOverride
wheelvalues.HorsePowerLimitOverrideSet.Value = HorsePowerLimitOverrideSet

wheelvalues.FWSteer.Value = FWSteer
wheelvalues.RSteerOuter.Value = RSteerOuter
wheelvalues.RSteerInner.Value = RSteerInner
wheelvalues.RSteerSpeed.Value = RSteerSpeed
wheelvalues.RSteerD.Value = RSteerD
wheelvalues.RSteerP.Value = RSteerP
wheelvalues.RSteerMaxTorque.Value = RSteerMaxTorque

wheelvalues.AlignmentMode.Value = AlignmentMode
wheelvalues.AlignType.Value = AlignType
wheelvalues.ReactionTorqueEnabled.Value = ReactionTorqueEnabled
wheelvalues.RigidityEnabled.Value = RigidityEnabled
wheelvalues.MaxAngularVelocity.Value = MaxAngularVelocity
wheelvalues.MaxTorque.Value = MaxTorque
wheelvalues.Responsiveness.Value = Responsiveness

wheelvalues.DifferentialType.Value = DifferentialType

wheelvalues.DiffPower.Value = DiffPower
wheelvalues.DiffCoast.Value = DiffCoast
wheelvalues.DiffPreload.Value = DiffPreload

wheelvalues.DiffSlipThres.Value = DiffSlipThres
wheelvalues.DiffLockThres.Value = DiffLockThres
wheelvalues.CDiffSlipThres.Value = CDiffSlipThres
wheelvalues.CDiffLockThres.Value = CDiffLockThres

wheelvalues.ABSLimit.Value = ABSLimit
wheelvalues.ABSThreshold.Value = ABSThreshold

wheelvalues.TCSThreshold.Value = TCSThreshold
wheelvalues.TCSGradient.Value = TCSGradient
wheelvalues.TCSLimit.Value = TCSLimit

wheelvalues.ESCGyroscope.Value = ESCGyroscope
wheelvalues.ESCReverse.Value = ESCReverse
wheelvalues.ESCVector.Value = ESCVector
wheelvalues.ESCThreshold.Value = ESCThreshold
wheelvalues.ESCSpeed.Value = ESCSpeed
wheelvalues.ESCThrottle.Value = ESCThrottle
wheelvalues.ESCBrake.Value = ESCBrake

wheelvalues.CSAmt.Value = CSAmt
wheelvalues.CSSteerThresh.Value = CSSteerThresh
wheelvalues.CSSpeedThresh.Value = CSSpeedThresh

wheelvalues.BrakeForce.Value = BrakeForce
wheelvalues.PBrakeForce.Value = PBrakeForce
wheelvalues.EBrakeForce.Value = EBrakeForce

wheelvalues.BrakeCooling.Value = BrakeCooling
wheelvalues.BrakeCoolingSpeed.Value = BrakeCoolingSpeed
wheelvalues.BrakeHeatingSpeed.Value = BrakeHeatingSpeed
wheelvalues.MaxBrakeTemp.Value = MaxBrakeTemp
wheelvalues.BrakeReductionStress.Value = BrakeReductionStress

wheelvalues.Squeal.Value = SquealEnabled
wheelvalues.Smoke.Value = SmokeEnabled
wheelvalues.TyreMarkTransparencyLevels.Value = TyreMarkTransparencyLevels
wheelvalues.TyreMarkTransparency.Value = TyreMarkTransparency
wheelvalues.SmokeColorSequence.Value = SmokeColorStep1
wheelvalues.SmokeColorSequence2.Value = SmokeColorStep2

wheelvalues.TyreFlex.Value = TyreFlex
wheelvalues.TyreThickness.Value = TyreThickness
wheelvalues.TyreWeight.Value = TyreWeight

wheelvalues.WheelBrakeTemp.Value = _Settings.Temperature

if wheelparent:IsA("BasePart") then
	if wheelparent.CustomPhysicalProperties == nil then
		wheelparent.CustomPhysicalProperties = PhysicalProperties.new(wheelparent.Material)
	end
	wheelparent.CustomPhysicalProperties = PhysicalProperties.new(
		(WheelWeight * Units.Mass_kg) / (math.pi * (wheelparent.Size.Y / 2) ^ 2 * (wheelparent.Size.X)),
		wheelparent.CustomPhysicalProperties.Friction,
		wheelparent.CustomPhysicalProperties.Elasticity,
		2,
		wheelparent.CustomPhysicalProperties.ElasticityWeight
	)
end

if wheeltype == "F" or wheeltype == "M" or wheeltype == "R" then
	neighbour:Destroy()
end

if string.sub(wheeltype, 2, 2) == "R" and susgeos and susgeos_n and SwayBarRearEnabled or SwayBarFrontEnabled then
	task.wait(.25)
	if susgeos then
		if susgeos:FindFirstChild("SuspensionGeometry") then
			RSwayBar = susgeos.SuspensionGeometry.Constraints:FindFirstChild("RSwayBar")
			FSwayBar = susgeos.SuspensionGeometry.Constraints:FindFirstChild("FSwayBar")
			RSwayBar0 = susgeos.SuspensionGeometry.Constraints:FindFirstChild("RSwayBar0")
			FSwayBar0 = susgeos.SuspensionGeometry.Constraints:FindFirstChild("FSwayBar0")
		end
	end
	if susgeos_n then
		if susgeos_n:FindFirstChild("SuspensionGeometry") then
			task.wait(.25)
			RSwayBar1 = susgeos_n.SuspensionGeometry.Constraints:FindFirstChild("RSwayBar1")
			FSwayBar1 = susgeos_n.SuspensionGeometry.Constraints:FindFirstChild("FSwayBar1")
			if RSwayBar and SwayBarFrontEnabled then
				RSwayBar.Enabled = true
				RSwayBar.Attachment0 = RSwayBar0.Value
				RSwayBar.Attachment1 = RSwayBar1.Value
				if SwayBarRearLimitsEnabled then
					RSwayBar.LimitsEnabled = SwayBarRearLimitsEnabled
					RSwayBar.LimitAngle0 = SwayBarBarRearLimitAngle0
					RSwayBar.LimitAngle1 = SwayBarBarRearLimitAngle1
				end
			end
			if FSwayBar and SwayBarRearEnabled then
				FSwayBar.Enabled = true 
				FSwayBar.Attachment0 = FSwayBar0.Value
				FSwayBar.Attachment1 = FSwayBar1.Value
				if SwayBarFrontLimitsEnabled then
					FSwayBar.LimitsEnabled = SwayBarFrontLimitsEnabled
					FSwayBar.LimitAngle0 = SwayBarBarFrontLimitAngle0
					FSwayBar.LimitAngle1 = SwayBarBarFrontLimitAngle1
				end
			end
		end
	end
end

local value = _Settings.Weight / number_of_wheels
local Debounce = false
if _Settings.RunningOver then
	script.Parent.WheelFixed.WheelBottom.Touched:connect(function(hit)
		if not Debounce then
			if hit and hit.Parent and hit.Parent:FindFirstChild("Humanoid") then
				hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - value / 7.5
				Debounce = true
				task.wait(2) -- Change cooldown here.
				Debounce = false
			end
		end
	end)
end]]></ProtectedString>
