						<Item class="LocalScript" referent="RBX21F6558DDD12415F826632A0272FBBA5">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")

local Vehicle = script.Parent.Parent.Parent.Vehicle.Value
local Velocity = script.Parent.Parent.Parent.Values.Velocity
local ReadyReset = script.Parent.ReadyReset
local Timer = script.Parent.Timer
local BotColor = script.Parent.Bot

script.Parent.Active = true
script.Parent.Draggable = true

local TReady = false
local Started = false
local StartTime = nil

local function updateTimer()
	Timer.Text = math.floor((os.clock() - StartTime) * 1000) / 1000
	if (11 / 12) * 1.09728 * Velocity.Value.Magnitude >= 100 then
		RunService:UnbindFromRenderStep("60Timer")
		ReadyReset.Text = "RESET"
		BotColor.ImageColor3 = Color3.fromRGB(242, 160, 0)
	end
end

Velocity.Changed:Connect(function(value)
	if not Started and TReady and value.Magnitude * (11 / 12) * 1.09728 > 1 then
		Started = true
		StartTime = os.clock()
		RunService:BindToRenderStep("60Timer", 100, updateTimer)
	end
end)

ReadyReset.MouseButton1Click:Connect(function()
	if TReady then
		RunService:UnbindFromRenderStep("60Timer")
		ReadyReset.Text = "READY"
		BotColor.ImageColor3 = Color3.fromRGB(242, 160, 0)
		Started = false
		Timer.Text = "0.000"
		TReady = not TReady
	elseif not TReady and (11 / 12) * 1.09728 * Velocity.Value.Magnitude < 1 then
		ReadyReset.Text = "CANCEL"
		BotColor.ImageColor3 = Color3.fromRGB(100, 0, 0)
		TReady = not TReady
	elseif not TReady and (11 / 12) * 1.09728 * Velocity.Value.Magnitude >= 1 then
		ReadyReset.Text = "SLOW DOWN"
		BotColor.ImageColor3 = Color3.fromRGB(150, 50, 0)
		spawn(function()
			repeat task.wait() until (11 / 12) * 1.09728 * Velocity.Value.Magnitude < 1
			ReadyReset.Text = "READY"
			BotColor.ImageColor3 = Color3.fromRGB(242, 160, 0)
		end)
	end
end)

ReadyReset.MouseButton1Click:Connect(function()
	RunService:UnbindFromRenderStep("60Timer")
	Started = false
	Timer.Text = "0.000"
end)

Vehicle.DriveSeat.ChildRemoved:Connect(function()
	RunService:UnbindFromRenderStep("60Timer")
end)]]></ProtectedString>
