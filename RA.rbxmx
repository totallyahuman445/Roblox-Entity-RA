			FSwayBar1 = susgeos_n.SuspensionGeometry.Constraints:FindFirstChild("FSwayBar1")
			if RSwayBar and SwayBarFrontEnabled then
				RSwayBar.Enabled = true
				RSwayBar.Attachment0 = RSwayBar0.Value
				RSwayBar.Attachment1 = RSwayBar1.Value
				if SwayBarRearLimitsEnabled then
					RSwayBar.LimitsEnabled = SwayBarRearLimitsEnabled
					RSwayBar.LimitAngle0 = SwayBarBarRearLimitAngle0
					RSwayBar.LimitAngle1 = SwayBarBarRearLimitAngle1
				end
			end
			if FSwayBar and SwayBarRearEnabled then
				FSwayBar.Enabled = true 
				FSwayBar.Attachment0 = FSwayBar0.Value
				FSwayBar.Attachment1 = FSwayBar1.Value
				if SwayBarFrontLimitsEnabled then
					FSwayBar.LimitsEnabled = SwayBarFrontLimitsEnabled
					FSwayBar.LimitAngle0 = SwayBarBarFrontLimitAngle0
					FSwayBar.LimitAngle1 = SwayBarBarFrontLimitAngle1
				end
			end
		end
	end
end

local value = _Settings.Weight / number_of_wheels
local Debounce = false
if _Settings.RunningOver then
	script.Parent.WheelFixed.WheelBottom.Touched:connect(function(hit)
		if not Debounce then
			if hit and hit.Parent and hit.Parent:FindFirstChild("Humanoid") then
				hit.Parent.Humanoid.Health = hit.Parent.Humanoid.Health - value / 7.5
