					<Item class="Script" referent="RBX0012CED147EA4C169DCCBD202CAFD387">
						<Properties>
							<ProtectedString name="Source"><![CDATA[task.wait(1)
local vehicle = script.Parent.Values.Vehicle.Value
repeat task.wait() until vehicle ~= nil
local RunService = game:GetService("RunService")
local Seat = script.Parent
local connection = nil

local function calculateSpeed(new)
	return new.Magnitude * .994193
end

local occupant = nil

if Seat.Occupant and not occupant then
	occupant = Seat.Occupant
	local last_time = os.time()
	connection = RunService.Stepped:Connect(function(delta)
		local cur_time = os.time()
		if cur_time - last_time >= 1 then
			last_time = cur_time
		end
	end)
end

Seat.Changed:Connect(function(property)
	if property == "Occupant" then
		if Seat.Occupant and not occupant then
			occupant = Seat.Occupant
			local last_time = os.time()
			connection = RunService.Stepped:Connect(function(delta)
				local cur_time = os.time()
				if cur_time - last_time >= 1 then
					last_time = cur_time
				end
			end)
		elseif not Seat.Occupant and occupant then
			if vehicle.DriveSeat.Velocity.Magnitude * .994193 > 19 then
				occupant:TakeDamage(vehicle.DriveSeat.Velocity.Magnitude * .994193)
				occupant = nil
				connection:Disconnect()
				connection = nil
			end
		end
	end
end)]]></ProtectedString>
