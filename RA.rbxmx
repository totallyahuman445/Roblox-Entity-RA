				<Item class="LocalScript" referent="RBX7AF9FEC402504FCE9F5A2B31A6CCC3A1">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--[[ Welcome, tuner.
    ____  ___
   / __ \/   | Entity
  / /_/ / /| | Roblox self propelled land vehicle chassis
 / __ _/ ___ | 0.51.4
/_/ |_/_/  |_| GitHub:    https://github.com/totallyahuman445/Roblox-Entity-RA
               Discord:   https://discord.gg/bS2A448Vrk
               Community: https://www.roblox.com/share/g/206794047
			   THE List:  https://docs.google.com/document/d/1WvOWw7ST4ZWpsCfXM3abJTTBkCA40NsayIEIdCRJOYM/edit?usp=sharing
			   Log:		  https://docs.google.com/document/d/1SLW5NOAysg2rE6C52WEPnmOas_MNbeVNEv0xv2f__ps/edit?usp=sharing
			   Credits:   https://docs.google.com/document/d/1-mIgEhmugHfVUDz4vzZMS7XYMoEdLKedy0MedRqvbyA/edit?usp=sharing
]]
-- Settings
local Settings = {
	CAMERA_MODES = 1, -- Starts at 0, increase to have room for other view modes handled by external camera scripts. (0 is third person and 1 is freecam)

	TOP_SPEED_THRESHOLD = 300,

	ORIGIN_OFFSET_X = 0,
	ORIGIN_OFFSET_Y = 3,
	ORIGIN_OFFSET_Z = 0,

	OFFSET_Y = 3.5,

	OFFSET_MIN = 22, -- studs magnitude
	OFFSET_MAX = 22,
	OFFSET_GROWTH = 0, -- studs per unit velocity

	ROTATION_SPEED = 4.4,

	MANUAL_ROTATION_MIN = -math.pi / 3,
	MANUAL_ROTATION_MAX = 4 * math.pi / 3,
	MANUAL_ROTATION_SPEED = .05,

	TILT_MAX = math.pi / 15,
	TILT_SPEED = .2,
	TILT_RETURN_SPEED = 1,

	VERTICAL_FREQ = 12,
	VERTICAL_DAMP = .35,

	WIND_SHAKE_FREQUENCY_MAX = .6, -- Speed of camera shake
	WIND_SHAKE_FREQUENCY_GROWTH = .00004, -- How speed of camera shake increases with speed
	WIND_SHAKE_AMPLITUDE_MAX = .15, -- Camera Shake Max
	WIND_SHAKE_AMPLITUDE_GROWTH = .00006, -- How much camera shake increases with speed

	COLLISION_BUMP_MAX = 0,
	COLLISION_BUMP_GROWTH = .0008,
	COLLISION_BUMP_THRESHOLD = 600,
	COLLISION_BUMP_DELAY = .07,
	COLLISION_BUMP_FREQ = 15,
	COLLISION_BUMP_DAMP = .3
}

-- Services and instances
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TextChatService = game:GetService("TextChatService")

local Player = game:GetService("Players").LocalPlayer
local Camera = workspace.CurrentCamera
local vehicle = script.Parent:WaitForChild("Vehicle").Value
local DriverSeat = vehicle.DriveSeat
local Values = script.Parent:WaitForChild("Values")
local _Settings = require(vehicle.Settings)
local ChatInputBarConfiguration = TextChatService.ChatInputBarConfiguration
local viewMode = 0
local mouseon = false

local currentGear = Values.Gear.Value

local rotatingManually = false

local forwardVelocity = 0
local horizontalVelocity = 0

local collisionBump = 0
local collisionBumpTarget = 0
local collisionBumpVelocity = 0
local collisionBumpTimestamp

local mousePositionX = 0
local mousePositionY = 0

local Rotation = math.pi / 2
local RotationTarget -- only used for manual rotation
local Tilt = 0

local Offset = Settings.OFFSET_MIN
local OffsetTarget = Settings.OFFSET_MIN
local OffsetVelocity = 0

local VerticalVelocity = 0
local VerticalPosition = DriverSeat.Position.Y

local ox, oy, oz, oxx, oyx, ozx, oxy, oyy, ozy, oxz, oyz, ozz = CFrame.new().components(DriverSeat.CFrame)
local cx, cy, cz, cxx, cyx, czx, cxy, cyy, czy, cxz, cyz, czz = ox, oy, oz, oxx, oyx, ozx, oxy, oyy, ozy, oxz, oyz, ozz

local function updateSpring(dt, position, target, velocity, dampening, frequency)
	local x = position - target
	local omegaZeta = frequency * dampening
	local alpha = frequency * math.sqrt(1 - dampening * dampening)
	local exp = math.exp(-dt * omegaZeta)
	local cos = math.cos(dt * alpha)
	local sin = math.sin(dt * alpha)
	local c2 = (velocity + x * omegaZeta) / alpha
	local newPosition = target + exp * (x * cos + c2 * sin)
	local newVelocity = -exp * ((x * omegaZeta - c2 * alpha) * cos + (x * alpha + c2 * omegaZeta) * sin)
	return newPosition, newVelocity
end

local function isFinite(k)
	return(k == k and k ~= math.huge and k ~= -math.huge)
end

local function getYAngleBetween(x1, z1, x2, z2)
	return(math.atan2(x2 * z1 - z2 * x1, x2 * x1 + z2 * z1))
end

UserInputService.InputEnded:connect(function(inputObject, inputProcessed)
	if inputObject.UserInputType == Enum.UserInputType.MouseButton2 then
		rotatingManually = false
	end
end)

UserInputService.InputChanged:connect(function(inputObject, inputProcessed)
	if inputObject.UserInputType == Enum.UserInputType.MouseMovement then
		if rotatingManually then
			local newMousePosition = UserInputService:GetMouseLocation()
			if viewMode == 0 then
				RotationTarget = Rotation + Settings.MANUAL_ROTATION_SPEED * (newMousePosition.X - mousePositionX)
			end
			mousePositionX = newMousePosition.X
			mousePositionY = newMousePosition.Y
		end
	end
end)

local function updateManualRotation(dt)
	Rotation = Rotation + dt * Settings.ROTATION_SPEED * (RotationTarget - Rotation)
	VerticalPosition = oy
end

local function updateDynamicRotation(dt)
	local velocity = DriverSeat.Velocity
	local vx, vy, vz = velocity.X, velocity.Y, velocity.Z
	local speed = math.sqrt(vx * vx + vy * vy + vz * vz)
	local newForwardVelocity = (vx * ozx + vy * ozy + vz * ozz) * -1
	local newHorizontalVelocity = vx * oxx + vy * oxy + vz * oxz
	local forwardAcceleration = (newForwardVelocity - forwardVelocity) / dt
	local horizontalAcceleration = (newHorizontalVelocity - horizontalVelocity) / dt
	forwardVelocity = newForwardVelocity
	horizontalVelocity = newHorizontalVelocity
	if viewMode == 0 then
		-- Handle verticle damping
		local rxd = VerticalPosition - oy
		local omz = Settings.VERTICAL_FREQ * Settings.VERTICAL_DAMP
		local alp = Settings.VERTICAL_FREQ * math.sqrt(1 - Settings.VERTICAL_DAMP * Settings.VERTICAL_DAMP)
		local exp = math.exp(-dt * omz)
		local cos = math.cos(dt * alp)
		local sin = math.sin(dt * alp)
		local c2 = (VerticalVelocity + rxd * omz) / alp
		VerticalPosition = oy + exp * (rxd * cos + c2 * sin)
		VerticalVelocity = -exp * ((rxd * omz - c2 * alp) * cos + (rxd * alp + c2 * omz) * sin)
		oy = VerticalPosition
		-- Handle collision bumps
		if (collisionBumpTimestamp ~= nil) and (tick() - collisionBumpTimestamp > Settings.COLLISION_BUMP_DELAY) then
			if (collisionBump < collisionBumpTarget) then
				collisionBump = math.min(collisionBumpTarget, collisionBump + dt * 12)
			elseif (collisionBump > collisionBumpTarget) then
				collisionBump = math.max(collisionBumpTarget, collisionBump - dt * 12)
			else
				collisionBumpTarget = 0
				collisionBumpTimestamp = nil
			end
		elseif (collisionBumpTimestamp == nil) then
			-- Move toward 0 with spring
			local rxd = collisionBump - collisionBumpTarget
			local omz = Settings.COLLISION_BUMP_FREQ * Settings.COLLISION_BUMP_DAMP
			local alp = Settings.COLLISION_BUMP_FREQ * math.sqrt(1 - Settings.COLLISION_BUMP_DAMP * Settings.COLLISION_BUMP_DAMP)
			local exp = math.exp(-dt * omz)
			local cos = math.cos(dt * alp)
			local sin = math.sin(dt * alp)
			local c2 = (collisionBumpVelocity + rxd * omz) / alp
			collisionBump = collisionBumpTarget + exp * (rxd * cos + c2 * sin)
			collisionBumpVelocity = -exp * ((rxd * omz - c2 * alp) * cos + (rxd * alp + c2 * omz) * sin)
			-- Check if we have a new collision
			if (horizontalAcceleration > Settings.COLLISION_BUMP_THRESHOLD) then
				collisionBumpVelocity = 0
				collisionBumpTarget = math.min(Settings.COLLISION_BUMP_MAX, horizontalAcceleration * Settings.COLLISION_BUMP_GROWTH)
				collisionBumpTimestamp = tick()
			elseif (horizontalAcceleration < -Settings.COLLISION_BUMP_THRESHOLD) then
				collisionBumpVelocity = 0
				collisionBumpTarget = math.max(-Settings.COLLISION_BUMP_MAX, horizontalAcceleration * Settings.COLLISION_BUMP_GROWTH)
				collisionBumpTimestamp = tick()
			end
		end
		ox = ox + collisionBump * oxx
		oy = oy + collisionBump * .5
		oz = oz + collisionBump * oxz
		-- Apply wind shake
		local amplitude = math.min(Settings.WIND_SHAKE_AMPLITUDE_MAX, newForwardVelocity * Settings.WIND_SHAKE_AMPLITUDE_GROWTH)
		local frequency = math.min(Settings.WIND_SHAKE_FREQUENCY_MAX, newForwardVelocity * Settings.WIND_SHAKE_FREQUENCY_GROWTH)
		local t = tick()
		ox = ox + amplitude * math.cos(frequency * t)
		oy = oy + amplitude * math.sin(frequency * t)
		oz = oz + amplitude * math.cos(frequency * t)
	end
	-- Set Offset
	if (DriverSeat.Throttle == - 1) then
		OffsetTarget = Settings.OFFSET_MIN * .95
		Offset = Offset + dt * 2.5 * (OffsetTarget - Offset)
	elseif newForwardVelocity < Settings.TOP_SPEED_THRESHOLD and forwardAcceleration < 0 then
		OffsetTarget = Settings.OFFSET_MIN
		Offset = Offset + dt * 2 * (OffsetTarget - Offset)
	else
		OffsetTarget = math.min(Settings.OFFSET_MAX, Settings.OFFSET_MIN + Settings.OFFSET_GROWTH * speed)
		Offset = Offset + dt * 2.5 * (OffsetTarget - Offset)
	end
	-- Rotation and Tilt
	if speed > 1 and DriverSeat.Steer == 1 then
		Tilt = Tilt + dt * Settings.TILT_SPEED * (Settings.TILT_MAX - Tilt) * (Settings.TILT_MAX - Tilt)
	elseif speed > 1 and DriverSeat.Steer == -1 then
		Tilt = Tilt - dt * Settings.TILT_SPEED * (Settings.TILT_MAX + Tilt) * (Settings.TILT_MAX + Tilt)
	else
		Tilt = Tilt - dt * Settings.TILT_RETURN_SPEED * Tilt
	end
	local rotationOffset = getYAngleBetween(-ozx, -ozz, -czx, -czz)
	if (isFinite(rotationOffset) and math.abs(rotationOffset) > .0001) then
		Rotation = Rotation + rotationOffset * dt * Settings.ROTATION_SPEED
	end
end

local function update(dt)
	-- Fix up the origin axis
	local ozm = math.sqrt(ozx * ozx + ozz * ozz)
	ozx, ozy, ozz = ozx / ozm, 0, ozz / ozm
	oyx, oyy, oyz = 0, 1, 0
	-- Get new right vector
	oxx = ozz
	oxy = 0
	oxz = -ozx
	-- Adjust trail origin
	ox = ox + Settings.ORIGIN_OFFSET_X * oxx + Settings.ORIGIN_OFFSET_Z * ozx
	oy = oy + Settings.ORIGIN_OFFSET_Y
	oz = oz + Settings.ORIGIN_OFFSET_X * oxz + Settings.ORIGIN_OFFSET_Z * ozz
	-- Set Camera Back Vector
	czx = math.cos(Rotation) * Offset
	czy = Settings.OFFSET_Y
	czz = math.sin(Rotation) * Offset
	local czm = math.sqrt(czx * czx + czy * czy + czz * czz)
	czx, czy, czz = czx / czm, czy / czm, czz / czm
	-- Set camera right vector
	cxx = math.sin(Rotation)
	cxy = 0
	cxz = -math.cos(Rotation)
	-- Rotate Camera Right Vector(tilt)
	cxx = cxx * math.cos(Tilt) + (czy * cxz) * math.sin(Tilt)
	cxy = (czz * cxx - czx * cxz) * math.sin(Tilt)
	cxz = cxz * math.cos(Tilt) - (czy * cxx) * math.sin(Tilt)
	local cxm = math.sqrt(cxx * cxx + cxy * cxy + cxz * cxz)
	cxx, cxy, cxz = cxx / cxm, cxy / cxm, cxz / cxm
	-- Set Camera Up Vector
	cyx = czy * cxz - czz * cxy
	cyy = czz * cxx - czx * cxz
	cyz = czx * cxy - czy * cxx
	local cym = math.sqrt(cyx * cyx + cyy * cyy + cyz * cyz)
	cyx, cyy, cyz = cyx / cym, cyy / cym, cyz / cym
	-- Set Camera Position
	cx = ox + czx * czm
	cy = oy + czy * czm
	cz = oz + czz * czm
end

local function step(dt)
	ox, oy, oz, oxx, oyx, ozx, oxy, oyy, ozy, oxz, oyz, ozz = CFrame.new().components(DriverSeat.CFrame)
	if (rotatingManually) then
		updateManualRotation(dt)
	else
		updateDynamicRotation(dt)
	end
	if viewMode == 0 then
		Camera.CameraType = Enum.CameraType.Scriptable
		update(dt)
	elseif viewMode == 1 then
		Camera.CameraType = Enum.CameraType.Custom
	end
	-- Update actual camera
	Camera.CoordinateFrame = CFrame.new(cx, cy, cz, cxx, cyx, czx, cxy, cyy, czy, cxz, cyz, czz)
end

local function initCameraEffect()
	RunService:BindToRenderStep("VehicleCamera", Enum.RenderPriority.Camera.Value + 1, step)
end

local function deinitCameraEffect()
	RunService:UnbindFromRenderStep("VehicleCamera")
	Camera.CameraType = Enum.CameraType.Custom
end

function CamInput()
	if viewMode < Settings.CAMERA_MODES then
		viewMode = viewMode + 1
	else
		viewMode = 0
	end
	if viewMode == 1 then
		deinitCameraEffect()
		Values.Camera.CamMode.Value = 1
		Values.Camera.CamName.Value = "Freecam"
	elseif viewMode == 0 then
		initCameraEffect()
		Values.Camera.CamMode.Value = 0
		Values.Camera.CamName.Value = "Third person"
	end
end

Values.Camera.ChangeCam.Changed:Connect(CamInput)

UserInputService.InputBegan:connect(function(inputObject, inputProcessed)
	if not mouseon then
		if inputObject.UserInputType == Enum.UserInputType.MouseButton2 then
			RotationTarget = Rotation
			local newMousePosition = UserInputService:GetMouseLocation()
			mousePositionX = newMousePosition.X
			mousePositionY = newMousePosition.Y
			rotatingManually = true
		elseif not rotatingManually and inputObject.UserInputType == Enum.UserInputType.Keyboard and not ChatInputBarConfiguration.IsFocused then
			if inputObject.KeyCode == _Settings.Controls.ToggleCamera then
				CamInput()
			end
		end
	end
end)

local function ControllerRotateRight()
	if viewMode == 0 and Values.ControllerJoyStickInput.Thumbstick2Right.Value then
		rotatingManually = true
		RotationTarget = Rotation + Settings.MANUAL_ROTATION_SPEED * 31.5
		task.wait(2)
		if viewMode == 0 and Values.ControllerJoyStickInput.Thumbstick2Right.Value then
			RotationTarget = Rotation + Settings.MANUAL_ROTATION_SPEED * 31.5
		end
	else
		rotatingManually = false
	end
end

local function ControllerRotateLeft()
	if viewMode == 0 and Values.ControllerJoyStickInput.Thumbstick2Left.Value then
		rotatingManually = true
		RotationTarget = Rotation + Settings.MANUAL_ROTATION_SPEED * -31.5
		task.wait(2)
		if viewMode == 0 and Values.ControllerJoyStickInput.Thumbstick2Left.Value then
			RotationTarget = Rotation + Settings.MANUAL_ROTATION_SPEED * -31.5
		end
	else
		rotatingManually = false
	end
end

Values.ControllerJoyStickInput.Thumbstick2Right.Changed:Connect(ControllerRotateRight)
Values.ControllerJoyStickInput.Thumbstick2Left.Changed:Connect(ControllerRotateLeft)

initCameraEffect()
Values.Camera.CamMode.Value = 0
Values.Camera.CamName.Value = "Third person"

Values.Camera.CamOn.Value = true]]></ProtectedString>
						<bool name="Disabled">false</bool>
