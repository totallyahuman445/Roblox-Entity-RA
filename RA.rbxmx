				<Item class="Folder" referent="RBX768C4B19ABBF43DC809CB856D5D18056">
					<Properties>
						<Color3 name="IconTint">
							<R>0</R>
							<G>0</G>
							<B>0</B>
						</Color3>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">PacejkaTyres</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
					<Item class="LocalScript" referent="RBXE4BC292E124741A3A33C46759B9B7325">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local vehicle = script.Parent.Parent.Vehicle.Value
local values = script.Parent.Parent:WaitForChild("Values")
local event = vehicle:WaitForChild("Friction")
local player = game.Players.LocalPlayer

local _Settings = require(vehicle.Settings)
local Units = require(vehicle.Settings.Units)

local UserInputService = game:GetService("UserInputService")
local HapticService = game:GetService("HapticService")
local RunService = game:GetService("RunService")

-- Load SmokePart
event:FireServer("create", _Settings)

-- Wheels Array
local WheelData = {}
for _, v in next, vehicle.Wheels:GetChildren() do
	wheelvalues = v.Values
	local data = {}
	data.Object = v
	data.Temperature = _Settings.Temperature
	data.Dirt = 0
	data.Stress = 0
	data.Ray = nil
	data.Material = ""
	data.SmokePart = v:WaitForChild("SmokePart")
	data.FlexCollision = data.Object:FindFirstChild("Collision")
	data.WheelWeight = wheelvalues.WheelWeight.Value
	data.MaxTemp = wheelvalues.MaxTemp.Value
	data.MaxFriction = wheelvalues.MaxFriction.Value
	data.OffroadTolerance = wheelvalues.OffroadTolerance.Value
	data.ColdStats = wheelvalues.ColdStats.Value
	data.ColdStats2 = {data.ColdStats.X, data.ColdStats.Y, data.ColdStats.Z,}
	data.HotStats = wheelvalues.HotStats.Value
	data.HotStats2 = {data.HotStats.X, data.HotStats.Y, data.HotStats.Z,}
	data.DirtLoss = wheelvalues.DirtLoss.Value
	data.DirtFadeRate = wheelvalues.DirtFadeRate.Value
	data.Heating = wheelvalues.Heating.Value
	data.Cooling = wheelvalues.Cooling.Value
	data.SpeedStress = wheelvalues.SpeedStress.Value
	data.TyreFlex = wheelvalues.TyreFlex.Value
	data.PressureForce = wheelvalues.PressureForce.Value
	data.TyreWeight = wheelvalues.TyreWeight.Value
	WheelData[v.Name] = data
end

-- Open/Load Heat Data
local wd = vehicle:FindFirstChild("HeatData")
if wd then
	local t = tick() - wd.STime.Value
	for name, data in WheelData do
		if wd:FindFirstChild(name) then
			data.Temperature = wd[name]:GetAttribute("Temperature") - 60 * t * (data.Cooling)
			data.Dirt = wd[name]:GetAttribute("Dirt")
		end
	end
end

-- Close/Store Heat Data
vehicle.DriveSeat.ChildRemoved:Connect(function(child)
	if child.Name == "SeatWeld" then
			local wd = vehicle:FindFirstChild("HeatData")
			if not wd then
				wd = script.Parent.HeatData:Clone()
				wd.Parent = vehicle
			end
			for name, data in WheelData do
				local config = wd:FindFirstChild(name) or Instance.new("Configuration", wd)
				config.Name = name
				config:SetAttribute("Temperature", data.Temperature)
				config:SetAttribute("Dirt", data.Dirt)
			end
			wd.STime.Value = tick()
		event:FireServer("stop")
		if HapticService:IsVibrationSupported(Enum.UserInputType.Gamepad1) then
			HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, 0)
		end
	end
end)

-- Ray Data
local rayParams = RaycastParams.new()
rayParams.FilterDescendantsInstances = {vehicle}
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local materialSort = {
	road = {
		"Asphalt",
		"Basalt",
		"Brick",
		"Cardboard",
		"Carpet",
		"CeramicTiles",
		"ClayRoofTiles",
		"Cobblestone",
		"Concrete",
		"CorrodedMetal",
		"CrackedLava",
		"DiamondPlate",
		"Foil",
		"Glass",
		"Granite",
		"Ground",
		"Leather",
		"Limestone",
		"Marble",
		"Metal",
		"Neon",
		"Pavement",
		"Pebble",
		"Plaster",
		"Plastic",
		"Rock",
		"RoofShingles",
		"Rubber",
		"Salt",
		"Sandstone",
		"Slate",
		"SmoothPlastic",
		"Wood",
		"WoodPlanks"
	},
	leaf = {
		"LeafyGrass",
	},
	dirt = {
		"Grass",
		"Ground",
		"LeafyGrass",
	},
	mud = {
		"Mud",
	},
	sand = {
		"Sand",
	},
	snow = {
		"Glacier",
		"Snow",
	},
	ice = {
		"Ice",
	},
	water = {
		"Water",
	}
}

-- Runtime Loops
local deltaTime = 1
local sandForce = Vector3.new()
local mudForce = Vector3.new()
local snowForce = Vector3.new()
RunService.Heartbeat:Connect(function(dt)
	deltaTime = dt
	for name, data in next, WheelData do
		-- Apply sand, mud force
		data.Object:ApplyImpulseAtPosition(sandForce * dt, data.Object.Position)
		data.Object:ApplyImpulseAtPosition(mudForce * dt, data.Object.Position)
		data.Object:ApplyImpulseAtPosition(snowForce * dt, data.Object.Position)
		local stress = 0
		local count = 0
		for name, data in next, WheelData do
			local rotSpeed = math.abs(data.Object.RotVelocity:Dot(data.SmokePart.CFrame.RightVector))
			local rotLinearSpeed = rotSpeed * (data.Object.Size.Y / 2)
			local speed = values.Velocity.Value.Magnitude
			local diff = math.abs(rotLinearSpeed - speed)

			local ray = nil -- Assuming they are the same material
			local materialType = ""

			-- Rays
			-- Two rays, one for the inside and outside of the wheel for camber support.
			local rayI = workspace:Raycast(
				data.Object.Position,
				-data.SmokePart.CFrame.UpVector * (data.Object.Size.Y / 2 + .1),
				rayParams)
			local rayO = workspace:Raycast(
				data.Object.Position,
				-data.SmokePart.CFrame.UpVector * (data.Object.Size.Y / 2 + .1),
				rayParams)
			ray = rayI or rayO
			if ray then
				-- Run a loop through the materialSort table. Set materialType and break when a material is found.
				for name, values in next, materialSort do
					if table.find(values, ray.Material.Name) then
						materialType = name
						break
					end
				end
			end
			data.Ray = ray
			data.Material = materialType

			-- Slip
			local vstress = (math.max(ray and diff / 20 or 0, ray and materialType ~= "road" and rotSpeed / 50 or 0) + data.Cooling * (rotLinearSpeed / (Units.Velocity_mdivs / 3.6) / 100))
			if ray and materialType ~= "road" then
				local random = Random.new():NextNumber() * speed
				if random > 20 then
					data.Object.Velocity += Vector3.new(0, math.random(0, _Settings.DirtBumps), 0) * math.min(speed / data.OffroadTolerance, 5)
				end
			end
			if vstress > .05 * (60 / (1 / dt)) and vstress > data.Stress then
				data.Stress = math.min(data.Stress + .05 * (60 / (1 / dt)), math.min(vstress, 1))
			else
				data.Stress = math.max(data.Stress - .05 * (60 / (1 / dt)), vstress)
			end

			-- Update dirt
			if materialType ~= "road" and materialType ~= "" then
				data.Dirt = 1
			else
				data.Dirt = math.max(data.Dirt - data.DirtFadeRate * (rotSpeed / 100) * (60 / (1 / dt)), 0)
			end

			-- Apply friction
			local materialHeatFactor = materialType ~= "road" and .01 or 1
			if _Settings.TyreHeating then
				data.Temperature = math.clamp(data.Temperature + (data.Stress * (data.Heating + data.Cooling) * materialHeatFactor - data.Cooling) * (60 / (1 / dt)), _Settings.Temperature, data.MaxTemp)
				local coldLoss = (data.ColdStats2[1] * (1 / (math.exp(data.ColdStats2[2] * (data.Temperature / 100 - data.ColdStats2[3])) + 1)))
				local heatLoss = (data.HotStats2[1] * ( - (1 / (math.exp(data.HotStats2[2] * (data.Temperature / 100 - data.HotStats2[3])) + 1)) + 1))
				data.Object.CustomPhysicalProperties = PhysicalProperties.new(
					((data.WheelWeight - (data.TyreFlex and data.TyreWeight or 0)) * Units.Mass_kg) / (math.pi * (data.Object.Size.Y / 2) ^ 2 * (data.Object.Size.X)),
					data.MaxFriction - coldLoss - heatLoss - data.Dirt * data.DirtLoss,
					data.Object.CurrentPhysicalProperties.Elasticity,
					3.5,
					data.Object.CurrentPhysicalProperties.ElasticityWeight
				)
			else
				data.Object.CustomPhysicalProperties = PhysicalProperties.new(
					((data.WheelWeight - (data.TyreFlex and data.TyreWeight or 0)) * Units.Mass_kg) / (math.pi * (data.Object.Size.Y / 2) ^ 2 * (data.Object.Size.X)),
					data.MaxFriction - data.Dirt * data.DirtLoss,
					data.Object.CurrentPhysicalProperties.Elasticity,
					3.5,
					data.Object.CurrentPhysicalProperties.ElasticityWeight
				)
			end
			
			if ray and materialType == "sand" then
				sandForce = ((-data.Object.Velocity.Unit * (((data.Object.Velocity.Magnitude * Units.Velocity_mdivs * 3.6) * (_Settings.SandForce * Units.Force_N * 9.80665)) ^ 2 / (50 * Units.Velocity_mdivs * 3.6) ^ 2)))
			elseif ray and materialType == "mud" then
				mudForce = ((-data.Object.Velocity.Unit * (((data.Object.Velocity.Magnitude * Units.Velocity_mdivs * 3.6) * (_Settings.MudForce * Units.Force_N * 9.80665)) ^ 2 / (50 * Units.Velocity_mdivs * 3.6) ^ 2)))
			elseif ray and materialType == "snow" then
				snowForce = ((-data.Object.Velocity.Unit * (((data.Object.Velocity.Magnitude * Units.Velocity_mdivs * 3.6) * (_Settings.SnowForce * Units.Force_N * 9.80665)) ^ 2 / (50 * Units.Velocity_mdivs * 3.6) ^ 2)))
			else
				sandForce = Vector3.new()
				mudForce = Vector3.new()
				snowForce = Vector3.new()
			end

			-- Update haptic values
			stress += data.Stress
			count += 1

			-- Tyre flex
			if data.TyreFlex and data.FlexCollision then
				data.FlexCollision.CustomPhysicalProperties = PhysicalProperties.new(
					(data.TyreWeight * Units.Mass_kg) / (math.pi * (data.Object.Size.Y / 2) ^ 2 * (data.Object.Size.X)),
					data.Object.CurrentPhysicalProperties.Friction,
					data.Object.CurrentPhysicalProperties.Elasticity,
					3.5,
					data.Object.CurrentPhysicalProperties.ElasticityWeight
				)
				data.FlexCollision.AlignPosition.MaxForce = data.PressureForce * 100
			end
		end
		-- Haptics
		local lastInput = game:GetService("UserInputService"):GetLastInputType()
		if HapticService:IsVibrationSupported(Enum.UserInputType.Gamepad1) and _Settings.Haptics then
			stress /= count
			stress = math.clamp(stress / 2, 0, .5)
			HapticService:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, stress)
		end
	end
end)

-- Everything else
if _Settings.Effects then
	local lastTick = tick()
	while task.wait(1 / 8) do
		for name, data in next, WheelData do
			local ray = data.Ray
			local materialType = data.Material
			local smokeStress = math.clamp(data.Stress - _Settings.SmokeStressOffset / 100, 0, 1)
			event:FireServer("update", data.Object, materialType, smokeStress, ray and ray.Normal, deltaTime)
		end
	end
end]]></ProtectedString>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<token name="RunContext">0</token>
							<string name="ScriptGuid">{F06E8F02-5448-403F-849C-F268569F097D}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Simulated</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
					</Item>
					<Item class="RemoteEvent" referent="RBX735EAAA61A8D45CDB6AF42203D2D4E9C">
						<Properties>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Friction</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
						<Item class="Script" referent="RBX8E1CAB7E9D85425F8C10325310EF5E4A">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local vehicle = script.Parent.Parent
local _Settings = require(vehicle.Settings)
local Units = require(vehicle.Settings.Units)
local RunService = game:GetService("RunService")
local functionTable = {
	create = function(_Settings)
		for _, v in next, vehicle.Wheels:GetChildren() do
			local wheelvalues = v.Values
			local TyreFlex = wheelvalues.TyreFlex.Value
			if not v:FindFirstChild("SmokePart") then
				local Caster = wheelvalues.Caster.Value
				local TyreMarkTransparencyLevels = wheelvalues.TyreMarkTransparencyLevels.Value
				local SmokeColorSequence = ColorSequence.new{
					ColorSequenceKeypoint.new(0, wheelvalues.SmokeColorSequence.Value),
					ColorSequenceKeypoint.new(1, wheelvalues.SmokeColorSequence2.Value)}
				script.Smoke_road.Color = SmokeColorSequence
				Caster = (v.Name == "FR" or v.Name == "RR" or v.Name == "MR") and -Caster or Caster
				local smokePart = v:FindFirstChild("SmokePart") or v.Arm:Clone()
				smokePart.Name = "SmokePart"
				smokePart.Massless = true
				smokePart:ClearAllChildren()
				smokePart.CFrame = CFrame.new((v.CFrame * CFrame.new(0, -v.Size.Y / 2, 0)).Position) * v.Arm.CFrame.Rotation
				smokePart.Parent = v
				local sa0 = Instance.new("Attachment", v.Base)
				sa0.Name = "SmokePartAttachment0"
				local sa1 = Instance.new("Attachment", smokePart)
				sa1.Name = "SmokePartAttachment1"
				sa1.Position = Vector3.new(0, v.Size.Y, 0)
				local smokePartRigidConstraint = Instance.new("RigidConstraint", smokePart)
				smokePartRigidConstraint.Attachment0 = sa0
				smokePartRigidConstraint.Attachment1 = sa1
				for _, a in next, script:GetChildren() do
					if smokePart:FindFirstChild(a.Name) then
						continue
					end
					local clone = a:Clone()
					clone.Parent = smokePart
				end
				-- create trails
				local trailAttachmentPart = v:FindFirstChild("TrailAttachmentPart") or smokePart:Clone()
				trailAttachmentPart:ClearAllChildren()
				trailAttachmentPart.Name = "TrailAttachmentPart"
				trailAttachmentPart.Parent = v
				local ta0 = Instance.new("Attachment", v)
				local ta1 = Instance.new("Attachment", trailAttachmentPart)
				ta1.Position = Vector3.new(0, v.Size.Y / 2, 0)
				local tapalign = Instance.new("AlignPosition", trailAttachmentPart)
				tapalign.ReactionForceEnabled = true
				tapalign.RigidityEnabled = true
				tapalign.Attachment0 = ta0
				tapalign.Attachment1 = ta1
				local tapOrientation = Instance.new("AlignOrientation", trailAttachmentPart)
				tapOrientation.RigidityEnabled = true
				tapOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
				tapOrientation.Attachment0 = ta1
				local a0 = Instance.new("Attachment", trailAttachmentPart)
				a0.Name = "TrailAttachment0"
				local a1 = Instance.new("Attachment", trailAttachmentPart)
				a1.Name = "TrailAttachment1"
				if TyreFlex then
					if v:IsA("Part") then
						v.CanCollide = false
						collision = v:FindFirstChild("Collision") or Instance.new("Part", v)
						collision.Name = "Collision"
						collision.CanCollide = true -- set false for now we will make it collide in loop
						collision.CFrame = v.CFrame
						collision.Transparency = _Settings.ShowTF and .5 or 1
						collision.Shape = v.Shape
						collision.Size = v.Size
						ta0.Parent = v.Collision
					elseif v:IsA("TrussPart") then
						v.CanCollide = false
						collision = v:FindFirstChild("Collision") or Instance.new("TrussPart", v)
						collision.Name = "Collision"
						collision.CanCollide = true -- set false for now we will make it collide in loop
						collision.CFrame = v.CFrame
						collision.Transparency = _Settings.ShowTF and .5 or 1
						collision.Style = v.Style
						collision.Size = v.Size
						ta0.Parent = v.Collision
					else
						collision = v:FindFirstChild("Collision")
					end

					local mainAttachment = Instance.new("Attachment", collision)
					mainAttachment.Orientation = v["AB"].Orientation

					local force = Instance.new("AlignPosition", collision)
					force.ReactionForceEnabled = true
					force.Attachment0 = v["AB"]
					force.Attachment1 = mainAttachment
					force.ForceLimitMode = Enum.ForceLimitMode.Magnitude
					force.ForceRelativeTo = Enum.ActuatorRelativeTo.World
					force.Responsiveness = 200
					force.MaxVelocity = 10

					local rotationForce = Instance.new("AlignOrientation", collision)
					rotationForce.ReactionTorqueEnabled = true
					rotationForce.RigidityEnabled = true
					rotationForce.Attachment0 = v["AB"]
					rotationForce.Attachment1 = mainAttachment
					rotationForce.Responsiveness = math.huge

					local limiter = Instance.new("SpringConstraint", collision)
					limiter.Name = "Limiter"
					limiter.Damping = 1500
					limiter.Stiffness = 5000
					limiter.MaxForce = .5
					limiter.Coils = 0
					limiter.Attachment0 = v["AB"]
					limiter.Attachment1 = mainAttachment
					limiter.LimitsEnabled = true
					limiter.FreeLength = 0
					limiter.MaxLength = wheelvalues.TyreThickness.Value / Units.Length_mm
				end
				if not wheelvalues.Smoke.Value then
					v.SmokePart.Sound_road:Destroy()
					v.SmokePart.Smoke_road:Destroy()
				end
				local TAPRayParams = RaycastParams.new()
				TAPRayParams.FilterType = Enum.RaycastFilterType.Exclude
				TAPRayParams.FilterDescendantsInstances = {vehicle}
				if TyreMarkTransparencyLevels > 0 then
					for m = 1, 4 do
						for i = 1, TyreMarkTransparencyLevels do
							local name = "Trail"..((m == 1 and "road") or (m == 2 and "snow") or (m == 3 and "sand") or (m == 4 and "dirt" or "leaf") or (m == 5 and "mud") or "") .. i
							local trail = smokePart:FindFirstChild(name) or Instance.new("Trail", smokePart)
							trail.Name = name
							trail.Transparency = NumberSequence.new(wheelvalues.TyreMarkTransparency.Value)
							trail.Texture = "rbxassetid://14987871952"
							trail.TextureMode = Enum.TextureMode.Static
							trail.Lifetime = 20
							trail.Enabled = false
							trail.Attachment0 = a0
							trail.Attachment1 = a1
							trail:SetAttribute("stress", i / TyreMarkTransparencyLevels)
							if m == 1 then
								trail.Color = ColorSequence.new(Color3.new(0, 0, 0))
							elseif m == 2 then
								trail.Color = ColorSequence.new(Color3.fromRGB(205, 250, 255))
							elseif m == 3 then
								trail.Color = ColorSequence.new(Color3.fromRGB(255, 241, 136))
							elseif m == 4 then
								trail.Color = ColorSequence.new(Color3.fromRGB(255, 173, 102))
							elseif m == 5 then
								trail.Color = ColorSequence.new(Color3.fromRGB(140, 103, 43))
							else
								trail.Color = ColorSequence.new(Color3.new(0, 0, 0))
							end
						end
					end
				end
			end
			for _, y in next, v.NoCollisionConstraint:GetChildren() do
				if y.Part0 == nil then
					y.Part1.CanCollide = true
					if TyreFlex then
						y.Part0 = v.Collision
					else
						y.Part0 = v
					end
				elseif y.Part1 == nil then
					y.Part0.CanCollide = true
					if TyreFlex then
						y.Part1 = v.Collision
					else
						y.Part1 = v
					end
				end
			end
		end
	end,
	update = function(wheel, materialType, smokeStress, rayNormal, dt)
		-- Set smokepart data
		local smokePart = wheel:FindFirstChild("SmokePart")
		if not smokePart then return 
		end
		local currentSound = smokePart:FindFirstChild("Sound_" .. materialType)
		local currentSound2 = smokePart:FindFirstChild("Sound2_" .. materialType)
		local currentSmoke = smokePart:FindFirstChild("Smoke_" .. materialType)
		local currentSmoke2 = smokePart:FindFirstChild("Smoke2_" .. materialType)
		local currentSmoke3 = smokePart:FindFirstChild("Smoke3_" .. materialType)
		for _, d in next, smokePart:GetChildren() do
			if d:IsA("Sound") and (d ~= currentSound or not rayNormal) then
				d.Playing = false
			end
			if d:IsA("Sound") and (d ~= currentSound2 or not rayNormal) then
				d.Playing = false
			end
			if d:IsA("ParticleEmitter") and (d ~= currentSmoke or not rayNormal) then
				d.Enabled = false
			end
			if d:IsA("ParticleEmitter") and (d ~= currentSmoke2 or not rayNormal) then
				d.Enabled = false
			end
			if d:IsA("ParticleEmitter") and (d ~= currentSmoke3 or not rayNormal) then
				d.Enabled = false
			end
			if d:IsA("Trail") then
				d.Enabled = false
				if string.find(d.Name, materialType) and d:GetAttribute("stress") < smokeStress ^ 3 and rayNormal then
					d.Enabled = true
				end
			end
		end
		if currentSound then
			-- Sound
			if not currentSound.Playing then
				currentSound.TimePosition = Random.new():NextNumber() * currentSound.TimeLength -- avoid overlapping sounds
			end
			currentSound.Playing = true
			currentSound.Volume = smokeStress ^ 3 * 1.4
			currentSound.PlaybackSpeed = 1.6 - .5 * smokeStress
		end
		if currentSound2 then
			-- Secondary sound
			if not currentSound2.Playing then
				currentSound2.TimePosition = Random.new():NextNumber() * currentSound.TimeLength -- avoid overlapping sounds
			end
			currentSound2.Playing = true
			currentSound2.Volume = smokeStress ^ 3 * 1.4
			currentSound2.PlaybackSpeed = 1.6 - 0.5 * smokeStress
		end
		if currentSmoke then
			-- Smoke
			currentSmoke.Enabled = true
			currentSmoke.Rate = smokeStress ^ 10 * 100
		end
		if currentSmoke2 then
			-- Kickback
			currentSmoke2.Enabled = true
			currentSmoke2.Rate = smokeStress ^ 10 * 100
		end
		if currentSmoke3 then
			-- Kickback
			currentSmoke3.Enabled = true
			currentSmoke3.Rate = smokeStress ^ 10 * 100
		end
		local compression = 1
		if wheel:FindFirstChild("Collision") then
			compression = math.clamp((wheel.Position-wheel.Collision.Position).Magnitude / .1, 0, 1)
		end
		local trailAttachmentPart = wheel:FindFirstChild("TrailAttachmentPart")
		if trailAttachmentPart then
			trailAttachmentPart.TrailAttachment0.Position = Vector3.new(wheel.Size.X / 2 - .2 + .1 * compression, .02, 0)
			trailAttachmentPart.TrailAttachment1.Position = Vector3.new(-wheel.Size.X / 2 + .2 - .1 * compression, .02, 0)
			trailAttachmentPart.AlignOrientation.CFrame = CFrame.lookAt(smokePart.Position, (smokePart.CFrame * CFrame.new(0, 0, -5 + math.min(wheel.Velocity.Magnitude, 5))).Position + wheel.Velocity, rayNormal or smokePart.CFrame.UpVector)
		end
		smokePart.SmokePartAttachment1.Position = Vector3.new(0, wheel.Size.Y, 0) + smokePart.CFrame:VectorToObjectSpace(wheel.Velocity) * dt
	end,
	stop = function()
		for _, wheel in next, vehicle.Wheels:GetChildren() do
			if not wheel:IsA("BasePart") then
				continue
			end
			if wheel:FindFirstChild("SmokePart") == nil then
				continue
			end
			for _, d in next, wheel.SmokePart:GetChildren() do
				if d:IsA("Sound") then
					d.Playing = false
				end
				if d:IsA("ParticleEmitter") then
					d.Enabled = false
				end
				if d:IsA("Trail") then
					d.Enabled = false
				end
			end
		end
	end,
}

script.Parent.OnServerEvent:Connect(function(player, func, ...)
	if functionTable[func] then
		functionTable[func](...)
	end
end)]]></ProtectedString>
