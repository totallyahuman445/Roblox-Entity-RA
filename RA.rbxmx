					<Item class="LocalScript" referent="RBX281253B290E643E99EEFB914A3C3EA2B">
						<Properties>
							<ProtectedString name="Source"><![CDATA[--[[ Welcome, tuner.
    ____  ___
   / __ \/   | Entity
  / /_/ / /| | Roblox self propelled land vehicle chassis
 / __ _/ ___ | 0.51.4
/_/ |_/_/  |_| GitHub:    https://github.com/totallyahuman445/Roblox-Entity-RA
               Discord:   https://discord.gg/bS2A448Vrk
               Community: https://www.roblox.com/share/g/206794047
			   THE List:  https://docs.google.com/document/d/1WvOWw7ST4ZWpsCfXM3abJTTBkCA40NsayIEIdCRJOYM/edit?usp=sharing
			   Log:		  https://docs.google.com/document/d/1SLW5NOAysg2rE6C52WEPnmOas_MNbeVNEv0xv2f__ps/edit?usp=sharing
			   Credits:   https://docs.google.com/document/d/1-mIgEhmugHfVUDz4vzZMS7XYMoEdLKedy0MedRqvbyA/edit?usp=sharing
]]
local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local gauges = script.Parent
local vehicle = gauges.Parent.Vehicle.Value
local TweenService = game:GetService("TweenService")
local _Settings = require(vehicle.Settings)
local PRPM = _Settings.PeakRPM
local values = gauges.Parent.Values
local RPM = 0
local MaxRPM = 0
gauges:WaitForChild("Gear")
gauges:WaitForChild("Speed")
--EDITABLE VALUES-----------------------------------------------------------------------------------------------------------------------------
local BrakeTemp           = true                          -- Displays Average brake temperature if BrakeFadeOn in the Settings is enabled.

local ATBGC               = Color3.fromRGB(255, 170, 0)   -- A/T Background Colour
local STBGC               = Color3.fromRGB(0, 170, 127)   -- S/T Background Colour
local MTBGC               = Color3.fromRGB(255, 85, 128)  -- M/T Background Colour

local numbercolour        = Color3.fromRGB(255, 255, 255) -- Number colour for tachometer and speedometer,
local boostnumbercolour   = Color3.fromRGB(255, 255, 255)
local gearnumbercolour    = Color3.fromRGB(255, 255, 255)

local RPMColor            = Color3.fromRGB(255, 255, 255) -- Change the numbers to the rgb code u want for the RPM stick
local RedlineLightColor   = Color3.fromRGB(255, 0, 0)     -- Change the numbers to the rgb code u want for the redline light
local RPMsColor           = Color3.fromRGB(255, 255, 255) -- Change the numbers to the rgb code you want for the RPM Reader

local UNITS	= {
	--Click on the speed to change units.
	--First unit is the default.
	{
		units			= "km/h",                -- Unit name
		scaling			= (11 / 12) * 1.09728,   -- 1 stud : 11 inches | ft/s to km/h
		System          = 1                      -- 1 = metric, 2 = imperial, 3 = Roblox units (don't change)
	},
	{
		units			= "mph",                 -- Unit name
		scaling			= (11 / 12) * (60 / 88), -- 1 stud : 11 inches | ft/s to mph
		System          = 2                      -- 1 = metric, 2 = imperial, 3 = Roblox units (don't change)
	},
	{
		units			= "SPS",                 -- Unit name
		scaling			= 1,                     -- Roblox standard
		System          = 3                      -- 1 = metric, 2 = imperial, 3 = Roblox units (don't change)
	},
}
--END OF EDITABLE VALUES-----------------------------------------------------------------------------------------------------------------------
if _Settings.Engine then
	game["Run Service"].Stepped:connect(function()
		local rev = (values.RPM.Value / _Settings.Redline)
		gauges.RpmMove.Size = UDim2.new(0, 1 * (rev * 275), 0, 17)
		gauges.RpmShadow.Size = UDim2.new(0, 1 * (rev * 275), 0, 17)
	end)
end

if not _Settings.Engine and _Settings.Electric then
	game["Run Service"].Stepped:connect(function()
		local rev = (values.RPM.Value / _Settings.E_Redline)
		gauges.RpmMove.Size = UDim2.new(0, 1 * (rev * 275), 0, 17)
		gauges.RpmShadow.Size = UDim2.new(0, 1 * (rev * 275), 0, 17)
	end)
end

gauges.RpmMove.BackgroundColor3 = RPMColor
gauges.RPMs.TextColor3 = RPMsColor

values.RPM.Changed:Connect(function()
	gauges.RPMs.Text = string.gsub(math.floor(values.RPM.Value), "^(-?%d+)(%d%d%d)", "%1,%2").. (" rpm")
	if values.IsOn.Value or values.RPM.Value >= 2 then
		gauges.RPMs.Visible = true
		gauges.Pressure.Visible = true
		gauges.RpmMove.Visible = true
		gauges.RpmShadow.Visible = true
	else
		gauges.RPMs.Visible = false
		gauges.Pressure.Visible = false
		gauges.RpmMove.Visible = false
		gauges.RpmShadow.Visible = false
	end
end)

values.RPM.Changed:connect(function()
	if _Settings.Engine then
		if values.RPM.Value >= PRPM then
			gauges.RpmMove.BackgroundColor3 = RedlineLightColor
			gauges.RPMs.TextStrokeColor3 = RedlineLightColor
		else
			gauges.RpmMove.BackgroundColor3 = RPMColor
			gauges.RPMs.TextStrokeColor3 = Color3.fromRGB(54, 54, 54)
		end
	end
	if not _Settings.Engine and _Settings.Electric then
		if values.RPM.Value >= _Settings.E_TorqueDropRPM then
			gauges.RpmMove.BackgroundColor3 = RedlineLightColor
			gauges.RPMs.TextStrokeColor3 = RedlineLightColor
		else
			gauges.RpmMove.BackgroundColor3 = RPMColor
			gauges.RPMs.TextStrokeColor3 = Color3.fromRGB(54, 54, 54)
		end
	end
end)

local currentUnits = 1

gauges.Speed.TextColor3 = numbercolour
gauges.Gear.TextColor3 = gearnumbercolour

local _TCount = _Settings.Turbochargers
local _SCount = _Settings.Superchargers

if _TCount ~= 0 or _SCount ~= 0 then
	values.Boost.Changed:connect(function()
		if UNITS[currentUnits].System == 1 or UNITS[currentUnits].System == 3 then
			local _T = 0
			local _S = 0
			if _TCount ~= 0 then
				_T = _Settings.T_Boost * _TCount
			end
			if _SCount ~= 0 then
				_S = _Settings.S_Boost * _SCount
			end
			local tboost = (math.floor(values.BoostTurbo.Value * .75) - (_T * 2.5)) / 14.503773773
			local sboost = (math.floor(values.BoostSuper.Value)) / 14.503773773
			local boostvalue = string.format("%.1f", (tboost) + (sboost))
			gauges.Pressure.Text = boostvalue ..(" bar")
			gauges.Pressure.TextColor3 = boostnumbercolour
		else
			local _T = 0
			local _S = 0
			if _TCount ~= 0 then
				_T = _Settings.T_Boost * _TCount
			end
			if _SCount ~= 0 then
				_S = _Settings.S_Boost * _SCount
			end
			local tboost = (math.floor(values.BoostTurbo.Value * .75) - (_T * 2.5))
			local sboost = (math.floor(values.BoostSuper.Value)) 
			local boostvalue = string.format("%.1f", (tboost) + (sboost))
			gauges.Pressure.Text = boostvalue ..(" psi")
			gauges.Pressure.TextColor3 = boostnumbercolour
		end
	end)
end

if _Settings.BrakeFadeOn then
	script.Parent.BrakeTempIcon.Visible = true
	script.Parent.BrakeTemp.Visible = true
	values.AverageBrakeTemp.Changed:connect(function()
		if values.System.Value == "Metric" then
			script.Parent.BrakeTemp.Text = values.AverageBrakeTemp.Value.. " °C"
		else
			script.Parent.BrakeTemp.Text = math.floor((values.AverageBrakeTemp.Value * 1.8) + 32) .. " °F"
		end
	end)
else
	script.Parent.BrakeTempIcon:Destroy()
	script.Parent.BrakeTemp:Destroy()
end

values.Gear.Changed:connect(function()
	local gearText = values.Gear.Value
	if gearText == 0 then
		gearText = "N"
	elseif gearText == -1 and not _Settings.NoReverse then
		gearText = "R"
	elseif gearText == -1 and _Settings.NoReverse then
		gearText = "N"
	end
	gauges.Gear.Text = gearText
end)

values.TCS.Changed:connect(function()
	if _Settings.TCSEnabled then
		if values.TCS.Value then
			if values.TCSActive.Value then
				task.wait()
				gauges.TCS.Visible = not gauges.TCS.Visible
			else
				task.wait()
				gauges.TCS.Visible = false
			end
		else
			gauges.TCS.Visible = true
		end
	else
		gauges.TCS.Visible = false
	end
end)

values.TCSActive.Changed:connect(function()
	if _Settings.TCSEnabled then
		if values.TCSActive.Value and values.TCS.Value then
			task.wait()
			gauges.TCS.Visible = not gauges.TCS.Visible
		elseif not values.TCS.Value then
			task.wait()
			gauges.TCS.Visible = true
		else
			task.wait()
			gauges.TCS.Visible = false
		end
	else
		gauges.TCS.Visible = false
	end
end)

gauges.TCS.Changed:connect(function()
	if _Settings.TCSEnabled then
		if values.TCSActive.Value and values.TCS.Value then
			task.wait()
			gauges.TCS.Visible = not gauges.TCS.Visible
		elseif not values.TCS.Value then
			task.wait()
			gauges.TCS.Visible = true
		end
	else
		if gauges.TCS.Visible then
			gauges.TCS.Visible = false
		end
	end
end)

values.ESC.Changed:connect(function()
	if _Settings.ESCEnabled then
		if values.ESC.Value then
			if values.ESCActive.Value then
				task.wait()
				gauges.ESC.Visible = not gauges.ESC.Visible
			else
				task.wait()
				gauges.ESC.Visible = false
			end
		else
			gauges.ESC.Visible = true
		end
	else
		gauges.ESC.Visible = false
	end
end)

gauges.ESC.Changed:connect(function()
	if _Settings.ESCEnabled then
		if values.ESCActive.Value and values.TCS.Value then
			task.wait()
			gauges.ESC.Visible = not gauges.ESC.Visible
		elseif not values.ESC.Value then
			task.wait()
			gauges.ESC.Visible = true
		end
	else
		if gauges.ESC.Visible then
			gauges.ESC.Visible = false
		end
	end
end)

gauges.TCS.Changed:connect(function()
	if _Settings.TCSEnabled then
		if values.TCSActive.Value and values.TCS.Value then
			task.wait()
			gauges.TCS.Visible = not gauges.TCS.Visible
		elseif not values.TCS.Value then
			task.wait()
			gauges.TCS.Visible = true
		end
	else
		if gauges.TCS.Visible then
			gauges.TCS.Visible = false
		end
	end
end)

values.ABS.Changed:connect(function()
	if _Settings.ABSEnabled then
		if values.ABS.Value then
			if values.ABSActive.Value then
				task.wait()
				gauges.ABS.Visible = not gauges.ABS.Visible
			else
				task.wait()
				gauges.ABS.Visible = false
			end
		else
			gauges.ABS.Visible = true
		end
	else
		gauges.ABS.Visible = false
	end
end)

values.ABSActive.Changed:connect(function()
	if _Settings.ABSEnabled then
		if values.ABSActive.Value and values.ABS.Value then
			task.wait()
			gauges.ABS.Visible = not gauges.ABS.Visible
		elseif not values.ABS.Value then
			task.wait()
			gauges.ABS.Visible = true
		else
			task.wait()
			gauges.ABS.Visible = false
		end
	else
		gauges.ABS.Visible = false
	end
end)

gauges.ABS.Changed:connect(function()
	if _Settings.ABSEnabled then
		if values.ABSActive.Value and values.ABS.Value then
			task.wait()
			gauges.ABS.Visible = not gauges.ABS.Visible
		elseif not values.ABS.Value then
			task.wait()
			gauges.ABS.Visible = true
		end
	else
		if gauges.ABS.Visible then
			gauges.ABS.Visible = false
		end
	end
end)

values.CS.Changed:connect(function()
	if _Settings.CSEnabled then
		if values.CS.Value then
			if values.CSActive.Value then
				task.wait()
				gauges.CS.Visible = not gauges.CS.Visible
			else
				task.wait()
				gauges.CS.Visible = false
			end
		else
			gauges.CS.Visible = true
		end
	else
		gauges.CS.Visible = false
	end
end)

gauges.CS.Changed:connect(function()
	if _Settings.CSEnabled then
		if values.CSActive.Value and values.CS.Value then
			task.wait()
			gauges.CS.Visible = not gauges.ESC.Visible
		elseif not values.CS.Value then
			task.wait()
			gauges.CS.Visible = true
		end
	else
		if gauges.CS.Visible then
			gauges.CS.Visible = false
		end
	end
end)

values.DRS.Changed:connect(function()
	if values.DRS.Value then
		gauges.DRS.Visible = true
	elseif not values.DRS.Value then
		gauges.DRS.Visible = false
	end
end)

function PBrake()
	gauges.PBrake.Visible = values.PBrake.Value
end

function FBrake()
	gauges.FBrake.Visible = values.FBrake.Value
end

values.PBrake.Changed:connect(PBrake)
values.FBrake.Changed:connect(FBrake)

function Gear()
	if #_Settings.TransModes > 1 then
		gauges.TMode.Visible = true
		if values.TransmissionMode.Value == "Auto" then
			local goal = {}
			goal.BackgroundColor3 = ATBGC
			local tweenInfo = TweenInfo.new(.25)
			local tween = TweenService:Create(gauges.TMode, tweenInfo, goal)
			gauges.TMode.Text = "A/T"
			tween:Play()
		elseif values.TransmissionMode.Value == "Semi" then
			local goal = {}
			goal.BackgroundColor3 = STBGC
			local tweenInfo = TweenInfo.new(.25)
			local tween = TweenService:Create(gauges.TMode, tweenInfo, goal)
			gauges.TMode.Text = "S/T"
			tween:Play()
		else
			local goal = {}
			goal.BackgroundColor3 = MTBGC
			local tweenInfo = TweenInfo.new(.25)
			local tween = TweenService:Create(gauges.TMode, tweenInfo, goal)
			gauges.TMode.Text = "M/T"
			tween:Play()
		end
	else
		gauges.TMode:Destroy()
	end
end
values.TransmissionMode.Changed:connect(Gear)

values.Velocity.Changed:connect(function(property)
	local speedvalue = string.gsub(math.floor((UNITS[currentUnits].scaling * values.Velocity.Value.Magnitude)), "^(-?%d+)(%d%d%d)", "%1,%2")
	local speedvalue2 = string.format("%.1f", (UNITS[currentUnits].scaling * values.Velocity.Value.Magnitude))
	local speedvalue3 = 0
	if (UNITS[currentUnits].scaling * values.Velocity.Value.Magnitude) > 10 then
		gauges.Speed.Text = speedvalue.. " ".. UNITS[currentUnits].units
	elseif (UNITS[currentUnits].scaling * values.Velocity.Value.Magnitude) > 0 and (UNITS[currentUnits].scaling * values.Velocity.Value.Magnitude) < .1 then
		gauges.Speed.Text = speedvalue3.. " ".. UNITS[currentUnits].units
	else
		gauges.Speed.Text = speedvalue2.. " ".. UNITS[currentUnits].units
	end
end)

gauges.Speed.MouseButton1Click:connect(function()
	if currentUnits == #UNITS then
		currentUnits = 1
	else
		currentUnits = currentUnits + 1
	end
	if UNITS[currentUnits].System == 1 or UNITS[currentUnits].System == 3 then
		values.System.Value = "Metric"
	else
		values.System.Value = "Imperial"
	end
end)

function TransmissionMode()
	if values.Input.ChangeTMode.Value then
		values.Input.ChangeTMode.Value = false
	else
		values.Input.ChangeTMode.Value = true
	end
end

gauges.TMode.MouseButton1Down:Connect(TransmissionMode)

task.wait(.1)
Gear()
PBrake()]]></ProtectedString>
