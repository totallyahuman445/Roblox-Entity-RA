				<Item class="LocalScript" referent="RBXC585833950A34CE29B598DEF3B70D66C">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local Slipstream	 = 40  -- How much drag is reduced in slipstream (in percent)
local SlipstreamTime = .7  -- Maximum amount of time you can be behind a vehicle to gain slipstream.
local WindVolume     = 2   -- Volume of wind at 200 km/h.
local BodyVolume	 = 1   -- Volume of body sounds at 200 km/h.

local vehicle = script.Parent.Vehicle.Value
local _Settings = require(vehicle.Settings)
local values = script.Parent.Values
local Units = require(vehicle.Settings.Units)
local DRS_Key = _Settings.Controls.ToggleDRS
local DRS_Button = _Settings.Controls.ContlrToggleDRS
local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")
local weight = vehicle.Body:WaitForChild("#Weight")
local Speed = vehicle.DriveSeat.Velocity.Magnitude * .994193907579735
local Handler = vehicle:WaitForChild("Aero_Sounds")
Handler:FireServer(WindVolume, BodyVolume)
local UserInputService = game:GetService("UserInputService")
local DRS = false
local _DragFactor = 1
local toKMH = (Units.Length_mm / 1000) * 3.6
local fromKGF = 9.80665 * Units.Force_N
local downforce_f = vehicle.Body.System.Aero:FindFirstChild("Downforce_F")
local downforce_r = vehicle.Body.System.Aero:FindFirstChild("Downforce_R")
local diffuser = vehicle.Body.System.Aero:FindFirstChild("Diffuser")
task.wait()
local wind = weight:FindFirstChild("WindSound")
local body = weight:FindFirstChild("BodySound")
local aeroParams = RaycastParams.new()
aeroParams.FilterDescendantsInstances = {vehicle, player.Character}
aeroParams.FilterType = Enum.RaycastFilterType.Exclude
local aeroParamsFrom = RaycastParams.new()
aeroParamsFrom.FilterDescendantsInstances = {}
aeroParamsFrom.FilterType = Enum.RaycastFilterType.Exclude
task.wait()

for _, v in next, vehicle:GetDescendants() do
	if v:IsA("BasePart") then
		v.EnableFluidForces = false
	end
end

UserInputService.InputBegan:Connect(function(Input, GameProcessed)
	if not GameProcessed then
		if _Settings.DRS_Enabled then
			local Key = Input.KeyCode
			if Key == DRS_Key or Key == DRS_Button then
				if not DRS then
					DRS = true
					values.DRS.Value = true
				else
					DRS = false
					values.DRS.Value = false
				end
			end
		end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	local vehicleSPEED = vehicle.DriveSeat.Velocity.Magnitude * 1.00584
	local DDownforceR_AB = 0
	local DDrag_AB = 0
	if _Settings.Airbrake_Enabled and vehicleSPEED > _Settings.Speed_AB then
		if DRS and _Settings.DRS_Cancel_AirBrake then
			if values.Brake.Value == 1 then
				DDownforceR_AB = 0
				DDrag_AB = 0
			end
		else
			if values.Brake.Value == 1 then
				task.wait(_Settings.Delay_AB)
				DDownforceR_AB = _Settings.DownforceR_AB
				DDrag_AB = _Settings.Drag_AB
			else
				task.wait(_Settings.Delay_AB)
				DDownforceR_AB = 0
				DDrag_AB = 0
			end
		end
	end
	if _Settings.Top_Speed_Mode_Enabled and vehicleSPEED > _Settings.Speed_TP then
		if DRS then
			task.wait(_Settings.Delay_DRS)
			DDrag = _Settings.Drag_DRS + DDrag_AB
			if _Settings.Downforce_R_Enabled then
				DDownforceR = _Settings.DownforceR_DRS + DDownforceR_AB
			end
		else
			task.wait(_Settings.Delay_TP)
			DDrag = _Settings.Drag + _Settings.Drag_TP + DDrag_AB
			if _Settings.Downforce_R_Enabled then
				DDownforceR = _Settings.DownforceR_TP + DDownforceR_AB
			end
		end
	elseif _Settings.Active_Aero_Enabled and vehicleSPEED > _Settings.Speed_AA then
		if DRS then
			task.wait(_Settings.Delay_DRS)
			DDrag = _Settings.Drag_DRS + DDrag_AB
			if _Settings.Downforce_R_Enabled then
				DDownforceR = _Settings.DownforceR_DRS + DDownforceR_AB
			end
		else
			task.wait(_Settings.Delay_AA)
			DDrag = _Settings.Drag + _Settings.Drag_AA + DDrag_AB
			if _Settings.Downforce_R_Enabled then
				DDownforceR = _Settings.DownforceR + _Settings.DownforceR_AA + DDownforceR_AB
			end
		end
	elseif _Settings.Active_Aero_Enabled then
		if DRS then
			task.wait(_Settings.Delay_DRS)
			DDrag = _Settings.Drag_DRS + DDrag_AB
			if _Settings.Downforce_R_Enabled then
				DDownforceR = _Settings.DownforceR_DRS + DDownforceR_AB
			end
		else
			task.wait(_Settings.Delay_AA)
			DDrag = _Settings.Drag + DDrag_AB
			if _Settings.Downforce_R_Enabled then
				DDownforceR = _Settings.DownforceR + DDownforceR_AB
			end
		end
	else
		if DRS then
			DDrag = _Settings.Drag_DRS + DDrag_AB
			if _Settings.Downforce_R_Enabled then
				DDownforceR = _Settings.DownforceR_DRS + DDownforceR_AB
			end
		else
			DDrag = _Settings.Drag + DDrag_AB
			if _Settings.Downforce_R_Enabled then
				DDownforceR = _Settings.DownforceR + DDownforceR_AB
			end
		end
	end
	-- Slipstream
	local toRay = workspace:Raycast(weight.Position, weight.CFrame.LookVector * 1000, aeroParams)
	_DragFactor = 1
	if toRay then
		aeroParamsFrom.FilterDescendantsInstances = toRay.Instance:GetConnectedParts()
		local fromRay = workspace:Raycast(toRay.Position, - toRay.Instance.Velocity * SlipstreamTime, aeroParamsFrom)
		if fromRay and fromRay.Instance:IsDescendantOf(vehicle) then
			_DragFactor = (1 - (Slipstream / 100)) + (fromRay.Distance / (toRay.Instance.Velocity * SlipstreamTime).Magnitude * (Slipstream / 100))
		end
	end
	-- Apply forces
	if _Settings.Diffuser_Enabled then
		local br = 0
		if _Settings.BD_Enabled then
			local br = -(_Settings.BlownDiffuser * values.Throttle.Value)
			local diffuserRay = workspace:Raycast(vehicle.Body.System.Aero.Diffuser.Position, - vehicle.Body.System.Aero.Diffuser.CFrame.UpVector * (vehicle.Body.System.Aero.Diffuser.Size.Y / .2), aeroParams)
			if _Settings.BlownDirect then
				if not diffuserRay then
					br = 0
				end
				weight:ApplyImpulseAtPosition(weight.CFrame.UpVector * dt * (br) * fromKGF, vehicle.Body.System.Aero.Diffuser.Position)
				vehicle.Body.System.Aero.Diffuser:SetAttribute("BDForce", br)
			end
		end
		local diff = (values.Velocity.Value - workspace.GlobalWind).Magnitude * toKMH
		if _Settings.BD_Enabled and not _Settings.BlownDirect then
			br = (_Settings.BlownDiffuser * values.Throttle.Value)
			dd = -(diff ^ 2 / (200) ^ 2) * (_Settings.DownforceD + br) * _DragFactor
		else
			dd = -(diff ^ 2 / (200) ^ 2) * (_Settings.DownforceD) * _DragFactor
		end
		local diffuserRay = workspace:Raycast(vehicle.Body.System.Aero.Diffuser.Position, - vehicle.Body.System.Aero.Diffuser.CFrame.UpVector * (vehicle.Body.System.Aero.Diffuser.Size.Y / .2), aeroParams)
		if not diffuserRay then
			dd = 0
		end
		weight:ApplyImpulseAtPosition(weight.CFrame.UpVector * dt * (dd) * fromKGF, vehicle.Body.System.Aero.Diffuser.Position)
		vehicle.Body.System.Aero.Diffuser:SetAttribute("Downforce", dd)
	end
	local diff = (values.Velocity.Value - workspace.GlobalWind).Magnitude * toKMH
	if _Settings.Downforce_F_Enabled then
		local df = -(diff ^ 2 / (200) ^ 2) * (_Settings.DownforceF) * _DragFactor
		weight:ApplyImpulseAtPosition(weight.CFrame.UpVector * dt * (df) * fromKGF, vehicle.Body.System.Aero.Downforce_F.Position)
		vehicle.Body.System.Aero.Downforce_F:SetAttribute("Downforce", df)
	end
	if _Settings.Downforce_R_Enabled then
		local dr = -(diff ^ 2 / (200) ^ 2) * (DDownforceR) * _DragFactor
		weight:ApplyImpulseAtPosition(weight.CFrame.UpVector * dt * (dr) * fromKGF, vehicle.Body.System.Aero.Downforce_R.Position)
		vehicle.Body.System.Aero.Downforce_R:SetAttribute("Downforce", dr)
	end
	local dragForce = diff ^ 2 * (DDrag / 100)
	weight:ApplyImpulseAtPosition(weight.CFrame.LookVector * dt * -dragForce * fromKGF, vehicle.Body.System.Aero.Drag.Position)
	vehicle.Body.System.Aero.Drag:SetAttribute("DragForce", dragForce)
end)

if not _Settings.Downforce_F_Enabled and downforce_f then
	downforce_f:destroy()
elseif not _Settings.Downforce_R_Enabled and downforce_r then
	downforce_r:destroy()
elseif not _Settings.Diffuser_Enabled and diffuser then
	diffuser:destroy()
end]]></ProtectedString>
