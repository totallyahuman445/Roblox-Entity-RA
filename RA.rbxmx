	task.wait(.5)
	if child:IsA("Weld") and game.Players:GetPlayerFromCharacter(child.Part1.Parent) ~= nil then
		script.Parent:SetAttribute("Occupied", true)
		humanoidrootpart = script.Parent.SeatWeld.Part1
		local PlayerModel = humanoidrootpart.Parent
		name = humanoidrootpart.Parent.Name
		script.Parent:SetAttribute("Username", name)
		rigtype = humanoidrootpart.Parent.Humanoid.RigType
		if rigtype == Enum.HumanoidRigType.R6 then
			script.Parent:SetAttribute("RigType", "R6")
			script.Parent.Values.AvatarRestore.R6.R6_1.Value = PlayerModel.Torso["Right Hip"].C0
			script.Parent.Values.AvatarRestore.R6.R6_2.Value = PlayerModel.Torso["Left Hip"].C0
			script.Parent.Values.AvatarRestore.R6.R6_3.Value = PlayerModel.Torso["Right Shoulder"].C0
			script.Parent.Values.AvatarRestore.R6.R6_4.Value = PlayerModel.Torso["Left Shoulder"].C0
			script.Parent.Values.AvatarRestore.R6.R6_5.Value = PlayerModel.Torso["Right Hip"].C1
			script.Parent.Values.AvatarRestore.R6.R6_6.Value = PlayerModel.Torso["Left Hip"].C1
			script.Parent.Values.AvatarRestore.R6.R6_7.Value = PlayerModel.Torso["Right Shoulder"].C1
			script.Parent.Values.AvatarRestore.R6.R6_8.Value = PlayerModel.Torso["Left Shoulder"].C1
		elseif rigtype == Enum.HumanoidRigType.R15 then
			script.Parent:SetAttribute("RigType", "R15")
		end
	end
end)

script.Parent.ChildRemoved:Connect(function(child2)
	if child2:IsA("Weld") and child2.Name == "SeatWeld" then
		script.Parent:SetAttribute("Occupied", false)
		local rigtype2 = script.Parent:GetAttribute("RigType")
		if rigtype2 == "R6" then
			humanoidrootpart.Parent.Torso["Right Hip"].C0 = script.Parent.Values.AvatarRestore.R6.R6_1.Value
			humanoidrootpart.Parent.Torso["Left Hip"].C0 = script.Parent.Values.AvatarRestore.R6.R6_2.Value
			humanoidrootpart.Parent.Torso["Right Shoulder"].C0 = script.Parent.Values.AvatarRestore.R6.R6_3.Value
			humanoidrootpart.Parent.Torso["Left Shoulder"].C0 = script.Parent.Values.AvatarRestore.R6.R6_4.Value
			humanoidrootpart.Parent.Torso["Right Hip"].C1 = script.Parent.Values.AvatarRestore.R6.R6_5.Value
			humanoidrootpart.Parent.Torso["Left Hip"].C1 = script.Parent.Values.AvatarRestore.R6.R6_6.Value
			humanoidrootpart.Parent.Torso["Right Shoulder"].C1 = script.Parent.Values.AvatarRestore.R6.R6_7.Value
			humanoidrootpart.Parent.Torso["Left Shoulder"].C1 = script.Parent.Values.AvatarRestore.R6.R6_8.Value
		end
	end
end)

-- 12 hour time
function UpdateClock()
	local minsAfterMid = game.Lighting:GetMinutesAfterMidnight()
	local hrs = math.floor(minsAfterMid / 60)
	local mins = math.floor(minsAfterMid % 60)
	local period = "AM"
	if hrs >= 12 then
		period = "PM"
		if hrs > 12 then
			hrs2 = hrs - 12
		else
			hrs2 = hrs
		end
	elseif hrs >= 0 then
		hrs2 = 12
	end
	local timestring = string.format("%02d:%02d", hrs, mins)
	local timestring2 = string.format("%2d:%02d", hrs2, mins)
	local timelabstring = string.format("%s", period)
	script.Parent.Values["24HourTime"].Value = timestring
	script.Parent.Values["12HourTime"].Value = timestring2.. " ".. timelabstring
end

while task.wait(1) do
	UpdateClock()
end]]></ProtectedString>
