				<Item class="Script" referent="RBX047676F64B2C4B25A11126E4EA0C23DF">
					<Properties>
						<ProtectedString name="Source"><![CDATA[if script.Parent.Sounds:FindFirstChild("BothSound") or script.Parent.Sounds:FindFirstChild("EnterSound") or script.Parent.Sounds:FindFirstChild("ExitSound") then
	script.Parent.Parent:GetAttributeChangedSignal("Occupied"):Connect(function()
		for i, v in pairs (script.Parent.Sounds:GetDescendants()) do
			if script.Parent.Parent:GetAttribute("Occupied") then
				if v.Name == "BothSound" or v.Name == "EnterSound" then
					v:Play()
				end
			else
				if v.Name == "BothSound" or v.Name == "ExitSound" then
					v:Play()
				end
			end
		end
	end)
else
	script.Parent:Destroy()
end]]></ProtectedString>
