							<ProtectedString name="Source"><![CDATA[script.Parent.ChildAdded:connect(function(child)
	task.wait(.5)
	if child:IsA("Weld") and game.Players:GetPlayerFromCharacter(child.Part1.Parent) ~= nil then
		script.Parent:SetAttribute("Occupied", true)
		humanoidrootpart = script.Parent.SeatWeld.Part1
		name = humanoidrootpart.Parent.Name
		script.Parent:SetAttribute("Username", name)
		rigtype = humanoidrootpart.Parent.Humanoid.RigType
		script.Parent:SetAttribute("RigType", rigtype)
	end
end)

script.Parent.ChildRemoved:Connect(function(child2)
	if child2:IsA("Weld") and child2.Name == "SeatWeld" then
		script.Parent:SetAttribute("Occupied", false)
	end
end)]]></ProtectedString>
