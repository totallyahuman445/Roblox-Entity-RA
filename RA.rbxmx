					<Item class="RemoteFunction" referent="RBXAC0EC62F784847508F413B7B0ABCD6D0">
						<Properties>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">ControlsDataStore</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
						<Item class="Script" referent="RBXF648893FD76444F1B4645D1D1F54D927">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local SettingsStore = DataStoreService:GetDataStore("FORTUNE_Controls_01")
local _Settings = require(script.Parent.Parent.Settings)
local vehicle = script.Parent.Parent

local function SaveData(UserId: number, Data: SharedTable): boolean
	local ValidData = true
	for Key, Value in pairs(_Settings.Controls) do
		if typeof(Data[Key]) ~= "string" then
			ValidData = false
		end
	end
	for Key, Value in pairs(_Settings.Peripherals) do
		if typeof(Data[Key]) ~= "number" then
			ValidData = false
		end
	end
	if #Data > #_Settings.Controls + #_Settings.Peripherals then
		ValidData = false
	end
	if not ValidData then
		warn("Invalid data") return false
	end
	local Success, ErrorMessage = pcall(function()
		SettingsStore:SetAsync(UserId, Data)
	end)
	if not Success then
		warn(ErrorMessage)
	end
	return Success
end

local function LoadData(UserId: number): SharedTable
	local Success, Data = pcall(function()
		vehicle.DriveSeat:SetAttribute("UserID", UserId)
		return SettingsStore:GetAsync(UserId)
	end)
	if not Success then
		warn("Error getting player data: " .. UserId)
	end
	return Data
end

local function HandleInvoke(Plr: Player, Save: boolean, Data: SharedTable)
	if Save then
		return SaveData(Plr.UserId, Data)
	else
		return LoadData(Plr.UserId)
	end
end
script.Parent.OnServerInvoke = HandleInvoke]]></ProtectedString>
