					<Item class="ModuleScript" referent="RBX61B7173E46EF414B9221D0C4595F45EC">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--[[ Welcome, tuner.
    ____  ___
   / __ \/   | Entity
  / /_/ / /| | Roblox self propelled land vehicle chassis
 / __ _/ ___ | 0.51.4
/_/ |_/_/  |_| GitHub:    https://github.com/totallyahuman445/Roblox-Entity-RA
               Discord:   https://discord.gg/bS2A448Vrk
               Community: https://www.roblox.com/share/g/206794047
			   THE List:  https://docs.google.com/document/d/1WvOWw7ST4ZWpsCfXM3abJTTBkCA40NsayIEIdCRJOYM/edit?usp=sharing
			   Log:		  https://docs.google.com/document/d/1SLW5NOAysg2rE6C52WEPnmOas_MNbeVNEv0xv2f__ps/edit?usp=sharing
			   Credits:   https://docs.google.com/document/d/1-mIgEhmugHfVUDz4vzZMS7XYMoEdLKedy0MedRqvbyA/edit?usp=sharing
]]
local module = {}
local vehicle = script.Parent.Parent.Vehicle.Value
local _Settings = require(script.Parent.Parent.Vehicle.Value.Settings)

module.EngineSounds = {
	--[[To add new engine sounds, create a table and place it in here with this format:
	{
		name			= string,                                 -- Sound name
		vol				= number,                                 -- Sound base volume
		type			= string,                                 -- "Accel", "Decel" and "Both"
		throtVolMult	= number,                                 -- Throttle multiplier
		revVolMult		= number,                                 -- RPM multiplier
		eq				= table {HighGain, MidGain, LowGain},     -- Engine equalizer
		decelEq			= table {HighGain, MidGain, LowGain},     -- Engine decel equalizer
		vvlEq			= table {HighGain, MidGain, LowGain},     -- VVL equalizer
		distortion      = number,                                 -- Sound distortion at redline with full throttle
		decelDistortion = number,                                 -- Sound distortion at redline with no throttle.
		pit				= number,		                          -- Base engine playback speed
		rev				= number,		                          -- Engine playback speed at redline
		throtPitMult	= number,                                 -- Pitch change multiplier for throttle as RPM rises.

		fadeStart		= table {Start Fade In, Finish Fade In},  -- First value is when the sound starts to fade in, second value is when the sound finishes fading (in RPM)
		fadeEnd			= table {Finish Fade Out, Fade Out Time}, -- First value is when the sound finishes to fading out, second value is  how long the sound fades out (in RPM)

		parent			= directory                               -- If not found in the specified part, will default to DriveSeat
	}]]
	{
		name			= "Exhaust",                         -- Sound name
		vol				= .2,		                         -- Sound base volume
		type            = "Both",                            -- "Accel", "Decel" and "Both"
		throtVolMult	= 3,		                         -- Throttle multiplier
		revVolMult		= 1.5,		                         -- RPM multiplier
		eq				= {-80, 0, 10},                      -- {HighGain, MidGain, LowGain}, Engine equalizer
		decelEq			= {55, 0, -5},                       -- {HighGain, MidGain, LowGain}, Engine decel equalizer
		vvlEq			= {80, 10, -10},                     -- {HighGain, MidGain, LowGain}, VVL equalizer
		distortion		= .2,		                         -- Sound distortion at redline with full throttle
		decelDistortion	= 0,		                         -- Sound distortion at redline with no throttle.
		pit				= 0,	                             -- Base engine playback speed
		rev				= 1.4,		                         -- Engine playback speed at redline
		throtPitMult	= 1.1,                               -- Pitch change multiplier for throttle as RPM rises.
		
		fadeStart		= {_Settings.IdleRPM, 200},	         -- First value is when the sound starts to fade in, second value is when the sound finishes fading (in RPM)
		fadeEnd			= {16001, 1},                        -- First value is when the sound finishes to fading out, second value is how long the sound fades out (in RPM)

		parent			= vehicle.Body.System.Sounds.Exhaust -- If not found in the specified part, will default to DriveSeat
	},
	{
		name			= "Engine",
		vol				= .1,		                         -- Sound base volume
		type            = "Both",                            -- "Accel", "Decel" and "Both"
		throtVolMult	= 3,		                         -- Throttle multiplier
		revVolMult		= 1.5,		                         -- RPM multiplier
		eq				= {-80, 5, 10},                      -- {HighGain, MidGain, LowGain}, Engine equalizer
		decelEq			= {55, 0, -5},                       -- {HighGain, MidGain, LowGain}, Engine decel equalizer
		vvlEq			= {0, 10, 0},                        -- {HighGain, MidGain, LowGain}, VVL equalizer
		distortion		= .1,		                         -- Sound distortion at redline with full throttle
		decelDistortion	= 0,		                         -- Sound distortion at redline with no throttle.
		pit				= 0,	                             -- Base engine playback speed
		rev				= 1,		                         -- Engine playback speed at redline
		throtPitMult	= 1.1,                               -- Pitch change multiplier for throttle as RPM rises.

		fadeStart		= {_Settings.IdleRPM, 200},	         -- First value is when the sound starts to fade in, second value is when the sound finishes fading (in RPM)
		fadeEnd			= {16001, 1},                        -- First value is when the sound finishes to fading out, second value is how long the sound fades out (in RPM)

		parent			= vehicle.Body.System.Sounds.Engine  -- If not found in the specified part, will default to DriveSeat
	},
	{
		name			= "Idle",
		vol				= 1,		                         -- Sound base volume
		type            = "Both",                            -- "Accel", "Decel" and "Both"
		throtVolMult	= 1,		                         -- Throttle multiplier
		revVolMult		= 1,		                         -- RPM multiplier
		eq				= {-80, 5, 10},                      -- {HighGain, MidGain, LowGain}, Engine equalizer
		decelEq			= {55, 0, -5},                       -- {HighGain, MidGain, LowGain}, Engine decel equalizer
		vvlEq			= {0, 10, 0},                        -- {HighGain, MidGain, LowGain}, VVL equalizer
		distortion		= .1,		                         -- Sound distortion at redline with full throttle
		decelDistortion	= 0,		                         -- Sound distortion at redline with no throttle.
		pit				= 1,	                             -- Base engine playback speed
		rev				= 1,		                         -- Engine playback speed at redline
		throtPitMult	= 1.1,                               -- Pitch change multiplier for throttle as RPM rises.

		fadeStart		= {_Settings.IdleRPM - 400, 200},    -- First value is when the sound starts to fade in, second value is when the sound finishes fading (in RPM)
		fadeEnd			= {_Settings.IdleRPM + 200, 200},    -- First value is when the sound finishes to fading out, second value is how long the sound fades out (in RPM)

		parent			= vehicle.Body.System.Sounds.Exhaust -- If not found in the specified part, will default to DriveSeat
	},
}

module.Shift_Sound      = false -- Enables a sound that plays when the gear changes.

module.Crackles         = {
	CracklesEnabled     = false, -- Enables lift off crackles.
	CracklesCount       = 5,     -- The amount of crackles sounds you have.
	CracklesThreshold   = .85    -- Percentage of ShiftRpm required to start crackles (0 - 100 (85% means .85)).
}

module.TurboSounds = {
	--[[To add new turbo sounds, create a table and place it in here with this format:
	{
		name			= string,    -- Sound name
		vol				= number,    -- Volume per 0.068 bar
		pitch           = number,    -- Base Pitch
		pitchIncrease   = number,    -- Pitch increase per 0.068 bar
		
		parent          = directory  -- If not found in the specified part, will default to DriveSeat
	}
]]
	{
		name			= "Turbo",                           -- Sound name
		vol				= .01,                               -- Volume per 0.068 bar
		pitch			= 1,                                 -- Base Pitch
		pitchIncrease	= .05,                               -- Pitch increase per 0.068 bar
		
		parent          = vehicle.Body.System.Sounds.Engine  -- If not found in the specified part, will default to DriveSeat
	},
	{
		name			= "Turbo2",                          -- Sound name
		vol				= .03,                               -- Volume per 0.068 bar
		pitch			= .2,                                -- Base Pitch
		pitchIncrease	= .5,                                -- Pitch increase per 0.068 bar

		parent          = vehicle.Body.System.Sounds.Engine  -- If not found in the specified part, will default to DriveSeat
	},
}

module.SuperSounds = {
	-- Same format as turbo.
	{
		name			= "Supercharger",
		vol				= .5,                                -- Per 0.068 bar
		pitch			= .8,                                -- Base pitch
		pitchIncrease	= .05,                               -- Per 0.068 bar
		
		parent          = vehicle.Body.System.Sounds.Engine  -- If not found in the specified part, will default to DriveSeat
	}
}

module.BovSounds = {
	-- Also the Same format as turbo.
	{
		name			= "BOV",
		sensitivity		= 1,
		vol				= .025,                              -- Per 0.068 bar
		pitch			= .7,                                -- Base pitch
		pitchIncrease	= .05,                               -- Per 0.068 bar

		parent          = vehicle.Body.System.Sounds.Engine  -- If not found in the specified part, will default to DriveSeat
	}
}

module.TransmissionSounds = {
	--[[To add new transmission sounds, create a table and place it in here with this format:
	{
		name		  = string,                   -- Sound name
		vol		      = number,                   -- Sound base volume
		clutchVol     = number,                   -- Volume when the clutch is fully pressed
		offVol        = number,                   -- Minimum volume during low load.
		pitch         = number,                   -- Pitch At 300 km/h
		gear          = table {(All your gears)}, -- Gears that this transmission sound is enabled. If not enabled, the volume will go to "offVol"
		
		parent        = directory                 -- If not found in the specified part, will default to DriveSeat
	}
]]
	{
		name	  = "Transmission",
		vol		  = 3,                                -- Sound base volume
		clutchVol = .1,                               -- Volume when the clutch is fully pressed
		offVol	  = .1,                               -- Minimum volume during low load.
		pitch	  = 1.5,                              -- Pitch At 300 km/h
		gear	  = {1, 2, 3, 4, 5, 6},               -- Gears that this transmission sound is enabled. If not enabled, the volume will go to "offVol"

		parent    = vehicle.Body.System.Sounds.Engine -- If not found in the specified part, will default to DriveSeat
	},
}
return module]]></ProtectedString>
