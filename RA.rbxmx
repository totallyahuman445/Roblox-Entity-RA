					<Properties>
						<ProtectedString name="Source"><![CDATA[task.wait(.65)
local Vehicle = script.Parent.Vehicle.Value
local Occupied = Vehicle.DriveSeat:GetAttribute("Occupied")
local Username = Vehicle.DriveSeat:GetAttribute("Username")
local RigType = Vehicle.DriveSeat:GetAttribute("RigType")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local handler = Vehicle:WaitForChild("Inverse_Kinematics")
local User = Workspace:WaitForChild(Username)

local LeftArmTarget = script.LeftArm.Value
local RightArmTarget = script.RightArm.Value
local LeftLegTarget = script.LeftLeg.Value
local RightLegTarget = script.RightLeg.Value

if RigType == ("R6") then
	R6IKArm = require(script.IKB.R6.Arm)
	R6IKLeg = require(script.IKB.R6.Leg)
	LeftArmIK = R6IKArm.new(User, "Left")
	RightArmIK = R6IKArm.new(User, "Right")
	LeftLegIK = R6IKLeg.new(User, "Left")
	RightLegIK = R6IKLeg.new(User, "Right")
end

if User.Head:FindFirstChild("Neck") and User.Head.Neck:IsA("AnimationConstraint") then
	
else
	local UpdateLoop = RunService.Heartbeat:Connect(function()
		LeftArmIK:Solve(LeftArmTarget.Position)
		RightArmIK:Solve(RightArmTarget.Position)
		LeftLegIK:Solve(LeftLegTarget.Position)
		RightLegIK:Solve(RightLegTarget.Position)
	end)
end

if User.Head:FindFirstChild("Neck") and User.Head.Neck:IsA("AnimationConstraint") then
	
else
	while task.wait(.143) do
		if RigType == ("R6") then
			handler:FireServer(User.Torso["Left Shoulder"].C0, User.Torso["Left Shoulder"].C1, User.Torso["Right Shoulder"].C0, User.Torso["Right Shoulder"].C1, User.Torso["Left Hip"].C0, User.Torso["Left Hip"].C1, User.Torso["Right Hip"].C0, User.Torso["Right Hip"].C1)
		end
	end
end]]></ProtectedString>
