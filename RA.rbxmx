						<Item class="Script" referent="RBXDD3AD2D8354A4813A8F54634946E0488">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local vehicle = script.Parent.Parent
local F = {}

F.SetSound = function(soundname)
end

F.StopSound = function(soundname)
	vehicle.DriveSeat.InteriorSounds[soundname]:Stop()
end

F.PlaySound = function(soundname)
	vehicle.DriveSeat.InteriorSounds[soundname]:Play()
end

script.Parent.OnServerEvent:connect(function(pl, Fnc, ...)
	F[Fnc](...)
end)]]></ProtectedString>
								<bool name="Disabled">true</bool>
								<Content name="LinkedSource"><null></null></Content>
								<token name="RunContext">0</token>
								<string name="ScriptGuid">{BB2CFB16-479A-4820-88D1-8D4172E6021E}</string>
								<BinaryString name="AttributesSerialize"></BinaryString>
								<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
								<bool name="DefinesCapabilities">false</bool>
								<string name="Name">Handler</string>
								<int64 name="SourceAssetId">-1</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							</Properties>
						</Item>
					</Item>
				</Item>
				<Item class="LocalScript" referent="RBX9B5243D0600C447AB19B55C13DB6AA0F">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--[[					                          THIS IS NOT WHERE YOU EDIT VALUES. IT IS INSIDE "Edit" UNDER THIS SCRIPT.												]]
-- Variables
local EngineSounds = {}
local TurboSounds = {}
local SuperSounds = {}
local BOVSounds = {}
local TransSounds = {}

local vehicle = script.Parent.Vehicle.Value
local values = script.Parent.Values
local _Settings = require(vehicle.Settings)
local Wheels = vehicle.Wheels
local children = Wheels:GetChildren()
local vars = require(script.Edit)
local hb = game:GetService("RunService").Heartbeat
local handler = vehicle:WaitForChild("Sounds")
local handler2 = vehicle:WaitForChild("Crackles")
local handler3 = vehicle:WaitForChild("Shift_Sound")
local handler4 = vehicle:WaitForChild("Brake_Squeal")
local handler5 = vehicle:WaitForChild("Brake_Squeal2")
local transmissionsound = true
values:WaitForChild("DriveReady")

local prevBoost = -1000
local lastBOV = tick() -- debounce method

-- Functions
local function create()
	table.clear(EngineSounds)
	table.clear(TurboSounds)
	table.clear(SuperSounds)
	table.clear(BOVSounds)
	table.clear(TransSounds)
	for i, v in next, vars.EngineSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(EngineSounds, i, ns)
	end
	for i, v in next, vars.TurboSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(TurboSounds, i, ns)
	end
	for i, v in next, vars.SuperSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(SuperSounds, i, ns)
	end
	for i, v in next, vars.BovSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(BOVSounds, i, ns)
	end
	for i, v in next, vars.TransmissionSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(TransSounds, i, ns)
	end
end

local function getWheelSpeed()
	local total = 0
	local count = 0
	for _, v in next, values.WheelSpeeds:GetChildren() do
		if _Settings.Config == "FWD" or _Settings.Config == "MWD" then
			if v.Name == "R" or v.Name == "RL" or v.Name == "RR" then
				continue
			end
		elseif _Settings.Config == "RWD" then
			if v.Name == "F" or v.Name == "FL" or v.Name == "FR" then
				continue
			end
		end
		total += v.Value
		count += 1
	end
	total /= count
	return total
end

local function gain(data, x)
	local vvl = math.max(-(1 - _Settings.VVLSharpness) ^ (values.RPM.Value / 1000 - _Settings.VVLTime) + _Settings.VVLValue, 0) / math.max(-(1 - _Settings.VVLSharpness) ^ (_Settings.Redline / 1000 - _Settings.VVLTime) + _Settings.VVLValue, .001) * data.vvlEq[x]
	return data.eq[x] + (data.decelEq[x] * (1 - values.Throttle.Value)) + vvl
end

local function update()
	if vars.Crackles.CracklesEnabled then
		math.randomseed(tick())
		local randomability = math.random(1, vars.Crackles.CracklesCount)
		local threshold = _Settings.ShiftRPM * vars.Crackles.CracklesThreshold
		local throtOff = script.Parent.Values.RPM.Value > threshold and script.Parent.Values.Throttle.Value <= _Settings.IdleThrottle / 100
		if throtOff and not debounce then
			debounce = true
			handler2:FireServer("Crackle", randomability)
		elseif not throtOff then
			debounce = false
		end
	end
	for i, data in next, vars.EngineSounds do
		local fade = math.clamp(1 / data.fadeStart[2] * values.RPM.Value - data.fadeStart[1] * (1 / data.fadeStart[2]), 0, math.clamp(data.fadeEnd[1] * (1 / data.fadeEnd[2]) - (1 / data.fadeEnd[2]) * values.RPM.Value, 0, 1))
		local vol = data.vol * ((data.throtVolMult - 1) * values.Throttle.Value + 1) * ((data.revVolMult - 1) * (values.RPM.Value / _Settings.Redline) + 1) * fade
		local pit = data.pit + (data.rev - data.pit) * (values.RPM.Value / _Settings.Redline) * ((data.throtPitMult - 1) * values.Throttle.Value + 1)
		if values.InputThrottle.Value > 0 then
			if data.type == "Both" or data.type == "Accel" then
				engaged = true
			else
				engaged = false
			end
		else
			if data.type == "Both" or data.type == "Decel" then
				engaged = true
			else
				engaged = false
			end
		end
		local highGain = gain(data, 1)
		local midGain = gain(data, 2)
		local lowGain = gain(data, 3)
		local level = data.decelDistortion + (data.distortion - data.decelDistortion) * (values.RPM.Value / _Settings.Redline)
		handler:FireServer("updateEngine", vehicle, i, vol, engaged, pit, highGain, midGain, lowGain, level)
	end
	for i, data in next, vars.TurboSounds do
		local vol = data.vol * values.BoostTurbo.Value
		local pit = data.pitch + data.pitchIncrease * values.BoostTurbo.Value
		handler:FireServer("updateTurbo", vehicle, i, vol, pit)
	end
	for i, data in next, vars.SuperSounds do
		local vol = data.vol * values.BoostSuper.Value
		local pit = data.pitch + data.pitchIncrease * values.BoostSuper.Value
		handler:FireServer("updateSuper", vehicle, i, vol, pit)
	end
	local updateLastBOV = false
	for i, data in next, vars.BovSounds do
		local vol = data.vol * values.BoostTurbo.Value
		local pit = data.pitch + data.pitchIncrease * values.BoostTurbo.Value

		if (values.BoostTurbo.Value + data.sensitivity < prevBoost) and (tick() - lastBOV > .5) and values.Throttle.Value < .8 then
			updateLastBOV = true
			handler:FireServer("updateBOV", vehicle, i, vol, pit)
		end
		prevBoost = values.BoostTurbo.Value
	end
	if updateLastBOV then
		lastBOV = tick()
	end
	for i, data in next, vars.TransmissionSounds do
		local vol = data.vol - values.Clutch.Value * (data.vol - data.clutchVol)
		local off = true
		for i, v in next, data.gear do
			if v == values.Gear.Value then
				off = false
			end
		end
		if off then
			vol = data.offVol
		end
		local pit = data.pitch * (getWheelSpeed() / 298.2579)
		handler:FireServer("updateTrans", vehicle, i, vol, pit)
	end
end

-- Run
handler:FireServer("remove")
handler:FireServer("create", vehicle, vars)
handler:FireServer("play")

for i, v in pairs(children) do
	local child = v
	squealenabled = child.Values.Squeal.Value
	if squealenabled then
		script.Parent.Values.Brake.Changed:connect(function()
			if script.Parent.Values.Brake.Value == 1 and vehicle.DriveSeat.Velocity.Magnitude > 4 then
				handler4:FireServer(true)
			else
				handler5:FireServer(true)
			end
		end)
	end
end

script.Parent.Values.Gear.Changed:connect(function()
	if vars.Shift_Sound then
		vehicle.Body.System.Sounds.Transmission.ShiftSound:Play()
		handler3:FireServer(true)
	end
end)

script.Parent.Values.IsOn.Changed:connect(function()
	if script.Parent.Values.IsOn.Value then
		handler:FireServer("play")
	else
		handler:FireServer("stop")
	end
end)

while task.wait(1 / 24) do
	update()
end]]></ProtectedString>
