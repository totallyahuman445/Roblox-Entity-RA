						</Properties>
						<Item class="Script" referent="RBXCC4E8E6F26524CC189EC886EB9E26264">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local EngineSounds = {}
local TurboSounds = {}
local SuperSounds = {}
local BOVSounds = {}
local TransSounds = {}

local function create(vehicle, vars)
	table.clear(EngineSounds)
	table.clear(TurboSounds)
	table.clear(SuperSounds)
	table.clear(BOVSounds)
	table.clear(TransSounds)
	for i, v in next, vars.EngineSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(EngineSounds, i, ns)
	end
	for i, v in next, vars.TurboSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(TurboSounds, i, ns)
	end
	for i, v in next, vars.SuperSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(SuperSounds, i, ns)
	end
	for i, v in next, vars.BovSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(BOVSounds, i, ns)
	end
	for i, v in next, vars.TransmissionSounds do
		local nd = script:FindFirstChild(v.name)
		local ns = nd:Clone()
		local success, errormessage = pcall(function()
			ns.Parent = v.parent
		end)
		if not success then
			ns.Parent = vehicle.DriveSeat
		end
		table.insert(TransSounds, i, ns)
	end
end

local function updateEngine(i, vol, engaged, pit, highGain, midGain, lowGain, level)
	local v = EngineSounds[i]
	if engaged then
		v.Volume = vol
	else
		v.Volume = 0
	end
	v.PlaybackSpeed = pit
	v.Equalizer.HighGain = highGain
	v.Equalizer.MidGain = midGain
	v.Equalizer.LowGain = lowGain
	v.Distortion.Level = level
end

local function updateTurbo(i, vol, pit)
	local v = TurboSounds[i]
	v.Volume = vol
	v.PlaybackSpeed = pit
end

local function updateSuper(i, vol, pit)
	local v = SuperSounds[i]
	v.Volume = vol
	v.PlaybackSpeed = pit
end

local function updateBOV(i, vol, pit)
	local v = BOVSounds[i]
	v.Volume = vol
	v.PlaybackSpeed = pit
	v:Play()
end

local function updateTrans(i, vol, pit)
	local v = TransSounds[i]
	v.Volume = vol
	v.PlaybackSpeed = pit
end

local function play()
	for _, v in next, EngineSounds do
		v:Play()
	end
	for _, v in next, TurboSounds do
		v:Play()
	end
	for _, v in next, SuperSounds do
		v:Play()
	end
	for _, v in next, TransSounds do
		v:Play()
	end
end

local function stop()
	for _, v in next, EngineSounds do
		v:Stop()
	end
	for _, v in next, TurboSounds do
		v:Stop()
	end
	for _, v in next, SuperSounds do
		v:Stop()
	end
	for _, v in next, TransSounds do
		v:Stop()
	end
end

local function remove()
	for _, v in next, EngineSounds do
		v:Destroy()
	end
	for _, v in next, TurboSounds do
		v:Destroy()
	end
	for _, v in next, SuperSounds do
		v:Destroy()
	end
	for _, v in next, BOVSounds do
		v:Destroy()
	end
	for _, v in next, TransSounds do
		v:Destroy()
	end
end

script.Parent.OnServerEvent:Connect(function(player, func, vehicle, ...)
	if func == "create" then
		create(vehicle, ...)
	elseif func == "updateEngine" then
		updateEngine(...)
	elseif func == "updateTurbo" then
		updateTurbo(...)
	elseif func == "updateSuper" then
		updateSuper(...)
	elseif func == "updateBOV" then
		updateBOV(...)
	elseif func == "updateTrans" then
		updateTrans(...)
	elseif func == "play" then
		play()
	elseif func == "stop" then
		stop()
	elseif func == "remove" then
		remove()
	end
end)]]></ProtectedString>
