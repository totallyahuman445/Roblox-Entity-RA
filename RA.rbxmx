						<Item class="Script" referent="RBX52062F3B14D847EB949A104F1D64406C">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local vehicle = script.Parent.Parent
local Wheels = vehicle.Wheels
local children = Wheels:GetChildren()
local Brake = script.Brake
local TweenService = game:GetService("TweenService")

for i, v in pairs(children) do
	local child = v
	local squealenabled = child.Values.Squeal.Value
	if squealenabled then
		local Brake_real = Brake:Clone()
		Brake_real.Parent = child.WheelFixed.WheelBottom
		Brake_real:Play()
		script.Parent.OnServerEvent:connect(function(Squeal, On)
			if On then
				TweenService:Create(Brake_real, TweenInfo.new(.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.InOut),{
				["Volume"] = .5,
				}):Play()
				TweenService:Create(Brake_real, TweenInfo.new(.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.InOut),{
				["PlaybackSpeed"] = .9,
				}):Play()
			elseif Brake_real.Volume > 0 then
				TweenService:Create(Brake_real, TweenInfo.new(.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.InOut),{
				["Volume"] = 0,
				}):Play()
			end
		end)
	end
end
]]></ProtectedString>
