local CHASSISNAMEREMOVE = false -- For game developers who don't want the chassis name to be visible, your actions have been noted.

local COLOR_PRIMARY = Color3.fromRGB(0, 0, 0)
local COLOR_SECONDARY = Color3.fromRGB(255, 0, 0)
local COLOR_BASE = Color3.fromRGB(0, 0, 0)
local COLOR_TAB = Color3.fromRGB(255, 0, 0)
local COLOR_DISTRIBUTOR = "rgb(255, 0, 0)"

local BEEP = true -- Adds a customizable beep when opening the controls.
-----------------------------------------------------------------------------------------------------------------------------------
local ControlsValues = script.Parent.Parent:WaitForChild("Controls")
local Window = script.Parent:WaitForChild("Window")
local Toggle = script.Parent:WaitForChild("Toggle")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Vehicle = script.Parent.Parent.Vehicle.Value
local _Settings = require(Vehicle.Settings)
local Remote = Vehicle:WaitForChild("ControlsDataStore")
local Mouse = game.Players.LocalPlayer:GetMouse()
local ControlsPanelOpen = false
local UISConnection = nil
local ButtonConnections = {}

local function ResetAllPanels()
	for _, Panel in pairs(Window.Content:GetChildren()) do
		if Panel:IsA("ScrollingFrame") then
			Panel.Visible = false
		end
	end
	for _, Button in pairs(Window.Tabs:GetChildren()) do
		if Button:IsA("TextButton") then
			local goal = {}
			goal.BackgroundColor3 = COLOR_BASE
			local tweenInfo = TweenInfo.new(.25)
			local tween = TweenService:Create(Button, tweenInfo, goal)
			Button.Transparency = .7
			Button.UIGradient.Enabled = true
			Button.TextTransparency = 0
			tween:Play()
		end
	end
end

if not BEEP then
	script.Parent.Beep:Destroy()
end

local function KeyboardPanel()
	ResetAllPanels()
	Window.Content.Keyboard.Visible = true
	local goal = {}
	goal.BackgroundColor3 = COLOR_TAB
	goal.Transparency = 0
	local tweenInfo = TweenInfo.new(.25)
	local tween = TweenService:Create(Window.Tabs.Keyboard, tweenInfo, goal)
	tween:Play()
	Window.Tabs.Keyboard.UIGradient.Enabled = false
end

local function MousePanel()
	ResetAllPanels()
	Window.Content.Mouse.Visible = true
	local goal = {}
	goal.BackgroundColor3 = COLOR_TAB
	goal.Transparency = 0
	local tweenInfo = TweenInfo.new(.25)
	local tween = TweenService:Create(Window.Tabs.Mouse, tweenInfo, goal)
	tween:Play()
	Window.Tabs.Mouse.UIGradient.Enabled = false
end

local function ControllerPanel()
	ResetAllPanels()
	Window.Content.Controller.Visible = true
	local goal = {}
	goal.BackgroundColor3 = COLOR_TAB
	goal.Transparency = 0
	local tweenInfo = TweenInfo.new(.25)
	local tween = TweenService:Create(Window.Tabs.Controller, tweenInfo, goal)
	tween:Play()
	Window.Tabs.Controller.UIGradient.Enabled = false
end

local function MobilePanel()
	ResetAllPanels()
	Window.Content.Mobile.Visible = true
	local goal = {}
	goal.BackgroundColor3 = COLOR_TAB
	goal.Transparency = 0
	local tweenInfo = TweenInfo.new(.25)
	local tween = TweenService:Create(Window.Tabs.Mobile, tweenInfo, goal)
	tween:Play()
	Window.Tabs.Mobile.UIGradient.Enabled = false
end

local function InvalidInput()
	for i = 1, 3 do
		Window.BackgroundColor3 = Color3.new(1, 0, 0)
		task.wait(.1)
		Window.BackgroundColor3 = Color3.new(0, 0, 0)
		task.wait(.1)
	end
end

local function StartListening()
	for Key,_ in pairs(_Settings.Controls) do
		if table.find(LOCKED_CONTROLS, Key) then
			continue;
		end
		local Frame = Window.Content.Keyboard
		if string.find(Key, "Mouse") and Key ~= "ToggleMouseDrive" then
			Frame = Window.Content.Mouse
		elseif string.find(Key, "Contlr") then
			Frame = Window.Content.Controller
		end
		local Connection = Frame.Buttons[Key].MouseButton1Click:Connect(function()
			Window.Overlay.Visible = true
			local InputDetected = nil
			local InputTypeDetected = nil
			if UISConnection ~= nil then
				UISConnection:Disconnect()
			end
			UISConnection = UserInputService.InputBegan:Connect(function(Input: InputObject)
				InputDetected = Input.KeyCode
				InputTypeDetected = Input.UserInputType
			end)
			-- Halt thread until input
			repeat task.wait() until InputDetected ~= nil
			UISConnection:Disconnect()
			Window.Overlay.Visible = false
			for _, Key in pairs(IGNORED_KEYBINDS) do
				if InputDetected == Key then
					return
				end
			end
			local InputType = Frame.Name
			local EnumInput = Enum.UserInputType
			-- Input validation
			local KeyboardInput = (InputType == "Keyboard" and InputTypeDetected == EnumInput.Keyboard)
			local MouseInputMouseButton = (InputType == "Mouse" and (InputTypeDetected == EnumInput.MouseButton1 or InputType == EnumInput.MouseButton2))
			local MouseInputKeyboard = (InputType == "Mouse" and InputTypeDetected == EnumInput.Keyboard)
			local ControllerInput = (InputType == "Controller" and string.find(InputTypeDetected.Name, "Gamepad")) -- Up to 8 different gamepads, just check if gamepad
			if KeyboardInput or MouseInputMouseButton or MouseInputKeyboard or ControllerInput then
				ControlsValues[Key].Value = InputDetected.Name
				Frame.Buttons[Key].Text = InputDetected.Name
				-- Mouse buttons don't have keycodes
				if MouseInputMouseButton then
					ControlsValues[Key].Value = InputType.Name
					Frame.Buttons[Key].Text = InputType.Name
				end
				if table.find(Hold_Keybinds, Key) then
					Frame.Buttons[Key].Text = "Hold "..Frame.Buttons[Key].Text
				end
				if table.find(Double_Keybinds, Key) then
					Frame.Buttons[Key].Text = Frame.Buttons[Key].Text.." X2"
				end
			else
				InvalidInput()
			end
		end)
		table.insert(ButtonConnections, Connection)
	end
	local MouseDown = false
	local MouseUpConnection = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			MouseDown = false
		end
	end)
	table.insert(ButtonConnections, MouseUpConnection)
	for Key,_ in pairs(_Settings.Peripherals) do
		local Frame = Window.Content.Mouse
		if string.find(Key, "Control") then
			Frame = Window.Content.Controller
		end
		local RenderSteppedConnection = nil
		local MouseDownConnection = Frame.Buttons[Key].Slider.Button.MouseButton1Down:Connect(function()
			MouseDown = true
			local Slider = Frame.Buttons[Key].Slider
			-- Save initial positions
			local MouseInitialPosX = Mouse.X
			local SliderInitialPosX = Slider.Button.Position.X.Scale
			local SliderSizeX = Slider.Bar.AbsoluteSize.X
			local AbsoluteSliderPosition = SliderInitialPosX * SliderSizeX
			local function Update()
				if not MouseDown then
					RenderSteppedConnection:Disconnect()
				end
				local MouseChangePosX = math.clamp(Mouse.X - MouseInitialPosX, -AbsoluteSliderPosition, SliderSizeX - AbsoluteSliderPosition)
				local ChangePosX = MouseChangePosX / SliderSizeX
				local Percent = SliderInitialPosX + ChangePosX
				Slider.Button.Position = UDim2.new(Percent, 0, Slider.Button.Position.Y.Scale, 0)
				Slider.Parent.Percent.Text = math.floor((Percent) * 100) .. "%"
				ControlsValues[Key].Value = math.floor((Percent) * 100)
			end
			RenderSteppedConnection = RunService.RenderStepped:Connect(Update)
			table.insert(ButtonConnections, RenderSteppedConnection)
		end)
		local TextBoxFocusConnection = Frame.Buttons[Key].Percent.FocusLost:Connect(function()
			local Textbox = Frame.Buttons[Key].Percent
			local Slider = Textbox.Parent.Slider
			local Percentage = tonumber(Textbox.Text)
			if Percentage then
				Percentage = math.clamp(Percentage, 0, 100)
				Percentage = math.floor(Percentage)
				Slider.Button.Position = UDim2.new(Percentage / 100, 0, Slider.Button.Position.Y.Scale, 0)
			else
				Percentage = math.floor((Slider.Button.Position.X.Scale) * 100)
			end
			Textbox.Text = Percentage .. "%"
			ControlsValues[Key].Value = Percentage
		end)
		table.insert(ButtonConnections, MouseDownConnection)
		table.insert(ButtonConnections, TextBoxFocusConnection)
	end
end

local function StopListening()
	for _, Connection in pairs(ButtonConnections) do
		Connection:Disconnect()
	end
	local Data = {}
	for _, ValueObject in pairs(ControlsValues:GetChildren()) do
		Data[ValueObject.Name] = ValueObject.Value
	end
	local Success = Remote:InvokeServer(true, Data)
	-- Maybe add visuals to show if settings not saved
end

local function ToggleControlsPanel()
	ControlsPanelOpen = not ControlsPanelOpen
	if ControlsPanelOpen then
		Window:TweenPosition(UDim2.new(.5, 0, .48, -30), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, .7, true)
		local goal = {}
		goal.BackgroundColor3 = COLOR_SECONDARY
		local tweenInfo = TweenInfo.new(.25)
		local tween = TweenService:Create(Toggle, tweenInfo, goal)
		tween:Play()
		if BEEP then
			if not script.Parent.Beep.Playing then
				script.Parent.Beep:Play()
			end
		end
		StartListening()
	else
		Window:TweenPosition(UDim2.new(.5, 0, -.7, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, .7, true)
		local goal = {}
		goal.BackgroundColor3 = COLOR_PRIMARY
		local tweenInfo = TweenInfo.new(.25)
		local tween = TweenService:Create(Toggle, tweenInfo, goal)
		tween:Play()
		StopListening()
	end
end

local function Init()
	if CHASSISNAMEREMOVE then
		Window.Chassis:Destroy()
	else
		Window.Chassis.Text = "<b><font color = '" ..COLOR_DISTRIBUTOR .."'>" ..Vehicle.Settings.Chassis.Distributor.Value .."</font></b> " ..Vehicle.Settings.Chassis.ChassisName.Value .." " ..Vehicle.Settings.Chassis.Version.Value -- Distributor, name and version are here.
	end
	-- Setup
	KeyboardPanel()
	Toggle.Position = UDim2.new(.5, 0, 1, 10)
	Window.Position = UDim2.new(.5, 0, -.7, 0)
	local SavedControls = Remote:InvokeServer(false)
	-- Populate panels
	for InputType, SortingData in pairs(SORTING_PRIORITY) do
		local Frame = Window.Content[InputType]
		Frame.CanvasSize = UDim2.new(0, 0, 1, (#SortingData) * 57)
		local ButtonsFrame = Window.Content._TemplateButtons:Clone()
		local LabelsFrame = Window.Content._TemplateLabels:Clone()
		ButtonsFrame.Parent = Frame
		ButtonsFrame.Name = "Buttons"
		LabelsFrame.Parent = Frame
		LabelsFrame.Name = "Labels"
		for Index, ValueName in pairs(SortingData) do
			local Button = ButtonsFrame._TemplateButton:Clone()
			local Label = LabelsFrame._TemplateLabel:Clone()
			if _Settings.Controls[ValueName] == nil or table.find(LOCKED_CONTROLS, ValueName) then
				Button.BackgroundTransparency = 1
				-- Mouse steer is not in the _Settings
				if ValueName == "MouseSteer" then
					Button.Text = "Mouse Move"
				elseif ValueName == "ContlrShiftUp" then
					Button.Text = "Right Joystick Down"
				elseif ValueName == "ContlrShiftDown" then
					Button.Text = "Right Joystick Up"
				elseif ValueName == "ContlrWheelieUp" then
					Button.Text = "Left Joystick Down"
				elseif ValueName == "ContlrWheelieDown" then
					Button.Text = "Left Joystick Up"
				elseif ValueName == "ContlrRotateRight" then
					Button.Text = "Right Joystick Left"
				elseif ValueName == "ContlrRotateLeft" then
					Button.Text = "Right Joystick Right"
				else
					Button.Text = _Settings.Controls[ValueName].Name
				end
			else
				Button.Text = _Settings.Controls[ValueName].Name
				if SavedControls ~= nil and SavedControls[ValueName] ~= nil then
					Button.Text = SavedControls[ValueName]
					ControlsValues[ValueName].Value = SavedControls[ValueName]
				end
			end
			if table.find(Hold_Keybinds, ValueName) then
				Button.Text = "Hold "..Button.Text
			end
			if table.find(Double_Keybinds, ValueName) then
				Button.Text = Button.Text.." X2"
			end
			-- Secondary controls
			if _Settings.Controls[ValueName .. "2"] ~= nil then
				local SecondaryButton = Button:Clone()
				SecondaryButton.Text = _Settings.Controls[ValueName .. "2"].Name
				SecondaryButton.Visible = true
				SecondaryButton.Name = ValueName .. "2"
				SecondaryButton.AnchorPoint = Vector2.new(1, 0)
				SecondaryButton.Position = UDim2.new(.95, 0, 0, 55 * (Index - 1) + 5)
				SecondaryButton.Parent = Frame.Buttons
				Button.Size = UDim2.new(.425, 0, 0, 50)
				SecondaryButton.Size = UDim2.new(.425, 0, 0, 50)
			end
			Button.Visible = true
			Button.Name = ValueName
			Button.Position = UDim2.new(.05, 0, 0, 55 * (Index - 1) + 5)
			Button.Parent = ButtonsFrame
			Label.Visible = true
			Label.Name = ValueName
			Label.Text = ValueName
			Label.Position = UDim2.new(.5, 0, 0, 55 * (Index - 1) + 5)
			Label.Parent = LabelsFrame
		end
		if PERIPHERALS_SORTING_PRIORITY[InputType] == nil then
			continue
		end
		-- Peripherals
		for Index, ValueName in pairs(PERIPHERALS_SORTING_PRIORITY[InputType]) do
			local Slider = ButtonsFrame._TemplateSlider:Clone()
			local Label = LabelsFrame._TemplateLabel:Clone()
			Slider.Slider.Button.Position = UDim2.new(_Settings.Peripherals[ValueName] / 100, 0, .5, 0)
			Slider.Percent.Text = _Settings.Peripherals[ValueName] .. "%"
			Slider.Visible = true
			Slider.Name = ValueName
			Slider.Position = UDim2.new(.05, 0, 0, 55 * (#SortingData + Index - 1) + 5)
			Slider.Parent = ButtonsFrame
			Label.Visible = true
			Label.Name = ValueName
			Label.Text = ValueName
			Label.Position = UDim2.new(.5, 0, 0, 55 * (#SortingData + Index - 1) + 5)
			Label.Parent = LabelsFrame
		end
	end
	-- Get rid of the templates now that they aren't needed anymore.
	Window.Content._TemplateButtons:Destroy()
	Window.Content._TemplateLabels:Destroy()
	-- Events
	Toggle.MouseButton1Click:Connect(ToggleControlsPanel)
	Window.Close.MouseButton1Click:Connect(ToggleControlsPanel)
	Window.Tabs.Keyboard.MouseButton1Click:Connect(KeyboardPanel)
	Window.Tabs.Mouse.MouseButton1Click:Connect(MousePanel)
	Window.Tabs.Controller.MouseButton1Click:Connect(ControllerPanel)
	Window.Tabs.Mobile.MouseButton1Click:Connect(MobilePanel)
	-- Animate toggle button
	task.wait(.5)
	Toggle:TweenPosition(UDim2.new(.5, 0, 1, -150), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, .4, false)
	for i = 1, 6 do
		Toggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
		task.wait(.2)
		Toggle.BackgroundColor3 = COLOR_PRIMARY
		-- Flash red instead
		if ControlsPanelOpen then
			Toggle.BackgroundColor3 = COLOR_SECONDARY
		end
		task.wait(.2)
	end
	task.wait(.25)
	Window.Username.Text = Vehicle.DriveSeat:GetAttribute("Username")
	Window.RigType.Text = Vehicle.DriveSeat:GetAttribute("RigType")
	if Vehicle.DriveSeat:GetAttribute("RigType") == "R6" then
		Window.RigType.TextColor3 = Color3.fromRGB(255, 0, 0)
	else
		Window.RigType.TextColor3 = Color3.fromRGB(0, 0, 255)
	end
	local UserID = Vehicle.DriveSeat:GetAttribute("UserID")
	-- Avatar from user
	local function getAvater()
		if UserID then
			local thumbUrL, IsReady = game:GetService("Players"):GetUserThumbnailAsync(UserID,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size48x48
			)
			return thumbUrL
		else
			return nil
		end
	end
	local avatar = getAvater()
	Window.Avatar.Image = avatar
	Window.Avatar.Visible = true
end
Init()

