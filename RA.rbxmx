						<Item class="LocalScript" referent="RBX478D776A6EE94AC7A462C21F07D86DDF">
							<Properties>
								<ProtectedString name="Source"><![CDATA[--[[ Welcome, tuner.
    ____  ___
   / __ \/   | Entity
  / /_/ / /| | Roblox self propelled land vehicle chassis
 / __ _/ ___ | 0.51.4
/_/ |_/_/  |_| GitHub:    https://github.com/totallyahuman445/Roblox-Entity-RA
               Discord:   https://discord.gg/bS2A448Vrk
               Community: https://www.roblox.com/share/g/206794047
			   THE List:  https://docs.google.com/document/d/1WvOWw7ST4ZWpsCfXM3abJTTBkCA40NsayIEIdCRJOYM/edit?usp=sharing
			   Log:		  https://docs.google.com/document/d/1SLW5NOAysg2rE6C52WEPnmOas_MNbeVNEv0xv2f__ps/edit?usp=sharing
			   Credits:   https://docs.google.com/document/d/1-mIgEhmugHfVUDz4vzZMS7XYMoEdLKedy0MedRqvbyA/edit?usp=sharing
]]
local speed = 200 -- The speed the timer stops timing in km/h.

local RunService = game:GetService("RunService")

local Vehicle = script.Parent.Parent.Parent.Vehicle.Value
local Velocity = script.Parent.Parent.Parent.Values.Velocity
local ReadyReset = script.Parent.ReadyReset
local Timer = script.Parent.Timer
local BotColor = script.Parent.Bot

script.Parent.Active = true
script.Parent.Draggable = true

local TReady = false
local Started = false
local StartTime = nil

script.Parent.TextLabel.Text = "0-" .. speed .. " km/h timer"

local function updateTimer()
	Timer.Text = math.floor((os.clock() - StartTime) * 1000) / 1000
	if (11 / 12) * 1.09728 * Velocity.Value.Magnitude >= speed then
		RunService:UnbindFromRenderStep("custom_km/h_timer")
		ReadyReset.Text = "RESET"
		BotColor.ImageColor3 = Color3.fromRGB(255, 0, 0)
	end
end

Velocity.Changed:Connect(function(value)
	if not Started and TReady and value.Magnitude * (11 / 12) * 1.09728 > 1 then
		Started = true
		StartTime = os.clock()
		RunService:BindToRenderStep("custom_km/h_timer", 100, updateTimer)
	end
end)

ReadyReset.MouseButton1Click:Connect(function()
	if TReady then
		RunService:UnbindFromRenderStep("custom_km/h_timer")
		ReadyReset.Text = "READY"
		BotColor.ImageColor3 = Color3.fromRGB(255, 0, 0)
		Started = false
		Timer.Text = "0.000"
		TReady = not TReady
	elseif not TReady and (11 / 12) * 1.09728 * Velocity.Value.Magnitude < 1 then
		ReadyReset.Text = "CANCEL"
		BotColor.ImageColor3 = Color3.fromRGB(100, 0, 0)
		TReady = not TReady
	elseif not TReady and (11 / 12) * 1.09728 * Velocity.Value.Magnitude >= 1 then
		ReadyReset.Text = "SLOW DOWN"
		BotColor.ImageColor3 = Color3.fromRGB(150, 50, 0)
		spawn(function()
			repeat task.wait() until (11 / 12) * 1.09728 * Velocity.Value.Magnitude < 1
			ReadyReset.Text = "READY"
			BotColor.ImageColor3 = Color3.fromRGB(255, 0, 0)
		end)
	end
end)

ReadyReset.MouseButton1Click:Connect(function()
	RunService:UnbindFromRenderStep("custom_km/h_timer")
	Started = false
	Timer.Text = "0.000"
end)

Vehicle.DriveSeat.ChildRemoved:Connect(function()
	RunService:UnbindFromRenderStep("custom_km/h_timer")
end)]]></ProtectedString>
