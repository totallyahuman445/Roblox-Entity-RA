						<Properties>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Inverse_Kinematics</string>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						</Properties>
						<Item class="Script" referent="RBXD5DA0B3130F244ADA0751CFD29C2FA42">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local vehicle = script.Parent.Parent
local Workspace = game:GetService("Workspace")

script.Parent.OnServerEvent:connect(function(Yes, Angle1, Angle2, Angle3, Angle4, Angle5, Angle6, Angle7, Angle8)
	local occupied = vehicle.DriveSeat:GetAttribute("Occupied")
	if occupied then
		local username = vehicle.DriveSeat:GetAttribute("Username")
		local rigtype = vehicle.DriveSeat:GetAttribute("RigType")
		local user = Workspace:WaitForChild(username)
		local userverify = user:WaitForChild("Humanoid")
		if rigtype == ("R6") and userverify and userverify:IsA("Humanoid") then
			user.Torso["Left Shoulder"].C0 = Angle1 * CFrame.Angles(0, 0, -30)
			user.Torso["Left Shoulder"].C1 = Angle2
			user.Torso["Right Shoulder"].C0 = Angle3 * CFrame.Angles(0, 0, 30)
			user.Torso["Right Shoulder"].C1 = Angle4
			user.Torso["Left Hip"].C0 = Angle5 * CFrame.Angles(0, 0, -30)
			user.Torso["Left Hip"].C1 = Angle6
			user.Torso["Right Hip"].C0 = Angle7 * CFrame.Angles(0, 0, 30)
			user.Torso["Right Hip"].C1 = Angle8
		else
			user.LeftUpperArm.LeftShoulder.C0 = Angle1 * CFrame.Angles(-.9, 0, 0)
			user.LeftUpperArm.LeftShoulder.C1 = Angle2
			user.RightUpperArm.RightShoulder.C0 = Angle3 * CFrame.Angles(-.75, 0, 0)
			user.RightUpperArm.RightShoulder.C1 = Angle4
			user.LeftUpperLeg.LeftHip.C0 = Angle5 * CFrame.Angles(-.75, 0, 0)
			user.LeftUpperLeg.LeftHip.C1 = Angle6
			user.RightUpperLeg.RightHip.C0 = Angle7 * CFrame.Angles(-.75, 0, 0)
			user.RightUpperLeg.RightHip.C1 = Angle8
		end
	end
end)]]></ProtectedString>
