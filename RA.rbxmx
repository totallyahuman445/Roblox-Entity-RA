						<ProtectedString name="Source"><![CDATA[local materialservice = game:GetService("MaterialService")
local materials = script.Parent:WaitForChild("MaterialVariants"):GetChildren()
local materialsinstance = script.Parent.MaterialVariants

-- check if materials are already loaded
for i, v in pairs(materials) do
	if materialservice:FindFirstChild(v) then
		table.remove(materials,i)
	else continue
	end
end

-- load materials
for i, v in pairs(materials) do
	v.Parent = materialservice
end]]></ProtectedString>
