						<Item class="LocalScript" referent="RBX8A519C8B106240CEA82F3F1404E76AF8">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local Graph = require(script.Graph)
local screen = script:FindFirstAncestorOfClass("ScreenGui")
local vehicle = screen.Vehicle.Value
local boolToNum = {[true] = 1, [false] = 0}
local _Settings = require(vehicle.Settings)
local values = screen.Values
local RunService = game:GetService("RunService")
local RPMBar = script.Parent.Bar
local CurrentStats = script.Parent.Current
local MaxStats = script.Parent.Max
local MaxPower = {0, 0}
local MaxTorque = {0, 0}

values:WaitForChild("DriveReady")

local Graphs = {
	Torque = {},
	Power = {},
	TorqueNA = {},
	PowerNA = {},
}
local function calculate()
	local x
	local _NT
	local _NH
	local _TBoost
	local _TT
	local _TH
	local _SBoost
	local _ST
	local _SH
	local _BH
	local _BT
	local _ET
	local _EH

	for i = _Settings.IdleRPM, _Settings.Redline do
		x = i / 1000
		if _Settings.Engine then
			_NT = 100 * (boolToNum[_Settings.Engine] * math.max((_Settings.Torque * .7375621493) / 100 - (_Settings.ValveFloatSharpness ^ (x - _Settings.ValveSprings) + _Settings.LowPerfSpread ^ (x - _Settings.LowPerf)) + (_Settings.HighPerf / 10 * x + math.max(-(1 - _Settings.VVLSharpness) ^ (x - _Settings.VVLTime) + _Settings.VVLValue, 0)), 0))
			_NH = (_NT * x / (_Settings.EqPoint / 1000))
			if _Settings.Turbochargers ~= 0 then
				_TBoost = math.max(1 ^ _Settings.T_SpoolFactor * math.min(math.max((math.max(_Settings.ExhaustPressure * (_NH / 100) - _Settings.T_SpoolTimeOffset, 0) ^ _Settings.T_ExPressFactor) + (_Settings.T_ExPressInf * (_Settings.ExhaustPressure * (_NH / 100))), 0), _Settings.Turbochargers * ((_Settings.T_Boost * 14.503773773) + math.max(_Settings.ExhaustPressure * (_NH / 100) - _Settings.T_WGMaxPress, 0))), _Settings.T_MinBoost / 100 * (_Settings.T_Boost * 14.503773773) * _Settings.Turbochargers)
				_TT = math.max(100 * _Settings.T_Efficiency * 1 ^ _Settings.T_SpoolFactor * _TBoost, 0)
				_TH = (_TT * x / (_Settings.EqPoint / 1000))
			else
				_TH,_TT = 0, 0
			end
			if _Settings.Superchargers ~= 0 then
				_SBoost = math.max(1 * _Settings.Superchargers * (_Settings.S_Boost * 14.503773773) / 10 * x - _Settings.S_HighPerf ^ x + _Settings.S_StartBoost, 0)
				_ST = 100 * (_Settings.S_Efficiency * _SBoost)
				_SH = (_ST * x / (_Settings.EqPoint / 1000))
			else
				_SH, _ST = 0, 0
			end
			_BH = _TH + _SH
			_BT = _TT + _ST
		else
			_NH,_NT = 0, 0
			_TH,_TT = 0, 0
			_SH,_ST = 0, 0
			_BH,_BT = 0, 0
		end
		if _Settings.Electric then
			_ET = math.max(100 * (boolToNum[_Settings.Electric] * ((_Settings.E_Torque * .7375621493) / 100 - math.max(_Settings.E_DropSlope * x - _Settings.E_DropSlope * (_Settings.E_TorqueDropRPM / 1000), 0) + _Settings.E_TorqueDropCurve * math.min(_Settings.E_TorqueDropSpread ^ (x - _Settings.E_TorqueDropRPM / 1000) - 1, 0))), 0)
			_EH = (_ET * x / (_Settings.EqPoint / 1000))
		else
			_EH,_ET = 0, 0
		end

		Graphs.TorqueNA[i] = _NT
		Graphs.PowerNA[i] = _NH
		Graphs.Torque[i] = math.min(_NT + _BT + _ET, _Settings.HorsepowerLimit > 0 and _Settings.HorsepowerLimit * (_Settings.EqPoint / 1000 / x) or math.huge)
		Graphs.Power[i] = Graphs.Torque[i] * x / (_Settings.EqPoint / 1000)

		if Graphs.Torque[i] > MaxTorque[1] then
			MaxTorque = {Graphs.Torque[i], i}
		end
		if Graphs.Power[i] > MaxPower[1] then
			MaxPower = {Graphs.Power[i], i}
		end
	end
end

calculate()

local GraphA = Graph.new(script.Parent.Graphs)
GraphA.Resolution = 40
GraphA.Data = Graphs
GraphA.Colors = {
	Torque = Color3.fromRGB(200, 60, 60),
	Power = Color3.fromRGB(60, 120, 200),
	TorqueNA = Color3.fromRGB(200, 60, 60),
	PowerNA = Color3.fromRGB(60, 120, 200),
}
GraphA.LineTypes = {
	Torque = 1,
	Power = 1,
	TorqueNA = .5,
	PowerNA = .5,
}
GraphA.BaselineZero = true
GraphA.Render()

-- Runtime Loop
RunService.RenderStepped:Connect(function()
	if not vehicle.DriveSeat:FindFirstChild("SeatWeld") then return
	end
	-- RPM Bar
	RPMBar.Position = UDim2.new(.09 + values.RPM.Value / _Settings.Redline * .75, 0, .07, 0)
	-- Stats
	CurrentStats.Power.Text = "Power (hp): "..string.format("%.2f", values.Horsepower.Value)
	CurrentStats.Torque.Text = "Torque (nm): "..string.format("%.2f", values.Torque.Value * 1.3558179483)
	MaxStats.Power.Text = "Power (hp @rpm): "..string.format("%.2f", MaxPower[1]).." @"..MaxPower[2]
	MaxStats.Torque.Text = "Torque (nm @rpm): "..string.format("%.2f", MaxTorque[1] * 1.3558179483).." @"..MaxTorque[2]
	if workspace.CurrentCamera.ViewportSize.X < 900 or workspace.CurrentCamera.ViewportSize.Y < 600 then -- move to simplified
		script.Parent.Visible = false
	else
		script.Parent.Visible = true
	end
end)]]></ProtectedString>
